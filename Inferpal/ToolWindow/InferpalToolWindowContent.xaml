<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:ext="http://schemas.microsoft.com/visualstudio/extensibility/2022/xaml"
              xmlns:vs="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0">

    <DataTemplate.Resources>
        <BooleanToVisibilityConverter x:Key="b2v" />
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Static vs:VsResourceKeys.ComboBoxStyleKey}}" />

        <!-- Flat buttons: their own Background, BorderBrush and Foreground, a grey wash on hover or keyboard focus
             (the same on a light or a dark ground). One template per corner radius. -->
        <ControlTemplate x:Key="Flat10" TargetType="Button">
            <Grid>
                <Border CornerRadius="10" Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                <Border x:Name="wash" CornerRadius="10" Background="#1F808080" Visibility="Collapsed"/>
                <ContentPresenter Margin="{TemplateBinding Padding}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="wash" Property="Visibility" Value="Visible"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="wash" Property="Visibility" Value="Visible"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <ControlTemplate x:Key="Flat8" TargetType="Button">
            <Grid>
                <Border CornerRadius="8" Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                <Border x:Name="wash" CornerRadius="8" Background="#1F808080" Visibility="Collapsed"/>
                <ContentPresenter Margin="{TemplateBinding Padding}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="wash" Property="Visibility" Value="Visible"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="wash" Property="Visibility" Value="Visible"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <ControlTemplate x:Key="Flat6" TargetType="Button">
            <Grid>
                <Border CornerRadius="6" Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                <Border x:Name="wash" CornerRadius="6" Background="#1F808080" Visibility="Collapsed"/>
                <ContentPresenter Margin="{TemplateBinding Padding}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="wash" Property="Visibility" Value="Visible"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="wash" Property="Visibility" Value="Visible"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <ControlTemplate x:Key="Flat5" TargetType="Button">
            <Grid>
                <Border CornerRadius="5" Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                <Border x:Name="wash" CornerRadius="5" Background="#14808080" Visibility="Collapsed"/>
                <ContentPresenter Margin="{TemplateBinding Padding}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="wash" Property="Visibility" Value="Visible"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="wash" Property="Visibility" Value="Visible"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <ControlTemplate x:Key="FlatRound" TargetType="Button">
            <Grid>
                <Ellipse Fill="{TemplateBinding Background}"/>
                <Ellipse x:Name="wash" Fill="#33FFFFFF" Visibility="Collapsed"/>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="wash" Property="Visibility" Value="Visible"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="wash" Property="Visibility" Value="Visible"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- An icon button of the header: a glyph, 32 px square. -->
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Template" Value="{StaticResource Flat8}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{Binding ThemeText}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <!-- A row of a header menu. -->
        <Style x:Key="MenuBtn" TargetType="Button">
            <Setter Property="Template" Value="{StaticResource Flat6}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{Binding ThemeText}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <!-- A secondary button: a thin line, the text colour. -->
        <Style x:Key="LineBtn" TargetType="Button">
            <Setter Property="Template" Value="{StaticResource Flat6}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <!-- A key, as the welcome screen and the approval card name them. -->
        <Style x:Key="Kbd" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="Opacity" Value="0.75"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- One row of the mode list: a check for the mode held, its name and what it is for, and — for a mode found
             here — the model it answers with, what it may do and its file. Its colours ride on the row. -->
        <DataTemplate x:Key="ModeMenuRow">
            <Button Command="{Binding SelectCommand}" HorizontalContentAlignment="Stretch" Padding="0"
                    FocusVisualStyle="{x:Null}" BorderThickness="0" Background="Transparent" Cursor="Hand"
                    AutomationProperties.Name="{Binding Name}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Padding="12,5" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontFamily="Segoe MDL2 Assets" Text="&#xE73E;" FontSize="11"
                                           Margin="0,2,0,0" VerticalAlignment="Top" Foreground="{Binding ThemeText}"
                                           Visibility="{Binding IsChecked, Converter={StaticResource b2v}}"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{Binding ThemeSubText}">
                                        <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" Foreground="{Binding ThemeText}"/><Run Text="{Binding DescriptionTail, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Summary}" FontSize="10" TextWrapping="Wrap" Margin="0,1,0,0"
                                               Foreground="{Binding ThemeSubText}"
                                               Visibility="{Binding HasSummary, Converter={StaticResource b2v}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{Binding ThemeHover}"/>
                            </Trigger>
                            <!-- The keyboard sees where it is, as the mouse does -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{Binding ThemeHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
    </DataTemplate.Resources>


    <!-- Tag: the in-process ChatDropTarget takes a file dropped here (ChatDropTarget.RootTag). -->
    <Grid x:Name="root" Tag="InferpalChatRoot" Background="{Binding ThemeWindowBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- 0: Header -->
            <RowDefinition Height="Auto" />  <!-- 1: Search bar / conversations -->
            <RowDefinition Height="*"    />  <!-- 2: Messages, welcome, X-Ray, menus -->
            <RowDefinition Height="Auto" />  <!-- 3: (empty) -->
            <RowDefinition Height="Auto" />  <!-- 4: Build failed banner -->
            <RowDefinition Height="Auto" />  <!-- 5: Composer -->
        </Grid.RowDefinitions>

        <!-- ── Header: the model button, new conversation, conversations, documentation, more ── -->
        <Border Grid.Row="0" BorderThickness="0,0,0,1" BorderBrush="{Binding ThemeBorder}" Padding="10,8">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Content="&#xE712;" Margin="2,0,0,0"
                        Command="{Binding ToggleMoreMenuCommand}"
                        ToolTip="{Binding LabelMore}" AutomationProperties.Name="{Binding LabelMore}"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Content="&#xE897;" Margin="2,0,0,0"
                        Command="{Binding OpenDocumentationCommand}"
                        ToolTip="{Binding LabelDocumentation}" AutomationProperties.Name="{Binding LabelDocumentation}"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Content="&#xE81C;" Margin="2,0,0,0"
                        Command="{Binding ToggleSessionPanelCommand}"
                        ToolTip="{Binding LabelConversations}" AutomationProperties.Name="{Binding LabelConversations}"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Content="&#xE710;" Margin="8,0,0,0"
                        Command="{Binding ClearCommand}"
                        ToolTip="{Binding LabelNewConversation}" AutomationProperties.Name="{Binding LabelNewConversation}"/>
                <!-- The model button: the dot says whether the server answers; it opens the model menu. -->
                <Button Template="{StaticResource Flat8}" Height="32" Padding="10,0" Cursor="Hand"
                        Background="{Binding ThemeSurface}" BorderBrush="{Binding ThemeBorder}" BorderThickness="1"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                        Command="{Binding ToggleModelMenuCommand}"
                        ToolTip="{Binding ModelButtonTip}" AutomationProperties.Name="{Binding ModelButtonTip}">
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Right" FontFamily="Segoe MDL2 Assets" Text="&#xE70D;" FontSize="10"
                                   Foreground="{Binding ThemeText}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Fill="{Binding ModelDotColor}"
                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock DockPanel.Dock="Left" Text="{Binding ModelName}" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{Binding ThemeText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   MaxWidth="220"/>
                        <TextBlock Text="{Binding ModelMeta}" FontSize="13" Foreground="{Binding ThemeSubtleText}"
                                   Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </Button>
            </DockPanel>
        </Border>

        <!-- ── Search bar (collapsible) ── -->
        <Border Grid.Row="1" Padding="8,5"
                BorderThickness="0,0,0,1" BorderBrush="{Binding ThemeBorder}"
                Visibility="{Binding IsSearchOpen, Converter={StaticResource b2v}}">
            <DockPanel>
                <Button FontFamily="Segoe MDL2 Assets" DockPanel.Dock="Right" Padding="6,2" Margin="4,0,0,0"
                        Content="&#xE711;" Foreground="{Binding ThemeSubtleText}"
                        ToolTip="{Binding TooltipCloseSearch}" AutomationProperties.Name="{Binding TooltipCloseSearch}"
                        Command="{Binding ClearSearchCommand}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" CornerRadius="4" Background="Transparent"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{Binding DataContext.ThemeHoverBg, ElementName=root}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <TextBox Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         BorderThickness="1" BorderBrush="{Binding ThemeInputBorder}"
                         Background="Transparent" Foreground="{Binding ThemeText}"
                         Padding="8,4" FontSize="12"
                         VerticalContentAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- ── Session Panel (collapsible) ── -->
        <Border Grid.Row="1" Padding="8,6"
                BorderThickness="0,0,0,1" BorderBrush="{Binding ThemeBorder}"
                Background="{Binding ThemeSessionBg}"
                Visibility="{Binding IsSessionPanelOpen, Converter={StaticResource b2v}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"    />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox Grid.Column="0"
                          ItemsSource="{Binding RecentSessions}"
                          SelectedItem="{Binding SelectedSession, Mode=TwoWay}"
                          ToolTip="{Binding TooltipSessionPicker}"
                          VerticalAlignment="Center" />
                <Button FontFamily="Segoe MDL2 Assets" Grid.Column="1" Content="&#xE8E5;"
                        Command="{Binding LoadSessionCommand}"
                        ToolTip="{Binding TooltipLoadSession}" AutomationProperties.Name="{Binding TooltipLoadSession}"
                        Foreground="{Binding ThemeText}"
                        Margin="6,0,0,0" Padding="8,4" FontSize="11">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" CornerRadius="4" Background="{Binding ThemePanelBg}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{Binding DataContext.ThemeHoverBg, ElementName=root}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button FontFamily="Segoe MDL2 Assets" Grid.Column="2" Content="&#xE74D;"
                        Command="{Binding DeleteSessionCommand}"
                        ToolTip="{Binding TooltipDeleteSession}" AutomationProperties.Name="{Binding TooltipDeleteSession}"
                        Foreground="#CC4444"
                        Margin="4,0,0,0" Padding="8,4" FontSize="11">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" CornerRadius="4" Background="{Binding ThemePanelBg}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{Binding DataContext.ThemeHoverBg, ElementName=root}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- ── Messages ── -->
        <!-- Tag identifies this list for the in-process ChatAutoScroller class handlers -->
        <ListBox Grid.Row="2"
                 Tag="InferpalChatList"
                 ItemsSource="{Binding Messages}"
                 SelectedItem="{Binding ScrollTarget, Mode=TwoWay}"
                 VirtualizingPanel.IsVirtualizing="False"
                 ScrollViewer.CanContentScroll="False"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.Style>
                <Style TargetType="ListBox">
                    <Setter Property="Padding" Value="16,12,16,0"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCompact}" Value="True">
                            <Setter Property="Padding" Value="10,8,10,0"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListBox.Style>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding"          Value="0"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!-- One item of a turn, drawn by its role: a question (user), the turn's header line (turn), its run
                         line (run) and steps (tool), its plan (plan), the live status (status), an answer or a notice
                         (assistant), the result bar (result), an approval card (approval); the scroll anchors draw nothing. -->
                    <Grid x:Name="itemRoot" Background="Transparent">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Margin" Value="0,0,0,10"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Role}" Value="anchor">
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="Height" Value="0"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Role}" Value="user">
                                        <Setter Property="Margin" Value="48,10,0,14"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Role}" Value="turn">
                                        <Setter Property="Margin" Value="0,0,0,8"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Role}" Value="tool">
                                        <Setter Property="Margin" Value="10,0,0,4"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Role}" Value="status">
                                        <Setter Property="Margin" Value="0,0,0,6"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Role}" Value="result">
                                        <Setter Property="Margin" Value="0,0,0,18"/>
                                    </DataTrigger>
                                    <!-- Compact: less space around the turns, the same order of spaces -->
                                    <DataTrigger Binding="{Binding DataContext.IsCompact, ElementName=root}" Value="True">
                                        <Setter Property="Margin" Value="0,0,0,6"/>
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding DataContext.IsCompact, ElementName=root}" Value="True"/>
                                            <Condition Binding="{Binding Role}" Value="user"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Margin" Value="48,4,0,8"/>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding DataContext.IsCompact, ElementName=root}" Value="True"/>
                                            <Condition Binding="{Binding Role}" Value="tool"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Margin" Value="10,0,0,2"/>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding DataContext.IsCompact, ElementName=root}" Value="True"/>
                                            <Condition Binding="{Binding Role}" Value="result"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Margin" Value="0,0,0,10"/>
                                    </MultiDataTrigger>
                                    <!-- The anchors draw nothing, compact or not -->
                                    <DataTrigger Binding="{Binding Role}" Value="anchor">
                                        <Setter Property="Margin" Value="0"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsFolded}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <!-- Search: what does not match fades out -->
                                    <DataTrigger Binding="{Binding IsSearchDimmed}" Value="True">
                                        <Setter Property="Opacity" Value="0.2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <!-- ── A question: on the right, in its bubble; what went with it as chips under it ── -->
                        <StackPanel HorizontalAlignment="Right">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Role}" Value="user">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <!-- A note typed during the run: whether the model read it yet, above its bubble -->
                            <TextBlock Text="{Binding NoteState}" FontSize="11" HorizontalAlignment="Right" Margin="0,0,0,3"
                                       Foreground="{Binding ThemeSubtleText}"
                                       Visibility="{Binding IsNote, Converter={StaticResource b2v}}"/>
                            <Grid HorizontalAlignment="Right">
                                <Border CornerRadius="12,12,4,12" Background="{Binding BubbleBackground}" Padding="12,8"
                                        BorderBrush="{Binding BubbleBorder}" BorderThickness="1">
                                    <TextBlock Text="{Binding UserText}" TextWrapping="Wrap" Foreground="{Binding ThemeText}" FontSize="13"/>
                                </Border>
                                <!-- Copy: beside the bubble, on hover -->
                                <Button HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-30,0,0,0"
                                        Template="{StaticResource Flat6}" Background="Transparent" BorderThickness="0"
                                        Width="24" Height="24" Cursor="Hand"
                                        Command="{Binding CopyCommand}"
                                        ToolTip="{Binding DataContext.TooltipCopy, ElementName=root}"
                                        AutomationProperties.Name="{Binding DataContext.TooltipCopy, ElementName=root}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Opacity" Value="0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=itemRoot}" Value="True">
                                                    <Setter Property="Opacity" Value="1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8C8;" FontSize="11"
                                               Foreground="{Binding ThemeSubtleText}"/>
                                </Button>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Chips}" HorizontalAlignment="Right" Margin="0,6,0,0"
                                          Visibility="{Binding HasChips, Converter={StaticResource b2v}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" BorderThickness="1" Padding="8,1" Margin="6,0,0,0"
                                                BorderBrush="{Binding DataContext.ThemeBorder, ElementName=root}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;" FontSize="10" VerticalAlignment="Center"
                                                           Foreground="{Binding DataContext.ThemeSubtleText, ElementName=root}"/>
                                                <TextBlock Text="{Binding}" FontSize="11" Margin="4,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{Binding DataContext.ThemeSubtleText, ElementName=root}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- Go back here: under a question the model was asked, on hover (and to the keyboard) -->
                            <Button HorizontalAlignment="Right" Margin="0,6,0,0" Template="{StaticResource Flat6}"
                                    Background="Transparent" BorderThickness="1" Padding="8,2" Cursor="Hand"
                                    BorderBrush="{Binding DataContext.ThemeBorder, ElementName=root}"
                                    Command="{Binding RewindHereCommand}"
                                    ToolTip="{Binding DataContext.RewindHereTip, ElementName=root}"
                                    AutomationProperties.Name="{Binding DataContext.RewindHereTip, ElementName=root}"
                                    Visibility="{Binding CanRewind, Converter={StaticResource b2v}}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Opacity" Value="0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=itemRoot}" Value="True">
                                                <Setter Property="Opacity" Value="1"/>
                                            </DataTrigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter Property="Opacity" Value="1"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7A7;" FontSize="11" VerticalAlignment="Center"
                                               Foreground="{Binding ThemeSubtleText}"/>
                                    <TextBlock Text="{Binding DataContext.RewindHereLabel, ElementName=root}" FontSize="12" Margin="6,0,0,0"
                                               VerticalAlignment="Center" Foreground="{Binding ThemeSubtleText}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- ── Where a mode found here starts holding the conversation: its line on a rule. The words sit on
                             the window's ground over one rule, so a long line wraps (an Auto column never would) ── -->
                        <Grid Margin="0,2,0,2">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Role}" Value="mode">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Border Height="1" VerticalAlignment="Center"
                                    Background="{Binding DataContext.ThemeBorder, ElementName=root}"/>
                            <TextBlock Text="{Binding Content}" FontSize="11" Margin="16,0" Padding="10,0" TextWrapping="Wrap"
                                       HorizontalAlignment="Center" TextAlignment="Center" Foreground="{Binding ThemeSubtleText}"
                                       Background="{Binding DataContext.ThemeWindowBg, ElementName=root}"/>
                        </Grid>

                        <!-- ── The turn's header line: the model, then what it is doing, then how long it took ── -->
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Role}" Value="turn">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding ThemeText}"/>
                            <TextBlock Text="{Binding TurnState}" FontSize="11" Foreground="{Binding ThemeSubtleText}" Margin="8,0,0,0"/>
                        </StackPanel>

                        <!-- ── The run line: "3 steps · read 1 file · edited 1 · build passed"; it opens the steps ── -->
                        <Button Template="{StaticResource Flat8}" Padding="10,7" Cursor="Hand"
                                Background="{Binding DataContext.ThemeSurface, ElementName=root}"
                                BorderBrush="{Binding DataContext.ThemeBorder, ElementName=root}" BorderThickness="1"
                                HorizontalContentAlignment="Stretch"
                                Command="{Binding ToggleExpandCommand}"
                                AutomationProperties.Name="{Binding Label}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Role}" Value="run">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Right" FontFamily="Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center"
                                           Margin="8,0,0,0" Foreground="{Binding ThemeSubtleText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#xE76C;"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                    <Setter Property="Text" Value="&#xE70D;"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock DockPanel.Dock="Left" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center"
                                           Text="{Binding RunGlyph}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{Binding ThemeSubtleText}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RunGlyph}" Value="&#xE73E;">
                                                    <Setter Property="Foreground" Value="{Binding DataContext.ThemeOk, ElementName=root}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding RunFailed}" Value="True">
                                                    <Setter Property="Foreground" Value="{Binding DataContext.ThemeErrorText, ElementName=root}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Label}" FontSize="13" Foreground="{Binding ThemeText}"
                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding RunDetail}" FontSize="13" Foreground="{Binding ThemeSubtleText}"
                                           Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </Button>

                        <!-- ── A step: ✓ or ✗, the tool, what it acted on; its arguments and output fold under it ── -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Role}" Value="tool">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Button Template="{StaticResource Flat6}" Background="Transparent" BorderThickness="0" Padding="4,3"
                                    HorizontalContentAlignment="Stretch" Cursor="Hand"
                                    Command="{Binding ToggleExpandCommand}"
                                    AutomationProperties.Name="{Binding ToolName}">
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Left" FontFamily="Segoe MDL2 Assets" FontSize="12" Width="18"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="&#xE73E;"/>
                                                <Setter Property="Foreground" Value="{Binding DataContext.ThemeOk, ElementName=root}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasErrors}" Value="True">
                                                        <Setter Property="Text" Value="&#xE711;"/>
                                                        <Setter Property="Foreground" Value="{Binding DataContext.ThemeErrorText, ElementName=root}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding ToolName}" FontFamily="Cascadia Mono, Consolas"
                                               FontSize="12" Foreground="{Binding ThemeText}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding StepSubject}" FontSize="12" Foreground="{Binding ThemeSubtleText}"
                                               Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </Button>
                            <!-- The step opened: its diff, its arguments and output -->
                            <Border Margin="22,4,0,2" CornerRadius="6" Padding="8,6" BorderThickness="1"
                                    Background="{Binding ThemeCodeBg}" BorderBrush="{Binding ThemeCodeBorder}"
                                    Visibility="{Binding IsExpanded, Converter={StaticResource b2v}}">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding DiffLines}" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                                  Margin="0,0,0,4" Visibility="{Binding HasDiff, Converter={StaticResource b2v}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Background="{Binding Background}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="14"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Prefix}" Foreground="{Binding Foreground}" Padding="2,0"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Text}" Foreground="{Binding Foreground}"
                                                               TextWrapping="NoWrap" Padding="2,0"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding Content}" TextWrapping="Wrap"
                                               FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="{Binding ThemeToolText}"/>
                                </StackPanel>
                            </Border>
                            <!-- Fix with AI: on a step whose output carries errors -->
                            <Button Style="{StaticResource LineBtn}" Margin="22,4,0,0" HorizontalAlignment="Left"
                                    BorderBrush="{Binding DataContext.ThemeBorder, ElementName=root}" Foreground="{Binding ThemeText}"
                                    Content="{Binding BtnFixWithAi}" Command="{Binding FixWithAiCommand}"
                                    Visibility="{Binding IsFixable, Converter={StaticResource b2v}}"/>
                        </StackPanel>

                        <!-- ── The live status: what the agent is doing now ── -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Role}" Value="status">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                        <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="12" FontStyle="Italic"
                                   Foreground="{Binding ThemeSubtleText}"/>

                        <!-- ── Under it, a request waiting on a server that reads its prompt: what, how long, when it stops ── -->
                        <Border CornerRadius="8" BorderThickness="1" Padding="12,10" Margin="0,8,0,0"
                                Background="{Binding DataContext.ThemeSurface, ElementName=root}"
                                Visibility="{Binding HasWait, Converter={StaticResource b2v}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{Binding DataContext.ThemeBorder, ElementName=root}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsWaitLonger}" Value="True">
                                            <Setter Property="BorderBrush" Value="{Binding DataContext.ThemeWarn, ElementName=root}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding WaitTimes}" FontSize="12" Margin="8,0,0,0"
                                               VerticalAlignment="Center" Foreground="{Binding ThemeSubtleText}"/>
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE823;" FontSize="13" Margin="0,0,8,0"
                                               VerticalAlignment="Center" AutomationProperties.Name="">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{Binding DataContext.ThemeAccentText, ElementName=root}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsWaitLonger}" Value="True">
                                                        <Setter Property="Foreground" Value="{Binding DataContext.ThemeWarn, ElementName=root}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding WaitTitle}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                                               VerticalAlignment="Center" Foreground="{Binding ThemeText}"/>
                                </DockPanel>
                                <!-- A bar only when a read was measured: a band scaled to the fraction, over its track -->
                                <Grid Height="4" Margin="0,8,0,0" Visibility="{Binding HasWaitBar, Converter={StaticResource b2v}}">
                                    <Border CornerRadius="2" Background="{Binding DataContext.ThemeBorder, ElementName=root}"/>
                                    <Border CornerRadius="2" RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding WaitFraction}"/>
                                        </Border.RenderTransform>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{Binding DataContext.ThemeAccent, ElementName=root}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsWaitLonger}" Value="True">
                                                        <Setter Property="Background" Value="{Binding DataContext.ThemeWarn, ElementName=root}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding WaitDetail}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Foreground="{Binding ThemeSubtleText}"/>
                            </StackPanel>
                        </Border>
                        </StackPanel>

                        <!-- ── The agent's plan: its goal and steps, as it updates them ── -->
                        <Border CornerRadius="8" BorderThickness="1" Padding="10,8"
                                Background="{Binding DataContext.ThemeSurface, ElementName=root}"
                                BorderBrush="{Binding DataContext.ThemeBorder, ElementName=root}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Role}" Value="plan">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding ThemeSubtleText}"
                                           Margin="0,0,0,4"/>
                                <!-- The goal, then one row per step: the glyph and its colour say the state (Content holds
                                     the plan's Markdown, for the session and the export: never shown as text) -->
                                <DockPanel Margin="0,0,0,4" Visibility="{Binding HasPlanGoal, Converter={StaticResource b2v}}">
                                    <TextBlock DockPanel.Dock="Left" FontFamily="Segoe MDL2 Assets" Text="&#xECCB;" FontSize="12" Width="14"
                                               Margin="0,2,8,0" VerticalAlignment="Top"
                                               Foreground="{Binding DataContext.ThemeAccent, ElementName=root}"/>
                                    <TextBlock Text="{Binding PlanGoal}" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{Binding ThemeText}"/>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding PlanSteps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,2,0,0">
                                                <DockPanel.Style>
                                                    <Style TargetType="DockPanel">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding State}" Value="Done">
                                                                <Setter Property="Opacity" Value="0.6"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </DockPanel.Style>
                                                <TextBlock DockPanel.Dock="Left" FontFamily="Segoe MDL2 Assets" Text="{Binding Glyph}" FontSize="11" Width="14"
                                                           Margin="0,3,8,0" VerticalAlignment="Top">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{Binding DataContext.ThemeSubtleText, ElementName=root}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding State}" Value="Done">
                                                                    <Setter Property="Foreground" Value="{Binding DataContext.ThemeOk, ElementName=root}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding State}" Value="Active">
                                                                    <Setter Property="Foreground" Value="{Binding DataContext.ThemeAccent, ElementName=root}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding State}" Value="Failed">
                                                                    <Setter Property="Foreground" Value="{Binding DataContext.ThemeErrorText, ElementName=root}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{Binding DataContext.ThemeText, ElementName=root}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding State}" Value="Active">
                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding State}" Value="Failed">
                                                                    <Setter Property="Foreground" Value="{Binding DataContext.ThemeErrorText, ElementName=root}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- ── An answer, or a notice: full width, on the ground ── -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Role}" Value="assistant">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <!-- The answer while it streams (no markdown yet) -->
                            <TextBlock Text="{Binding Content}" TextWrapping="Wrap" FontSize="13" Foreground="{Binding ThemeText}"
                                       LineHeight="19">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasBlocks}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- Rendered markdown blocks (assistant messages after streaming) -->
                            <ItemsControl ItemsSource="{Binding Blocks}">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasBlocks}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <!-- Headings and plain text (no inline formatting) -->
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{Binding ThemeText}"/>
                                                        <Setter Property="Margin"     Value="0,1"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Type}" Value="heading1">
                                                                <Setter Property="FontSize"   Value="18"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                <Setter Property="Margin"     Value="0,6,0,2"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Type}" Value="heading2">
                                                                <Setter Property="FontSize"   Value="15"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                <Setter Property="Margin"     Value="0,5,0,2"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Type}" Value="heading3">
                                                                <Setter Property="FontSize"   Value="13"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                                <Setter Property="Margin"     Value="0,4,0,2"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Type}" Value="code_block">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Type}" Value="separator">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <!-- Hidden when inline runs are available -->
                                                            <DataTrigger Binding="{Binding HasInlines}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- Inline-formatted pieces: paragraph, bullet_item, numbered_item. One piece per
                                                 word (InlineFlow): the WrapPanel only ends a line between two children. A list
                                                 marker has its own column, so the item's wrapped lines align under its text. -->
                                            <Grid>
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Setter Property="Margin"     Value="0,1"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasInlines}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Type}" Value="bullet_item">
                                                                <Setter Property="Margin" Value="10,1,0,1"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Type}" Value="numbered_item">
                                                                <Setter Property="Margin" Value="10,1,0,1"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Marker}" Foreground="{Binding ThemeText}" VerticalAlignment="Top">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Margin" Value="0,0,5,0"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Marker}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <ItemsControl Grid.Column="1" ItemsSource="{Binding Inlines}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Text}"
                                                                       Foreground="{Binding Foreground}"
                                                                       TextWrapping="Wrap">
                                                                <!-- A word of a link opens it; a word of text has no command, the click does nothing -->
                                                                <TextBlock.InputBindings>
                                                                    <MouseBinding MouseAction="LeftClick" Command="{Binding OpenCommand}"/>
                                                                </TextBlock.InputBindings>
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Margin" Value="0"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsLink}" Value="True">
                                                                                <Setter Property="TextDecorations" Value="Underline"/>
                                                                                <Setter Property="Cursor"          Value="Hand"/>
                                                                                <Setter Property="ToolTip"         Value="{Binding Url}"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsBold}" Value="True">
                                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsItalic}" Value="True">
                                                                                <Setter Property="FontStyle" Value="Italic"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsCode}" Value="True">
                                                                                <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
                                                                                <Setter Property="FontSize"   Value="12"/>
                                                                                <Setter Property="Background" Value="{Binding DataContext.ThemeCodeBg, ElementName=root}"/>
                                                                                <Setter Property="Padding"    Value="3,0"/>
                                                                            </DataTrigger>
                                                                            <!-- A code span cut into words: padding only on its outer edges -->
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding IsCode}"     Value="True"/>
                                                                                    <Condition Binding="{Binding StartsSpan}" Value="False"/>
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Padding" Value="0,0,3,0"/>
                                                                            </MultiDataTrigger>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding IsCode}"   Value="True"/>
                                                                                    <Condition Binding="{Binding EndsSpan}" Value="False"/>
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Padding" Value="3,0,0,0"/>
                                                                            </MultiDataTrigger>
                                                                            <MultiDataTrigger>
                                                                                <MultiDataTrigger.Conditions>
                                                                                    <Condition Binding="{Binding IsCode}"     Value="True"/>
                                                                                    <Condition Binding="{Binding StartsSpan}" Value="False"/>
                                                                                    <Condition Binding="{Binding EndsSpan}"   Value="False"/>
                                                                                </MultiDataTrigger.Conditions>
                                                                                <Setter Property="Padding" Value="0"/>
                                                                            </MultiDataTrigger>
                                                                            <!-- A hard line break: as wide as the panel, so what follows starts a line -->
                                                                            <DataTrigger Binding="{Binding IsBreak}" Value="True">
                                                                                <Setter Property="Height" Value="0"/>
                                                                                <Setter Property="Width"  Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=WrapPanel}}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>

                                            <!-- Code block: selectable, monospace, dark bg -->
                                            <Border Margin="0,4,0,2" CornerRadius="4">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Type}" Value="code_block">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <TextBox Text="{Binding Text, Mode=OneWay}"
                                                             IsReadOnly="True"
                                                             FontFamily="Consolas, Courier New"
                                                             FontSize="12"
                                                             Foreground="{Binding ThemeCodeText}"
                                                             Background="{Binding ThemeCodeBg}"
                                                             BorderThickness="1" BorderBrush="{Binding ThemeCodeBorder}"
                                                             Padding="10,28,10,8"
                                                             TextWrapping="Wrap"
                                                             VerticalScrollBarVisibility="Disabled"/>
                                                    <!-- Code block action buttons — overlaid top-right -->
                                                    <StackPanel Orientation="Horizontal"
                                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                                Margin="0,4,6,0">
                                                        <!-- Save snippet ⭐ -->
                                                        <Button Command="{Binding SaveSnippetCommand}"
                                                                Content="{Binding SaveSnippetGlyph}" FontFamily="Segoe MDL2 Assets"
                                                                Margin="0,0,4,0" Padding="5,2" FontSize="11"
                                                                Foreground="{Binding DataContext.ThemeSubtleText, ElementName=root}" Cursor="Hand"
                                                                ToolTip="{Binding SaveSnippetTip}" AutomationProperties.Name="{Binding SaveSnippetTip}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="bd" CornerRadius="3"
                                                                            Background="{Binding DataContext.ThemeWindowBg, ElementName=root}"
                                                                            BorderThickness="1" BorderBrush="{Binding DataContext.ThemeBorder, ElementName=root}"
                                                                            Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="bd" Property="Background" Value="{Binding DataContext.ThemeHoverBg, ElementName=root}"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                        <!-- Copy -->
                                                        <Button Command="{Binding CopyCodeCommand}"
                                                                Content="{Binding DataContext.LabelCopyCode, ElementName=root}"
                                                                Padding="6,2" FontSize="10"
                                                                Foreground="{Binding DataContext.ThemeSubtleText, ElementName=root}" Cursor="Hand">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="bd" CornerRadius="3"
                                                                            Background="{Binding DataContext.ThemeWindowBg, ElementName=root}"
                                                                            BorderThickness="1" BorderBrush="{Binding DataContext.ThemeBorder, ElementName=root}"
                                                                            Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="bd" Property="Background" Value="{Binding DataContext.ThemeHoverBg, ElementName=root}"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Horizontal rule -->
                                            <Border Height="1" Background="{Binding ThemeCodeBorder}" Margin="0,6">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Type}" Value="separator">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                            <!-- Table row (header and data) -->
                                            <Border BorderThickness="0,0,0,1" BorderBrush="{Binding ThemeTableBorder}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Setter Property="Margin"     Value="0"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Type}" Value="table_header_row">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Setter Property="Margin"     Value="0,4,0,0"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Type}" Value="table_data_row">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <ItemsControl ItemsSource="{Binding Cells}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Rows="1"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{Binding ThemeBg}" Padding="8,5">
                                                                <TextBlock Text="{Binding Text}"
                                                                           Foreground="{Binding ThemeText}"
                                                                           TextWrapping="Wrap">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Resume: on the step-mode pause notice -->
                            <Button Template="{StaticResource Flat6}" Margin="0,6,0,0" HorizontalAlignment="Left" Padding="12,0" Height="28"
                                    Background="{Binding DataContext.ThemeAccent, ElementName=root}" BorderThickness="0"
                                    Foreground="{Binding DataContext.ThemeOnAccent, ElementName=root}" Cursor="Hand"
                                    Content="{Binding BtnResume}" Command="{Binding ResumeCommand}"
                                    Visibility="{Binding IsResumable, Converter={StaticResource b2v}}"/>

                            <!-- Continue: on the end notice of a turn stopped at the iteration or the length limit -->
                            <Button Template="{StaticResource Flat6}" Margin="0,6,0,0" HorizontalAlignment="Left" Padding="12,0" Height="28"
                                    Background="{Binding DataContext.ThemeAccent, ElementName=root}" BorderThickness="0"
                                    Foreground="{Binding DataContext.ThemeOnAccent, ElementName=root}" Cursor="Hand"
                                    Content="{Binding BtnContinue}" Command="{Binding ContinueCommand}"
                                    AutomationProperties.Name="{Binding BtnContinue}"
                                    Visibility="{Binding IsContinuable, Converter={StaticResource b2v}}"/>

                            <!-- A turn cut at its bound, the server silent: what it wrote, and the way to the time limits -->
                            <StackPanel Margin="0,6,0,0" Visibility="{Binding HasCut, Converter={StaticResource b2v}}">
                                <TextBlock Text="{Binding CutNote}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"
                                           Foreground="{Binding ThemeSubtleText}"
                                           Visibility="{Binding HasCutNote, Converter={StaticResource b2v}}"/>
                                <Button Style="{StaticResource LineBtn}" HorizontalAlignment="Left"
                                        BorderBrush="{Binding DataContext.ThemeBorder, ElementName=root}"
                                        Command="{Binding CutOpenLimitsCommand}" AutomationProperties.Name="{Binding BtnCutOpenLimits}">
                                    <TextBlock Text="{Binding BtnCutOpenLimits}" FontSize="13" Foreground="{Binding ThemeText}"/>
                                </Button>
                            </StackPanel>

                            <!-- Time, copy and, on the last answer, regenerate: a quiet line under the answer -->
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Opacity" Value="0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMouseOver, ElementName=itemRoot}" Value="True">
                                                <Setter Property="Opacity" Value="1"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsRegeneratable}" Value="True">
                                                <Setter Property="Opacity" Value="1"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsStreaming}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{Binding Timestamp}" FontSize="10" Foreground="{Binding ThemeSubtleText}"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Button Template="{StaticResource Flat6}" Background="Transparent" BorderThickness="0"
                                        Width="24" Height="22" Cursor="Hand"
                                        Command="{Binding CopyCommand}"
                                        ToolTip="{Binding DataContext.TooltipCopy, ElementName=root}"
                                        AutomationProperties.Name="{Binding DataContext.TooltipCopy, ElementName=root}">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8C8;" FontSize="11" Foreground="{Binding ThemeSubtleText}"/>
                                </Button>
                                <Button Template="{StaticResource Flat6}" Background="Transparent" BorderThickness="0"
                                        Height="22" Padding="6,0" Cursor="Hand"
                                        Command="{Binding RegenerateCommand}"
                                        AutomationProperties.Name="{Binding BtnRegenerate}"
                                        Visibility="{Binding IsRegeneratable, Converter={StaticResource b2v}}">
                                    <TextBlock Text="{Binding BtnRegenerate}" FontSize="11" Foreground="{Binding ThemeSubtleText}"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <!-- ── The result bar: the files the run changed, its last check, Undo run ── -->
                        <Border CornerRadius="8" BorderThickness="1" Padding="10,6"
                                Background="{Binding DataContext.ThemeSurface, ElementName=root}"
                                BorderBrush="{Binding DataContext.ThemeBorder, ElementName=root}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Role}" Value="result">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                    <ItemsControl ItemsSource="{Binding ResultFiles}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Template="{StaticResource Flat6}" Background="Transparent" BorderThickness="0"
                                                        Padding="4,3" Margin="0,0,8,0" Cursor="Hand"
                                                        Command="{Binding OpenCommand}" ToolTip="{Binding Path}"
                                                        AutomationProperties.Name="{Binding Name}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;" FontSize="12" VerticalAlignment="Center"
                                                                   Foreground="{Binding DataContext.ThemeText, ElementName=root}"/>
                                                        <TextBlock Text="{Binding Name}" FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                   Foreground="{Binding DataContext.ThemeText, ElementName=root}"/>
                                                        <TextBlock Text="{Binding Added}" FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                   Foreground="{Binding DataContext.ThemeOk, ElementName=root}"/>
                                                        <TextBlock Text="{Binding Removed}" FontSize="13" Margin="4,0,0,0" VerticalAlignment="Center"
                                                                   Foreground="{Binding DataContext.ThemeSubtleText, ElementName=root}"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Margin="0,3"
                                                Visibility="{Binding HasCheck, Converter={StaticResource b2v}}">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="&#xE73E;"/>
                                                    <Setter Property="Foreground" Value="{Binding DataContext.ThemeOk, ElementName=root}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CheckFailed}" Value="True">
                                                            <Setter Property="Text" Value="&#xE711;"/>
                                                            <Setter Property="Foreground" Value="{Binding DataContext.ThemeErrorText, ElementName=root}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding CheckText}" FontSize="13" Margin="5,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{Binding ThemeSubtleText}"/>
                                    </StackPanel>
                                </WrapPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource LineBtn}" Margin="8,0,0,0" VerticalAlignment="Center"
                                            BorderBrush="{Binding DataContext.ThemeBorder, ElementName=root}"
                                            Command="{Binding ReviewCommand}" AutomationProperties.Name="{Binding BtnReview}"
                                            Visibility="{Binding CanReview, Converter={StaticResource b2v}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8FD;" FontSize="12" VerticalAlignment="Center"
                                                       Foreground="{Binding ThemeText}"/>
                                            <TextBlock Text="{Binding BtnReview}" FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center"
                                                       Foreground="{Binding ThemeText}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource LineBtn}" Margin="8,0,0,0" VerticalAlignment="Center"
                                            BorderBrush="{Binding DataContext.ThemeBorder, ElementName=root}"
                                            Command="{Binding UndoCommand}" AutomationProperties.Name="{Binding BtnUndo}"
                                            Visibility="{Binding CanUndo, Converter={StaticResource b2v}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7A7;" FontSize="12" VerticalAlignment="Center"
                                                       Foreground="{Binding ThemeText}"/>
                                            <TextBlock Text="{Binding BtnUndo}" FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center"
                                                       Foreground="{Binding ThemeText}"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- ── A run's review card: each file against the state before the run; Keep, Undo, Redo ── -->
                        <Border CornerRadius="10" BorderThickness="1" Margin="0,8,0,0"
                                Background="{Binding DataContext.ThemeSurface, ElementName=root}"
                                BorderBrush="{Binding DataContext.ThemeBorder, ElementName=root}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Role}" Value="review">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <DockPanel Margin="12,10" LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Template="{StaticResource Flat6}" Background="Transparent" BorderThickness="0"
                                            Padding="4,1" Margin="8,0,0,0" Cursor="Hand" VerticalAlignment="Center"
                                            Command="{Binding CloseReviewCommand}" AutomationProperties.Name="{Binding BtnCloseReview}" ToolTip="{Binding BtnCloseReview}">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;" FontSize="11" Foreground="{Binding ThemeSubtleText}"/>
                                    </Button>
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding CardTitle}" FontSize="13" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Foreground="{Binding ThemeText}"/>
                                    <TextBlock Text="{Binding CardSubject}" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"
                                               TextWrapping="Wrap" Foreground="{Binding ThemeSubtleText}"/>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding ReviewFiles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderThickness="0,1,0,0" BorderBrush="{Binding DataContext.ThemeBorder, ElementName=root}">
                                                <StackPanel>
                                                    <DockPanel Margin="12,7" LastChildFill="True">
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                                                    IsEnabled="{Binding CanAct}">
                                                            <Button Style="{StaticResource LineBtn}" Margin="6,0,0,0"
                                                                    BorderBrush="{Binding DataContext.ThemeBorder, ElementName=root}"
                                                                    Command="{Binding KeepCommand}" AutomationProperties.Name="{Binding BtnKeep}"
                                                                    Visibility="{Binding HasKeep, Converter={StaticResource b2v}}">
                                                                <TextBlock Text="{Binding BtnKeep}" FontSize="13"
                                                                           Foreground="{Binding DataContext.ThemeText, ElementName=root}"/>
                                                            </Button>
                                                            <Button Template="{StaticResource Flat6}" Height="28" Padding="10,0" Margin="6,0,0,0"
                                                                    BorderThickness="0" Cursor="Hand"
                                                                    Background="{Binding DataContext.ThemeAccent, ElementName=root}"
                                                                    Command="{Binding UndoCommand}" AutomationProperties.Name="{Binding BtnUndo}"
                                                                    Visibility="{Binding HasUndo, Converter={StaticResource b2v}}">
                                                                <TextBlock Text="{Binding BtnUndo}" FontSize="13" VerticalAlignment="Center"
                                                                           Foreground="{Binding DataContext.ThemeOnAccent, ElementName=root}"/>
                                                            </Button>
                                                            <Button Style="{StaticResource LineBtn}" Margin="6,0,0,0"
                                                                    BorderBrush="{Binding DataContext.ThemeBorder, ElementName=root}"
                                                                    Command="{Binding RedoCommand}" AutomationProperties.Name="{Binding BtnRedo}"
                                                                    Visibility="{Binding HasRedo, Converter={StaticResource b2v}}">
                                                                <TextBlock Text="{Binding BtnRedo}" FontSize="13"
                                                                           Foreground="{Binding DataContext.ThemeText, ElementName=root}"/>
                                                            </Button>
                                                        </StackPanel>
                                                        <Button Template="{StaticResource Flat6}" Background="Transparent" BorderThickness="0"
                                                                Padding="0" Cursor="Hand" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                Command="{Binding ToggleCommand}" ToolTip="{Binding Path}"
                                                                AutomationProperties.Name="{Binding Name}">
                                                            <WrapPanel>
                                                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center"
                                                                           Foreground="{Binding DataContext.ThemeSubtleText, ElementName=root}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="&#xE76C;"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                                    <Setter Property="Text" Value="&#xE70D;"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock Text="{Binding Name}" FontSize="13" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                           Foreground="{Binding DataContext.ThemeText, ElementName=root}"/>
                                                                <TextBlock Text="{Binding Added}" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                           Foreground="{Binding DataContext.ThemeOk, ElementName=root}"/>
                                                                <TextBlock Text="{Binding Removed}" FontSize="13" Margin="4,0,0,0" VerticalAlignment="Center"
                                                                           Foreground="{Binding DataContext.ThemeSubtleText, ElementName=root}"/>
                                                                <TextBlock Text="{Binding NewLabel}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                           Foreground="{Binding DataContext.ThemeSubtleText, ElementName=root}"/>
                                                                <TextBlock Text="{Binding StateLabel}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Foreground" Value="{Binding DataContext.ThemeSubtleText, ElementName=root}"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsChangedSince}" Value="True">
                                                                                    <Setter Property="Foreground" Value="{Binding DataContext.ThemeErrorText, ElementName=root}"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </WrapPanel>
                                                        </Button>
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding ChangedWhy}" FontSize="12" Margin="12,0,12,7" TextWrapping="Wrap"
                                                               Foreground="{Binding DataContext.ThemeSubtleText, ElementName=root}"
                                                               Visibility="{Binding IsChangedSince, Converter={StaticResource b2v}}"/>
                                                    <!-- Why its changes are not offered one by one (not text, too long, its encoding changed) -->
                                                    <TextBlock Text="{Binding WholeOnly}" FontSize="12" Margin="12,0,12,7" TextWrapping="Wrap"
                                                               Foreground="{Binding DataContext.ThemeSubtleText, ElementName=root}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding WholeOnly}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <!-- A file of several changes: each kept or undone on its own, under a row of its own -->
                                                    <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource b2v}}">
                                                        <TextBlock Text="{Binding PiecesSummary}" FontSize="12" Margin="30,0,12,6" TextWrapping="Wrap"
                                                                   Foreground="{Binding DataContext.ThemeSubtleText, ElementName=root}"
                                                                   Visibility="{Binding HasPieces, Converter={StaticResource b2v}}"/>
                                                        <ItemsControl ItemsSource="{Binding Pieces}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border BorderThickness="0,1,0,0" BorderBrush="{Binding DataContext.ThemeBorder, ElementName=root}">
                                                                        <StackPanel>
                                                                            <DockPanel Margin="30,5,12,5" LastChildFill="True">
                                                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                                                                            IsEnabled="{Binding CanAct}">
                                                                                    <Button Style="{StaticResource LineBtn}" Margin="6,0,0,0"
                                                                                            BorderBrush="{Binding DataContext.ThemeBorder, ElementName=root}"
                                                                                            Command="{Binding KeepCommand}" AutomationProperties.Name="{Binding KeepName}"
                                                                                            Visibility="{Binding HasKeep, Converter={StaticResource b2v}}">
                                                                                        <TextBlock Text="{Binding BtnKeep}" FontSize="12"
                                                                                                   Foreground="{Binding DataContext.ThemeText, ElementName=root}"/>
                                                                                    </Button>
                                                                                    <Button Template="{StaticResource Flat6}" Height="26" Padding="10,0" Margin="6,0,0,0"
                                                                                            BorderThickness="0" Cursor="Hand"
                                                                                            Background="{Binding DataContext.ThemeAccent, ElementName=root}"
                                                                                            Command="{Binding UndoCommand}" AutomationProperties.Name="{Binding UndoName}"
                                                                                            Visibility="{Binding HasUndo, Converter={StaticResource b2v}}">
                                                                                        <TextBlock Text="{Binding BtnUndo}" FontSize="12" VerticalAlignment="Center"
                                                                                                   Foreground="{Binding DataContext.ThemeOnAccent, ElementName=root}"/>
                                                                                    </Button>
                                                                                    <Button Style="{StaticResource LineBtn}" Margin="6,0,0,0"
                                                                                            BorderBrush="{Binding DataContext.ThemeBorder, ElementName=root}"
                                                                                            Command="{Binding RedoCommand}" AutomationProperties.Name="{Binding RedoName}"
                                                                                            Visibility="{Binding HasRedo, Converter={StaticResource b2v}}">
                                                                                        <TextBlock Text="{Binding BtnRedo}" FontSize="12"
                                                                                                   Foreground="{Binding DataContext.ThemeText, ElementName=root}"/>
                                                                                    </Button>
                                                                                </StackPanel>
                                                                                <WrapPanel VerticalAlignment="Center">
                                                                                    <TextBlock Text="{Binding Title}" FontSize="12" VerticalAlignment="Center"
                                                                                               Foreground="{Binding DataContext.ThemeText, ElementName=root}"/>
                                                                                    <TextBlock Text="{Binding LineLabel}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                                               Foreground="{Binding DataContext.ThemeSubtleText, ElementName=root}"/>
                                                                                    <TextBlock Text="{Binding StateLabel}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                                        <TextBlock.Style>
                                                                                            <Style TargetType="TextBlock">
                                                                                                <Setter Property="Foreground" Value="{Binding DataContext.ThemeSubtleText, ElementName=root}"/>
                                                                                                <Style.Triggers>
                                                                                                    <DataTrigger Binding="{Binding IsKept}" Value="True">
                                                                                                        <Setter Property="Foreground" Value="{Binding DataContext.ThemeOk, ElementName=root}"/>
                                                                                                    </DataTrigger>
                                                                                                </Style.Triggers>
                                                                                            </Style>
                                                                                        </TextBlock.Style>
                                                                                    </TextBlock>
                                                                                </WrapPanel>
                                                                            </DockPanel>
                                                                            <Border Padding="0,4" Background="{Binding DataContext.ThemeCodeBg, ElementName=root}">
                                                                                <ItemsControl ItemsSource="{Binding Lines}" FontFamily="Cascadia Mono, Consolas" FontSize="12">
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                            <Grid Background="{Binding Background}">
                                                                                                <Grid.ColumnDefinitions>
                                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                                    <ColumnDefinition Width="*"/>
                                                                                                </Grid.ColumnDefinitions>
                                                                                                <TextBlock Grid.Column="0" Text="{Binding Prefix}" Foreground="{Binding Foreground}"
                                                                                                           Margin="12,1,8,1"/>
                                                                                                <!-- Given back: its lines read as gone, still there to be redone -->
                                                                                                <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" Margin="0,1,12,1">
                                                                                                    <TextBlock.Style>
                                                                                                        <Style TargetType="TextBlock">
                                                                                                            <Setter Property="Foreground" Value="{Binding DataContext.ThemeText, ElementName=root}"/>
                                                                                                            <Style.Triggers>
                                                                                                                <!-- Only the run's lines: the lines from before the run are back in the file -->
                                                                                                                <MultiDataTrigger>
                                                                                                                    <MultiDataTrigger.Conditions>
                                                                                                                        <Condition Binding="{Binding DataContext.IsUndone, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True"/>
                                                                                                                        <Condition Binding="{Binding Prefix}" Value="+"/>
                                                                                                                    </MultiDataTrigger.Conditions>
                                                                                                                    <Setter Property="Foreground" Value="{Binding DataContext.ThemeSubtleText, ElementName=root}"/>
                                                                                                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                                                                </MultiDataTrigger>
                                                                                                            </Style.Triggers>
                                                                                                        </Style>
                                                                                                    </TextBlock.Style>
                                                                                                </TextBlock>
                                                                                            </Grid>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                            </Border>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                    <Border Padding="0,6" Background="{Binding DataContext.ThemeCodeBg, ElementName=root}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <!-- Its changes stand for its diff -->
                                                                    <DataTrigger Binding="{Binding HasPieces}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <ItemsControl ItemsSource="{Binding Lines}" FontFamily="Cascadia Mono, Consolas" FontSize="12">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Background="{Binding Background}">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Text="{Binding Prefix}" Foreground="{Binding Foreground}"
                                                                                   Margin="12,1,8,1"/>
                                                                        <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" Margin="0,1,12,1"
                                                                                   Foreground="{Binding DataContext.ThemeText, ElementName=root}"/>
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding ReviewStatus}" FontSize="12" Margin="12,8,12,0" TextWrapping="Wrap"
                                           Foreground="{Binding ThemeText}"
                                           Visibility="{Binding HasReviewStatus, Converter={StaticResource b2v}}"/>
                                <TextBlock Text="{Binding ReviewNote}" FontSize="12" Margin="12,8,12,10" TextWrapping="Wrap"
                                           Foreground="{Binding ThemeSubtleText}"/>
                            </StackPanel>
                        </Border>

                        <!-- ── A question's way back: the files going back changes, or why it cannot; then its choices ── -->
                        <Border CornerRadius="10" BorderThickness="1" Margin="48,0,0,0" Padding="12"
                                Background="{Binding DataContext.ThemeSurface, ElementName=root}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="BorderBrush" Value="{Binding DataContext.ThemeAccentLine, ElementName=root}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Role}" Value="rewind">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsRewindRefused}" Value="True">
                                            <Setter Property="BorderBrush" Value="{Binding DataContext.ThemeErrorLine, ElementName=root}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7BA;" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"
                                               Foreground="{Binding DataContext.ThemeErrorText, ElementName=root}"
                                               Visibility="{Binding IsRewindRefused, Converter={StaticResource b2v}}"/>
                                    <TextBlock Text="{Binding RewindTitle}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Foreground="{Binding ThemeText}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding RewindBody}" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{Binding ThemeSubtleText}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRewindRefused}" Value="True">
                                                    <Setter Property="Foreground" Value="{Binding ThemeText}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding RewindFiles}" Margin="0,8,0,0" FontFamily="Cascadia Mono, Consolas" FontSize="12">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,2" ToolTip="{Binding Path}">
                                                <TextBlock Text="{Binding Name}" Foreground="{Binding DataContext.ThemeText, ElementName=root}"/>
                                                <TextBlock Text="{Binding Label}" Margin="8,0,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{Binding DataContext.ThemeSubtleText, ElementName=root}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                                                    <Setter Property="Foreground" Value="{Binding DataContext.ThemeErrorText, ElementName=root}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding RewindNote}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Foreground="{Binding ThemeSubtleText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RewindNote}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding RewindStatus}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Foreground="{Binding ThemeText}"
                                           Visibility="{Binding HasRewindStatus, Converter={StaticResource b2v}}"/>
                                <!-- Refused: the conversation only, or the runs' reviews -->
                                <StackPanel Margin="0,8,0,0" IsEnabled="{Binding CanRewindAct}"
                                            Visibility="{Binding IsRewindRefused, Converter={StaticResource b2v}}">
                                    <Button Template="{StaticResource Flat6}" Background="Transparent" BorderThickness="1" Padding="10,8"
                                            Margin="0,0,0,6" Cursor="Hand" HorizontalContentAlignment="Left"
                                            BorderBrush="{Binding DataContext.ThemeBorder, ElementName=root}"
                                            Command="{Binding RewindConversationOnlyCommand}"
                                            AutomationProperties.Name="{Binding BtnRewindConversationOnly}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding BtnRewindConversationOnly}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{Binding ThemeText}"/>
                                            <TextBlock Text="{Binding RewindConversationOnlyHint}" FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{Binding ThemeSubtleText}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Template="{StaticResource Flat6}" Background="Transparent" BorderThickness="1" Padding="10,8"
                                            Cursor="Hand" HorizontalContentAlignment="Left"
                                            BorderBrush="{Binding DataContext.ThemeBorder, ElementName=root}"
                                            Command="{Binding RewindReviewCommand}" AutomationProperties.Name="{Binding BtnRewindReview}"
                                            Visibility="{Binding HasRewindReview, Converter={StaticResource b2v}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding BtnRewindReview}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{Binding ThemeText}"/>
                                            <TextBlock Text="{Binding RewindReviewHint}" FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{Binding ThemeSubtleText}"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                    <Button Style="{StaticResource LineBtn}" Margin="0"
                                            BorderBrush="{Binding DataContext.ThemeBorder, ElementName=root}"
                                            Command="{Binding RewindCancelCommand}" AutomationProperties.Name="{Binding BtnRewindCancel}">
                                        <TextBlock Text="{Binding BtnRewindCancel}" FontSize="13" Foreground="{Binding ThemeText}"/>
                                    </Button>
                                    <Button Template="{StaticResource Flat6}" Height="30" Padding="12,0" Margin="8,0,0,0" BorderThickness="0"
                                            Cursor="Hand" IsEnabled="{Binding CanRewindAct}"
                                            Background="{Binding DataContext.ThemeAccent, ElementName=root}"
                                            Command="{Binding RewindGoCommand}" AutomationProperties.Name="{Binding BtnRewindGo}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRewindRefused}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <TextBlock Text="{Binding BtnRewindGo}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{Binding DataContext.ThemeOnAccent, ElementName=root}"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ── An approval card: what will happen, to what, the start of the change; three answers ── -->
                        <Border CornerRadius="10" BorderThickness="1"
                                Background="{Binding DataContext.ThemeSurface, ElementName=root}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="BorderBrush" Value="{Binding DataContext.ThemeAccentLine, ElementName=root}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Role}" Value="approval">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsAnswered}" Value="True">
                                            <Setter Property="BorderBrush" Value="{Binding DataContext.ThemeBorder, ElementName=root}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <DockPanel Margin="12,10" LastChildFill="True">
                                    <Button DockPanel.Dock="Right" Template="{StaticResource Flat6}" Background="Transparent" BorderThickness="0"
                                            Padding="4,1" Margin="8,0,0,0" Cursor="Hand" VerticalAlignment="Center"
                                            Command="{Binding OpenDiffCommand}" AutomationProperties.Name="{Binding BtnOpenDiff}"
                                            Visibility="{Binding CanOpenDiff, Converter={StaticResource b2v}}">
                                        <TextBlock Text="{Binding BtnOpenDiff}" FontSize="12"
                                                   Foreground="{Binding DataContext.ThemeAccentText, ElementName=root}"/>
                                    </Button>
                                    <TextBlock DockPanel.Dock="Left" FontFamily="Segoe MDL2 Assets" Text="&#xEA18;" FontSize="14"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding DataContext.ThemeAccentText, ElementName=root}"/>
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding CardTitle}" FontSize="13" FontWeight="SemiBold"
                                               Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{Binding ThemeText}"/>
                                    <!-- Wrapped, never trimmed: the card is the only view of what is approved. -->
                                    <TextBlock Text="{Binding CardSubject}" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"
                                               TextWrapping="Wrap" Foreground="{Binding ThemeSubtleText}"/>
                                </DockPanel>
                                <Border BorderThickness="0,1,0,1" Padding="0,8" Background="{Binding ThemeCodeBg}"
                                        BorderBrush="{Binding DataContext.ThemeBorder, ElementName=root}"
                                        Visibility="{Binding HasCardLines, Converter={StaticResource b2v}}">
                                    <StackPanel>
                                        <ItemsControl ItemsSource="{Binding CardLines}" FontFamily="Cascadia Mono, Consolas" FontSize="12">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Background="{Binding Background}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding Prefix}" Foreground="{Binding Foreground}"
                                                                   Margin="12,1,8,1"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" Margin="0,1,12,1"
                                                                   Foreground="{Binding DataContext.ThemeText, ElementName=root}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding CardMore}" FontFamily="Cascadia Mono, Consolas" FontSize="12" Margin="12,1"
                                                   Foreground="{Binding ThemeSubtleText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CardMore}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <Grid Margin="12,10">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAnswered}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                    <Setter Property="Opacity" Value="0.55"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <DockPanel LastChildFill="True">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource LineBtn}" Height="32" Padding="10,0" Margin="0" VerticalAlignment="Top"
                                                BorderBrush="{Binding DataContext.ThemeBorder, ElementName=root}"
                                                Command="{Binding DenyCommand}" AutomationProperties.Name="{Binding BtnDeny}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE73E;" FontSize="11" Foreground="{Binding ThemeText}"
                                                           VerticalAlignment="Center" Margin="0,0,6,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ChosenAnswer}" Value="deny">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding BtnDeny}" FontSize="13" Foreground="{Binding ThemeText}"
                                                           VerticalAlignment="Center"/>
                                                <Border Style="{StaticResource Kbd}" BorderBrush="{Binding ThemeText}" Margin="8,0,0,0">
                                                    <TextBlock Text="Esc" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="{Binding ThemeText}"/>
                                                </Border>
                                            </StackPanel>
                                        </Button>
                                        <!-- The two that allow wrap under each other when the panel is narrow: each keeps a gap below,
                                             taken back by the panel's own margin so one row has none. -->
                                        <WrapPanel Margin="0,0,0,-6">
                                            <Button Template="{StaticResource Flat6}" Height="32" Padding="12,0" Margin="0,0,8,6" BorderThickness="0"
                                                    Background="{Binding DataContext.ThemeAccent, ElementName=root}" Cursor="Hand"
                                                    Command="{Binding AllowOnceCommand}" AutomationProperties.Name="{Binding BtnAllowOnce}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE73E;" FontSize="11" Foreground="{Binding DataContext.ThemeOnAccent, ElementName=root}"
                                                               VerticalAlignment="Center" Margin="0,0,6,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ChosenAnswer}" Value="once">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding BtnAllowOnce}" FontSize="13" FontWeight="SemiBold" Foreground="{Binding DataContext.ThemeOnAccent, ElementName=root}"
                                                               VerticalAlignment="Center"/>
                                                    <Border Style="{StaticResource Kbd}" BorderBrush="{Binding DataContext.ThemeOnAccent, ElementName=root}" Margin="8,0,0,0">
                                                        <TextBlock Text="Enter" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="{Binding DataContext.ThemeOnAccent, ElementName=root}"/>
                                                    </Border>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource LineBtn}" Height="32" Padding="10,0" Margin="0,0,8,6"
                                                    BorderBrush="{Binding DataContext.ThemeBorder, ElementName=root}"
                                                    Command="{Binding AlwaysAllowCommand}" ToolTip="{Binding CardAlwaysTip}"
                                                    AutomationProperties.Name="{Binding BtnAlwaysAllow}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE73E;" FontSize="11" Foreground="{Binding ThemeText}"
                                                               VerticalAlignment="Center" Margin="0,0,6,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ChosenAnswer}" Value="always">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding BtnAlwaysAllow}" FontSize="13" Foreground="{Binding ThemeText}"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <!-- The narrow rule, offered only when one describes the call: written to the machine's rules. -->
                                            <Button Height="32" Padding="10,0" Margin="0,0,8,6"
                                                    BorderBrush="{Binding DataContext.ThemeBorder, ElementName=root}"
                                                    Command="{Binding AlwaysRuleCommand}" ToolTip="{Binding CardRuleTip}"
                                                    AutomationProperties.Name="{Binding BtnAlwaysRule}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource LineBtn}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasRule}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE73E;" FontSize="11" Foreground="{Binding ThemeText}"
                                                               VerticalAlignment="Center" Margin="0,0,6,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ChosenAnswer}" Value="rule">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding BtnAlwaysRule}" FontSize="13" Foreground="{Binding ThemeText}"
                                                               VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="420"/>
                                                </StackPanel>
                                            </Button>
                                        </WrapPanel>
                                    </DockPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ── An input card: an MCP server's form, then Send, Decline, Cancel (InputCard in the Core) ──
                             Never takes the keyboard: a field gets it from a click. Esc anywhere in it cancels; Enter in a box
                             sends. -->
                        <Border CornerRadius="10" BorderThickness="1"
                                Background="{Binding DataContext.ThemeSurface, ElementName=root}"
                                AutomationProperties.Name="{Binding CardTitle}">
                            <Border.InputBindings>
                                <KeyBinding Key="Escape" Command="{Binding InputCancelCommand}"/>
                            </Border.InputBindings>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Setter Property="BorderBrush" Value="{Binding DataContext.ThemeAccentLine, ElementName=root}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Role}" Value="inputcard">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsAnswered}" Value="True">
                                            <Setter Property="BorderBrush" Value="{Binding DataContext.ThemeBorder, ElementName=root}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <Border BorderThickness="0,0,0,1" Padding="12,10"
                                        BorderBrush="{Binding DataContext.ThemeBorder, ElementName=root}">
                                    <DockPanel LastChildFill="True">
                                        <!-- A connector: what asks is a server Inferpal is connected to. -->
                                        <TextBlock DockPanel.Dock="Left" FontFamily="Segoe MDL2 Assets" Text="&#xE839;" FontSize="14"
                                                   Margin="0,2,10,0" VerticalAlignment="Top"
                                                   Foreground="{Binding DataContext.ThemeAccentText, ElementName=root}"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding CardTitle}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                                                       Foreground="{Binding ThemeText}"/>
                                            <TextBlock Text="{Binding InputSubtitle}" FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{Binding ThemeSubtleText}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <StackPanel Margin="12,12,12,0">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAnswered}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                    <Setter Property="Opacity" Value="0.55"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <!-- The server's own words, as plain text: never Markdown, never a link. -->
                                    <TextBlock Text="{Binding InputMessage}" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12"
                                               Foreground="{Binding ThemeText}"/>
                                    <Border CornerRadius="6" Padding="10,7" Margin="0,0,0,12" BorderThickness="1"
                                            BorderBrush="{Binding DataContext.ThemeErrorText, ElementName=root}"
                                            Visibility="{Binding HasInputError, Converter={StaticResource b2v}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7BA;" FontSize="13" VerticalAlignment="Center"
                                                       Foreground="{Binding DataContext.ThemeErrorText, ElementName=root}"/>
                                            <TextBlock Text="{Binding InputErrorSummary}" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0"
                                                       TextWrapping="Wrap" VerticalAlignment="Center"
                                                       Foreground="{Binding DataContext.ThemeErrorText, ElementName=root}"/>
                                        </StackPanel>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding InputFields}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,12">
                                                    <!-- The label, above the field; a box carries its own. -->
                                                    <TextBlock FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4"
                                                               Foreground="{Binding DataContext.ThemeText, ElementName=root}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsBox}" Value="True">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                        <Run Text="{Binding Label, Mode=OneWay}"/>
                                                        <Run Text="{Binding RequiredMark, Mode=OneWay}"
                                                             Foreground="{Binding DataContext.ThemeAccentText, ElementName=root}"/>
                                                    </TextBlock>
                                                    <!-- Text, a number, a date, an address: typed, and checked by the Core when sent. -->
                                                    <TextBox Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             Height="30" Padding="8,0" VerticalContentAlignment="Center" FontSize="13"
                                                             Background="Transparent"
                                                             Foreground="{Binding DataContext.ThemeText, ElementName=root}"
                                                             CaretBrush="{Binding DataContext.ThemeText, ElementName=root}"
                                                             AutomationProperties.Name="{Binding Label}"
                                                             AutomationProperties.HelpText="{Binding Hint}"
                                                             Visibility="{Binding IsTextBox, Converter={StaticResource b2v}}">
                                                        <TextBox.Style>
                                                            <Style TargetType="TextBox">
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                                <Setter Property="BorderBrush" Value="{Binding DataContext.ThemeInputBorder, ElementName=root}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                                                        <Setter Property="BorderThickness" Value="2"/>
                                                                        <Setter Property="BorderBrush" Value="{Binding DataContext.ThemeErrorText, ElementName=root}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBox.Style>
                                                        <TextBox.InputBindings>
                                                            <KeyBinding Key="Return" Command="{Binding SendCommand}"/>
                                                        </TextBox.InputBindings>
                                                    </TextBox>
                                                    <!-- Yes or no: a box. -->
                                                    <CheckBox IsChecked="{Binding Flag, Mode=TwoWay}" VerticalContentAlignment="Center"
                                                              AutomationProperties.Name="{Binding Label}"
                                                              Visibility="{Binding IsBox, Converter={StaticResource b2v}}">
                                                        <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="4,0,0,0"
                                                                   Foreground="{Binding DataContext.ThemeText, ElementName=root}"/>
                                                    </CheckBox>
                                                    <!-- One choice among few short ones: buttons side by side, one pressed. -->
                                                    <Border CornerRadius="7" BorderThickness="1" Padding="2"
                                                            BorderBrush="{Binding DataContext.ThemeBorder, ElementName=root}"
                                                            Background="{Binding DataContext.ThemeWindowBg, ElementName=root}"
                                                            Visibility="{Binding IsSegmented, Converter={StaticResource b2v}}">
                                                        <ItemsControl ItemsSource="{Binding Options}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <UniformGrid Rows="1"/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <RadioButton GroupName="{Binding Group}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                                 Cursor="Hand" AutomationProperties.Name="{Binding Label}">
                                                                        <RadioButton.Template>
                                                                            <ControlTemplate TargetType="RadioButton">
                                                                                <Border x:Name="seg" CornerRadius="5" Height="26" Background="Transparent">
                                                                                    <TextBlock x:Name="segText" Text="{Binding Label}" FontSize="13"
                                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                               Margin="8,0" TextTrimming="CharacterEllipsis"
                                                                                               Foreground="{Binding DataContext.ThemeSubtleText, ElementName=root}"/>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsChecked" Value="True">
                                                                                        <Setter TargetName="seg" Property="Background" Value="{Binding DataContext.ThemeChip, ElementName=root}"/>
                                                                                        <Setter TargetName="segText" Property="Foreground" Value="{Binding DataContext.ThemeText, ElementName=root}"/>
                                                                                        <Setter TargetName="segText" Property="FontWeight" Value="SemiBold"/>
                                                                                    </Trigger>
                                                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                                                        <Setter TargetName="seg" Property="BorderThickness" Value="1"/>
                                                                                        <Setter TargetName="seg" Property="BorderBrush" Value="{Binding DataContext.ThemeAccent, ElementName=root}"/>
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </RadioButton.Template>
                                                                    </RadioButton>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Border>
                                                    <!-- One choice among many, or long ones: radio buttons, one under the other. -->
                                                    <ItemsControl ItemsSource="{Binding Options}"
                                                                  Visibility="{Binding IsRadioList, Converter={StaticResource b2v}}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <RadioButton GroupName="{Binding Group}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                             Margin="0,2,14,2" VerticalContentAlignment="Center"
                                                                             AutomationProperties.Name="{Binding Label}">
                                                                    <TextBlock Text="{Binding Label}" FontSize="13" Margin="4,0,0,0"
                                                                               Foreground="{Binding DataContext.ThemeText, ElementName=root}"/>
                                                                </RadioButton>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <!-- Several choices: a box per choice. -->
                                                    <ItemsControl ItemsSource="{Binding Options}"
                                                                  Visibility="{Binding IsChoices, Converter={StaticResource b2v}}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="0,2"
                                                                          VerticalContentAlignment="Center" AutomationProperties.Name="{Binding Label}">
                                                                    <TextBlock Text="{Binding Label}" FontSize="13" Margin="4,0,0,0"
                                                                               Foreground="{Binding DataContext.ThemeText, ElementName=root}"/>
                                                                </CheckBox>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Text="{Binding Hint}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                                                               Foreground="{Binding DataContext.ThemeSubtleText, ElementName=root}"
                                                               Visibility="{Binding HasHint, Converter={StaticResource b2v}}"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                                                Visibility="{Binding HasError, Converter={StaticResource b2v}}">
                                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE783;" FontSize="11" VerticalAlignment="Center"
                                                                   Foreground="{Binding DataContext.ThemeErrorText, ElementName=root}"/>
                                                        <TextBlock Text="{Binding Error}" FontSize="12" Margin="6,0,0,0" TextWrapping="Wrap"
                                                                   Foreground="{Binding DataContext.ThemeErrorText, ElementName=root}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <DockPanel Margin="0,0,0,12">
                                        <TextBlock DockPanel.Dock="Left" FontFamily="Segoe MDL2 Assets" Text="&#xE946;" FontSize="12"
                                                   Margin="0,2,8,0" VerticalAlignment="Top" Foreground="{Binding ThemeSubtleText}"/>
                                        <TextBlock Text="{Binding InputReminder}" FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{Binding ThemeSubtleText}"/>
                                    </DockPanel>
                                </StackPanel>
                                <Border BorderThickness="0,1,0,0" Padding="12,10"
                                        BorderBrush="{Binding DataContext.ThemeBorder, ElementName=root}">
                                    <DockPanel LastChildFill="True">
                                        <DockPanel.Style>
                                            <Style TargetType="DockPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAnswered}" Value="True">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                        <Setter Property="Opacity" Value="0.55"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DockPanel.Style>
                                        <Button DockPanel.Dock="Right" Template="{StaticResource Flat6}" Height="32" Padding="10,0"
                                                Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Top"
                                                Command="{Binding InputCancelCommand}" ToolTip="{Binding InputCancelTip}"
                                                AutomationProperties.Name="{Binding BtnInputCancel}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding BtnInputCancel}" FontSize="13" Foreground="{Binding ThemeSubtleText}"
                                                           VerticalAlignment="Center"/>
                                                <Border Style="{StaticResource Kbd}" BorderBrush="{Binding ThemeSubtleText}" Margin="8,0,0,0">
                                                    <TextBlock Text="Esc" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="{Binding ThemeSubtleText}"/>
                                                </Border>
                                            </StackPanel>
                                        </Button>
                                        <WrapPanel Margin="0,0,0,-6">
                                            <Button Template="{StaticResource Flat6}" Height="32" Padding="12,0" Margin="0,0,8,6" BorderThickness="0"
                                                    Background="{Binding DataContext.ThemeAccent, ElementName=root}" Cursor="Hand"
                                                    Command="{Binding InputSendCommand}" AutomationProperties.Name="{Binding BtnInputSend}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding BtnInputSend}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                                               Foreground="{Binding DataContext.ThemeOnAccent, ElementName=root}"/>
                                                    <Border Style="{StaticResource Kbd}" BorderBrush="{Binding DataContext.ThemeOnAccent, ElementName=root}" Margin="8,0,0,0">
                                                        <TextBlock Text="Enter" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="{Binding DataContext.ThemeOnAccent, ElementName=root}"/>
                                                    </Border>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource LineBtn}" Height="32" Padding="10,0" Margin="0,0,8,6"
                                                    BorderBrush="{Binding DataContext.ThemeBorder, ElementName=root}"
                                                    Command="{Binding InputDeclineCommand}" ToolTip="{Binding InputDeclineTip}"
                                                    AutomationProperties.Name="{Binding BtnInputDecline}">
                                                <TextBlock Text="{Binding BtnInputDecline}" FontSize="13" Foreground="{Binding ThemeText}"
                                                           VerticalAlignment="Center"/>
                                            </Button>
                                        </WrapPanel>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- ── An input card's receipt: what the person did with the form, what they sent folded under it ── -->
                        <Border CornerRadius="8" BorderThickness="1" Padding="10,0"
                                Background="{Binding DataContext.ThemeSurface, ElementName=root}"
                                BorderBrush="{Binding DataContext.ThemeBorder, ElementName=root}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Role}" Value="input">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <Button Template="{StaticResource Flat6}" Background="Transparent" BorderThickness="0" Padding="0,6"
                                        HorizontalContentAlignment="Stretch" Cursor="Hand"
                                        Command="{Binding ToggleExpandCommand}" AutomationProperties.Name="{Binding ReceiptTitle}">
                                    <DockPanel LastChildFill="True">
                                        <TextBlock DockPanel.Dock="Right" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="8,0,0,0"
                                                   VerticalAlignment="Center" Foreground="{Binding ThemeSubtleText}"
                                                   Visibility="{Binding HasReceiptBody, Converter={StaticResource b2v}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="&#xE70D;"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                            <Setter Property="Text" Value="&#xE70E;"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock DockPanel.Dock="Left" FontFamily="Segoe MDL2 Assets" Text="{Binding RunGlyph}" FontSize="12"
                                                   VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{Binding ThemeSubtleText}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasReceiptBody}" Value="True">
                                                            <Setter Property="Foreground" Value="{Binding DataContext.ThemeOk, ElementName=root}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" FontSize="13">
                                            <Run Text="{Binding ReceiptTitle, Mode=OneWay}" Foreground="{Binding ThemeText}"/>
                                            <Run Text="  "/>
                                            <Run Text="{Binding ReceiptDetail, Mode=OneWay}" Foreground="{Binding ThemeSubtleText}"/>
                                        </TextBlock>
                                    </DockPanel>
                                </Button>
                                <TextBlock Text="{Binding ReceiptBody}" FontSize="12" TextWrapping="Wrap" Margin="20,0,0,8"
                                           Foreground="{Binding ThemeText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- ── An import card: a box per item, the reasons for the rest folded, Apply ── -->
                        <Border CornerRadius="10" BorderThickness="1"
                                Background="{Binding DataContext.ThemeSurface, ElementName=root}"
                                BorderBrush="{Binding DataContext.ThemeBorder, ElementName=root}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Role}" Value="import">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <StackPanel Margin="12,10,12,6">
                                    <TextBlock Text="{Binding CardTitle}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Foreground="{Binding ThemeText}"/>
                                    <TextBlock Text="{Binding CardSubject}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Foreground="{Binding ThemeSubtleText}"/>
                                </StackPanel>
                                <!-- The boxes: what ticking each one writes, and what is said under it. Frozen once applied. -->
                                <ItemsControl ItemsSource="{Binding ImportRows}" Margin="12,0,12,4"
                                              Visibility="{Binding HasImportRows, Converter={StaticResource b2v}}">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAnswered}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                    <Setter Property="Opacity" Value="0.55"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,3" VerticalContentAlignment="Top"
                                                      AutomationProperties.Name="{Binding AccessibleName}">
                                                <StackPanel Margin="4,0,0,0">
                                                    <TextBlock Text="{Binding Target}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                                                               Foreground="{Binding DataContext.ThemeText, ElementName=root}"/>
                                                    <TextBlock Text="{Binding Label}" FontSize="13" TextWrapping="Wrap"
                                                               Foreground="{Binding DataContext.ThemeText, ElementName=root}"/>
                                                    <TextBlock Text="{Binding Notes}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"
                                                               Foreground="{Binding DataContext.ThemeSubtleText, ElementName=root}"
                                                               Visibility="{Binding HasNotes, Converter={StaticResource b2v}}"/>
                                                </StackPanel>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- The reasons, folded: a fold button, then a line per reason with the paths it covers. -->
                                <StackPanel Margin="12,0,12,4" Visibility="{Binding HasImportSkips, Converter={StaticResource b2v}}">
                                    <Button Template="{StaticResource Flat6}" Background="Transparent" BorderThickness="0" Padding="2,2"
                                            HorizontalAlignment="Left" Cursor="Hand"
                                            Command="{Binding ToggleImportSkipsCommand}" AutomationProperties.Name="{Binding ImportSkippedTitle}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center"
                                                       Foreground="{Binding ThemeSubtleText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="&#xE76C;"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ImportSkipsOpen}" Value="True">
                                                                <Setter Property="Text" Value="&#xE70D;"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding ImportSkippedTitle}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"
                                                       Foreground="{Binding ThemeSubtleText}"/>
                                        </StackPanel>
                                    </Button>
                                    <ItemsControl ItemsSource="{Binding ImportSkips}" Margin="18,2,0,0"
                                                  Visibility="{Binding ImportSkipsOpen, Converter={StaticResource b2v}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,3">
                                                    <TextBlock Text="{Binding Reason}" FontSize="12" TextWrapping="Wrap"
                                                               Foreground="{Binding DataContext.ThemeText, ElementName=root}"/>
                                                    <TextBlock Text="{Binding Paths}" FontSize="11" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas"
                                                               Foreground="{Binding DataContext.ThemeSubtleText, ElementName=root}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <Button Template="{StaticResource Flat6}" Height="32" Padding="12,0" Margin="12,4,12,12"
                                        HorizontalAlignment="Left" BorderThickness="0" Cursor="Hand"
                                        Background="{Binding DataContext.ThemeAccent, ElementName=root}"
                                        Command="{Binding ImportApplyCommand}" AutomationProperties.Name="{Binding BtnImportApply}"
                                        Visibility="{Binding HasImportRows, Converter={StaticResource b2v}}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAnswered}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                    <Setter Property="Opacity" Value="0.55"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="{Binding BtnImportApply}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                               Foreground="{Binding DataContext.ThemeOnAccent, ElementName=root}"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- ── Welcome: what to work on — the open file's actions, the last build, the keys ── -->
        <!-- Over the (empty) message list: shown while the conversation holds nothing but the two scroll anchors. -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding ShowWelcome, Converter={StaticResource b2v}}">
            <StackPanel VerticalAlignment="Center" Margin="20,24" MaxWidth="560">
                <TextBlock Text="{Binding WelcomeTitle}" FontSize="22" FontWeight="SemiBold" Foreground="{Binding ThemeText}"
                           TextWrapping="Wrap"/>
                <TextBlock Text="{Binding WelcomeLine}" FontSize="13" Foreground="{Binding ThemeSubtleText}" Margin="0,6,0,0"
                           TextWrapping="Wrap"/>

                <!-- With a file open: its actions -->
                <StackPanel Margin="0,24,0,0" Visibility="{Binding HasActiveFile, Converter={StaticResource b2v}}">
                    <TextBlock Text="{Binding WelcomeForFile}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding ThemeSubtleText}"
                               Margin="0,0,0,8" TextTrimming="CharacterEllipsis"/>
                    <Button Template="{StaticResource Flat10}" Padding="12,10" Margin="0,0,0,8" Cursor="Hand"
                            Background="{Binding ThemeSurface}" BorderBrush="{Binding ThemeBorder}" BorderThickness="1"
                            HorizontalContentAlignment="Stretch"
                            Command="{Binding RunSuggestionCommand}" CommandParameter="/explain"
                            AutomationProperties.Name="{Binding WelcomeExplainTitle}">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="7" Background="{Binding ThemeChip}" Margin="0,0,12,0">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE946;" FontSize="14" Foreground="{Binding ThemeAccentText}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding WelcomeExplainTitle}" FontSize="13" Foreground="{Binding ThemeText}"/>
                                <TextBlock Text="{Binding WelcomeExplainDesc}" FontSize="12" Foreground="{Binding ThemeSubtleText}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Button>
                    <Button Template="{StaticResource Flat10}" Padding="12,10" Margin="0,0,0,8" Cursor="Hand"
                            Background="{Binding ThemeSurface}" BorderBrush="{Binding ThemeBorder}" BorderThickness="1"
                            HorizontalContentAlignment="Stretch"
                            Command="{Binding RunSuggestionCommand}" CommandParameter="/test"
                            AutomationProperties.Name="{Binding WelcomeTestsTitle}">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="7" Background="{Binding ThemeChip}" Margin="0,0,12,0">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9D5;" FontSize="14" Foreground="{Binding ThemeAccentText}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding WelcomeTestsTitle}" FontSize="13" Foreground="{Binding ThemeText}"/>
                                <TextBlock Text="{Binding WelcomeTestsDesc}" FontSize="12" Foreground="{Binding ThemeSubtleText}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Button>
                    <Button Template="{StaticResource Flat10}" Padding="12,10" Cursor="Hand"
                            Background="{Binding ThemeSurface}" BorderBrush="{Binding ThemeBorder}" BorderThickness="1"
                            HorizontalContentAlignment="Stretch"
                            Command="{Binding RunUsagesCommand}"
                            AutomationProperties.Name="{Binding WelcomeUsagesTitle}">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="7" Background="{Binding ThemeChip}" Margin="0,0,12,0">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;" FontSize="14" Foreground="{Binding ThemeAccentText}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding WelcomeUsagesTitle}" FontSize="13" Foreground="{Binding ThemeText}"/>
                                <TextBlock Text="{Binding WelcomeUsagesDesc}" FontSize="12" Foreground="{Binding ThemeSubtleText}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Button>
                </StackPanel>

                <!-- Without one: the general entry points -->
                <UniformGrid Columns="2" Margin="-4,20,-4,0">
                    <UniformGrid.Style>
                        <Style TargetType="UniformGrid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasActiveFile}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </UniformGrid.Style>
                    <!-- Without a file, what works without one: /explain, /fix and /test would only answer "open a file". -->
                    <Button Template="{StaticResource Flat10}" Padding="12,10" Margin="4" Cursor="Hand"
                            Background="{Binding ThemeSurface}" BorderBrush="{Binding ThemeBorder}" BorderThickness="1"
                            HorizontalContentAlignment="Stretch"
                            Command="{Binding RunSuggestionCommand}" CommandParameter="{Binding WelcomeProjectPrompt}"
                            AutomationProperties.Name="{Binding WelcomeCardProject}">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="7" Background="{Binding ThemeChip}" Margin="0,0,10,0">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" FontSize="14" Foreground="{Binding ThemeAccentText}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding WelcomeCardProject}" FontSize="13" Foreground="{Binding ThemeText}"
                                       TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Button>
                    <Button Template="{StaticResource Flat10}" Padding="12,10" Margin="4" Cursor="Hand"
                            Background="{Binding ThemeSurface}" BorderBrush="{Binding ThemeBorder}" BorderThickness="1"
                            HorizontalContentAlignment="Stretch"
                            Command="{Binding RunSuggestionCommand}" CommandParameter="{Binding WelcomeChangesPrompt}"
                            AutomationProperties.Name="{Binding WelcomeCardChanges}">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="7" Background="{Binding ThemeChip}" Margin="0,0,10,0">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE81C;" FontSize="14" Foreground="{Binding ThemeAccentText}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding WelcomeCardChanges}" FontSize="13" Foreground="{Binding ThemeText}"
                                       TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Button>
                    <Button Template="{StaticResource Flat10}" Padding="12,10" Margin="4" Cursor="Hand"
                            Background="{Binding ThemeSurface}" BorderBrush="{Binding ThemeBorder}" BorderThickness="1"
                            HorizontalContentAlignment="Stretch"
                            Command="{Binding RunSuggestionCommand}" CommandParameter="/help"
                            AutomationProperties.Name="{Binding WelcomeCardHelp}">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="7" Background="{Binding ThemeChip}" Margin="0,0,10,0">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE9CE;" FontSize="14" Foreground="{Binding ThemeAccentText}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding WelcomeCardHelp}" FontSize="13" Foreground="{Binding ThemeText}"
                                       TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Button>
                </UniformGrid>
                <TextBlock Text="{Binding WelcomeOpenFileHint}" FontSize="12" Foreground="{Binding ThemeSubtleText}"
                           TextWrapping="Wrap" Margin="0,8,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasActiveFile}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- The last build failed: Fix them runs /fix-build -->
                <Border Margin="0,24,0,0" CornerRadius="10" BorderThickness="1" Padding="12,10"
                        Background="{Binding ThemeErrorBg}" BorderBrush="{Binding ThemeErrorLine}"
                        Visibility="{Binding HasBuildFailedBanner, Converter={StaticResource b2v}}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" FontFamily="Segoe MDL2 Assets" Text="&#xE7BA;" FontSize="14"
                                   Foreground="{Binding ThemeErrorText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource LineBtn}" Margin="12,0,0,0"
                                BorderBrush="{Binding ThemeErrorLine}" Foreground="{Binding ThemeErrorText}"
                                Content="{Binding WelcomeFixThem}" Command="{Binding FixBuildBannerCommand}"/>
                        <TextBlock Text="{Binding WelcomeBuildFailed}" FontSize="13" Foreground="{Binding ThemeText}"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>

                <!-- The keys -->
                <WrapPanel Margin="0,24,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,14,6">
                        <Border Style="{StaticResource Kbd}" BorderBrush="{Binding ThemeSubtleText}">
                            <TextBlock Text="@" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="{Binding ThemeSubtleText}"/>
                        </Border>
                        <TextBlock Text="{Binding HintAttach}" FontSize="12" Foreground="{Binding ThemeSubtleText}" Margin="6,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,14,6">
                        <Border Style="{StaticResource Kbd}" BorderBrush="{Binding ThemeSubtleText}">
                            <TextBlock Text="/" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="{Binding ThemeSubtleText}"/>
                        </Border>
                        <TextBlock Text="{Binding HintCommands}" FontSize="12" Foreground="{Binding ThemeSubtleText}" Margin="6,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,14,6">
                        <Border Style="{StaticResource Kbd}" BorderBrush="{Binding ThemeSubtleText}">
                            <TextBlock Text="Shift" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="{Binding ThemeSubtleText}"/>
                        </Border>
                        <Border Style="{StaticResource Kbd}" BorderBrush="{Binding ThemeSubtleText}" Margin="4,0,0,0">
                            <TextBlock Text="Enter" FontFamily="Cascadia Mono, Consolas" FontSize="10" Foreground="{Binding ThemeSubtleText}"/>
                        </Border>
                        <TextBlock Text="{Binding HintNewLine}" FontSize="12" Foreground="{Binding ThemeSubtleText}" Margin="6,0,0,0"/>
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ── Context X-Ray panel (interactive /xray V2) ── -->
        <!-- Overlays the messages list; opened from the context gauge or /xray. Rows are
             cross-boundary primitives (XRaySectionItem) with per-item theme colours. -->
        <Border Grid.Row="2" Background="{Binding ThemePanelBg}"
                Visibility="{Binding IsXrayPanelOpen, Converter={StaticResource b2v}}">
            <DockPanel Margin="10,8">
                <!-- Header: title/total + copy + close -->
                <DockPanel DockPanel.Dock="Top" LastChildFill="True" Margin="0,0,0,6">
                    <Button FontFamily="Segoe MDL2 Assets" DockPanel.Dock="Right" Padding="6,2" Margin="4,0,0,0"
                            Content="&#xE711;" Foreground="{Binding ThemeSubtleText}"
                            ToolTip="{Binding TooltipXrayClose}" AutomationProperties.Name="{Binding TooltipXrayClose}"
                            Command="{Binding ToggleXrayPanelCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" CornerRadius="4" Background="Transparent"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{Binding DataContext.ThemeHoverBg, ElementName=root}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button DockPanel.Dock="Right" Padding="8,2" Margin="8,0,0,0"
                            Content="{Binding BtnXrayCopy}" Foreground="{Binding ThemeText}" FontSize="11"
                            Command="{Binding CopyXrayPromptCommand}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" CornerRadius="4" Background="Transparent"
                                        BorderThickness="1" BorderBrush="{Binding ThemeInputBorder}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{Binding DataContext.ThemeHoverBg, ElementName=root}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <TextBlock Text="{Binding XrayTotalText}" Foreground="{Binding ThemeText}"
                               FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>

                <!-- Footer: history estimate + toggle hint + overhead warning -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <TextBlock Text="{Binding XrayPanelWarning}" Foreground="#D06000" FontSize="11"
                               TextWrapping="Wrap" Margin="0,0,0,2"
                               Visibility="{Binding HasXrayWarning, Converter={StaticResource b2v}}"/>
                    <TextBlock Text="{Binding XrayHistoryText}" Foreground="{Binding ThemeSubtleText}" FontSize="10"/>
                    <TextBlock Text="{Binding XrayPanelHint}"   Foreground="{Binding ThemeSubtleText}" FontSize="10"/>
                </StackPanel>

                <!-- Section rows -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding XraySections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="0,0,0,1" BorderBrush="{Binding ThemeCodeBorder}" Padding="0,5">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- Enabled toggle (hidden for the base prompt) -->
                                            <Button Grid.Column="0" Padding="2,0" Margin="0,0,6,0"
                                                    Command="{Binding ToggleEnabledCommand}"
                                                    Visibility="{Binding CanToggle, Converter={StaticResource b2v}}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{Binding ThemeText}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="&#xE73A;"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                                                <Setter Property="Text" Value="&#xE739;"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="12"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{Binding ThemeText}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                                <Setter Property="Foreground" Value="{Binding ThemeSubtleText}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="2" Text="{Binding TokensText}" FontSize="11"
                                                       Foreground="{Binding ThemeSubtleText}"
                                                       VerticalAlignment="Center" Margin="8,0"/>
                                            <!-- Expand/collapse the exact section content -->
                                            <Button Grid.Column="3" Padding="4,0"
                                                    Command="{Binding ToggleExpandCommand}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{Binding ThemeSubtleText}">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="&#xE970;"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                                <Setter Property="Text" Value="&#xE96E;"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                        <ProgressBar Value="{Binding Percent}" Minimum="0" Maximum="100"
                                                     Height="3" Margin="0,4,0,0"
                                                     Foreground="#7C4DFF" BorderThickness="0"/>
                                        <!-- Exact content preview (read-only, scrollable) -->
                                        <Border Margin="0,5,0,0" CornerRadius="4"
                                                Background="{Binding ThemeCodeBg}"
                                                BorderThickness="1" BorderBrush="{Binding ThemeCodeBorder}"
                                                Visibility="{Binding IsExpanded, Converter={StaticResource b2v}}">
                                            <TextBox Text="{Binding Content, Mode=OneWay}" IsReadOnly="True"
                                                     Background="Transparent" BorderThickness="0"
                                                     Foreground="{Binding ThemeText}" FontSize="11"
                                                     FontFamily="Cascadia Mono, Consolas"
                                                     TextWrapping="Wrap" MaxHeight="150" Padding="6"
                                                     VerticalScrollBarVisibility="Auto"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ── Header menus: over the conversation; a click outside closes them ── -->
        <Grid Grid.Row="2" Visibility="{Binding IsAnyMenuOpen, Converter={StaticResource b2v}}">
            <Button Command="{Binding CloseMenusCommand}" Focusable="False" Cursor="Arrow">
                <Button.Template>
                    <ControlTemplate TargetType="Button"><Border Background="Transparent"/></ControlTemplate>
                </Button.Template>
            </Button>

            <!-- The models the server lists; the one in use is checked -->
            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,4,0,0" MinWidth="240" MaxWidth="380"
                    CornerRadius="8" BorderThickness="1" Padding="4"
                    Background="{Binding ThemeSurface}" BorderBrush="{Binding ThemeBorder}"
                    Visibility="{Binding IsModelMenuOpen, Converter={StaticResource b2v}}">
                <StackPanel>
                    <Button Style="{StaticResource MenuBtn}" Command="{Binding RetryConnectionCommand}"
                            Visibility="{Binding ShowRetryButton, Converter={StaticResource b2v}}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Width="20" FontFamily="Segoe MDL2 Assets" Text="&#xE72C;" FontSize="12"
                                       VerticalAlignment="Center" Foreground="{Binding ThemeText}"/>
                            <TextBlock Text="{Binding TooltipRetryConnection}" FontSize="13" Foreground="{Binding ThemeText}"
                                       TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </Button>
                    <TextBlock Text="{Binding ModelMenuNote}" FontSize="12" Foreground="{Binding ThemeSubtleText}" Margin="8,6"
                               TextWrapping="Wrap" Visibility="{Binding HasModelMenuNote, Converter={StaticResource b2v}}"/>
                    <ItemsControl ItemsSource="{Binding ModelChoices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Template="{StaticResource Flat6}" Background="Transparent" BorderThickness="0" Padding="8,6"
                                        HorizontalContentAlignment="Stretch" Cursor="Hand"
                                        Command="{Binding PickCommand}" AutomationProperties.Name="{Binding Name}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Width="20" FontFamily="Segoe MDL2 Assets" Text="&#xE73E;" FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding DataContext.ThemeAccentText, ElementName=root}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Opacity" Value="0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                            <Setter Property="Opacity" Value="1"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis"
                                                   Foreground="{Binding DataContext.ThemeText, ElementName=root}"/>
                                    </DockPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- More: search, export, the X-Ray, step mode, settings -->
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,10,0" MinWidth="230"
                    CornerRadius="8" BorderThickness="1" Padding="4"
                    Background="{Binding ThemeSurface}" BorderBrush="{Binding ThemeBorder}"
                    Visibility="{Binding IsMoreMenuOpen, Converter={StaticResource b2v}}">
                <StackPanel>
                    <Button Style="{StaticResource MenuBtn}" Command="{Binding MenuSearchCommand}" AutomationProperties.Name="{Binding LabelMenuSearch}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Width="22" FontFamily="Segoe MDL2 Assets" Text="&#xE721;" FontSize="12"
                                       VerticalAlignment="Center" Foreground="{Binding ThemeText}"/>
                            <TextBlock Text="{Binding LabelMenuSearch}" FontSize="13" Foreground="{Binding ThemeText}"/>
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource MenuBtn}" Command="{Binding MenuExportCommand}" AutomationProperties.Name="{Binding LabelMenuExport}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Width="22" FontFamily="Segoe MDL2 Assets" Text="&#xE74E;" FontSize="12"
                                       VerticalAlignment="Center" Foreground="{Binding ThemeText}"/>
                            <TextBlock Text="{Binding LabelMenuExport}" FontSize="13" Foreground="{Binding ThemeText}"/>
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource MenuBtn}" Command="{Binding MenuXrayCommand}" AutomationProperties.Name="{Binding LabelMenuXray}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Width="22" FontFamily="Segoe MDL2 Assets" Text="&#xE9D9;" FontSize="12"
                                       VerticalAlignment="Center" Foreground="{Binding ThemeText}"/>
                            <TextBlock Text="{Binding LabelMenuXray}" FontSize="13" Foreground="{Binding ThemeText}"/>
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource MenuBtn}" Command="{Binding MenuStepModeCommand}" AutomationProperties.Name="{Binding LabelMenuStepMode}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Width="22" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       VerticalAlignment="Center" Foreground="{Binding ThemeText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE769;"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStepMode}" Value="True">
                                                <Setter Property="Text" Value="&#xE73E;"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding LabelMenuStepMode}" FontSize="13" Foreground="{Binding ThemeText}"/>
                        </DockPanel>
                    </Button>
                    <Border Height="1" Margin="4,4" Background="{Binding ThemeBorder}"/>
                    <Button Style="{StaticResource MenuBtn}" Command="{Binding MenuSettingsCommand}" AutomationProperties.Name="{Binding LabelMenuSettings}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Width="22" FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="12"
                                       VerticalAlignment="Center" Foreground="{Binding ThemeText}"/>
                            <TextBlock Text="{Binding LabelMenuSettings}" FontSize="13" Foreground="{Binding ThemeText}"/>
                        </DockPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ── Loading ── -->
        <!-- The old status label + Cancel button were removed: progress is now shown on the
             tool/plan bubbles, and Cancel folded into the send button (becomes a Stop button
             while IsLoading). Row 3 stays empty (Auto height collapses to 0). -->

        <!-- ── The last build failed: in a conversation, above the composer (the welcome screen draws its own) ── -->
        <Border Grid.Row="4" Margin="10,6,10,0" CornerRadius="10" BorderThickness="1" Padding="12,8"
                Background="{Binding ThemeErrorBg}" BorderBrush="{Binding ThemeErrorLine}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding HasBuildFailedBanner}" Value="True"/>
                                <Condition Binding="{Binding ShowWelcome}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" FontFamily="Segoe MDL2 Assets" Text="&#xE7BA;" FontSize="14"
                           Foreground="{Binding ThemeErrorText}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconBtn}" Width="28" Height="28" Content="&#xE711;" FontSize="10"
                        Margin="4,0,0,0" Foreground="{Binding ThemeErrorText}"
                        Command="{Binding DismissBuildBannerCommand}"
                        ToolTip="{Binding BuildBannerDismiss}" AutomationProperties.Name="{Binding BuildBannerDismiss}"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource LineBtn}" Margin="12,0,0,0"
                        BorderBrush="{Binding ThemeErrorLine}" Foreground="{Binding ThemeErrorText}"
                        Content="{Binding WelcomeFixThem}" Command="{Binding FixBuildBannerCommand}"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding WelcomeBuildFailed}" FontSize="13" Foreground="{Binding ThemeText}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding BuildFailedFirstError}" FontSize="11" FontFamily="Cascadia Mono, Consolas"
                               Foreground="{Binding ThemeErrorText}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BuildFailedFirstError}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── Composer: chips, the question, then attach, Chat / Agent / Plan, the context ring, send ── -->
        <Border Grid.Row="5" BorderThickness="0,1,0,0" BorderBrush="{Binding ThemeBorder}" Padding="10">
        <Border CornerRadius="12" BorderThickness="1" BorderBrush="{Binding ThemeInputBorder}" Background="{Binding ThemeSurface}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*"    />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Suggestion popups (row 0) — slash commands OR @mention, mutually exclusive -->
                <StackPanel Grid.Row="0">

                    <!-- /slash suggestions — visible only while typing /cmd (no space yet) -->
                    <Border BorderThickness="0,0,0,1" BorderBrush="{Binding ThemeBorder}"
                            Visibility="{Binding HasSlashSuggestions, Converter={StaticResource b2v}}">
                        <ListBox ItemsSource="{Binding SlashSuggestions}"
                                 MaxHeight="210"
                                 Background="Transparent" BorderThickness="0"
                                 VirtualizingPanel.IsVirtualizing="False"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding"                    Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="FocusVisualStyle"           Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding SelectCommand}"
                                            HorizontalContentAlignment="Stretch"
                                            Padding="0" FocusVisualStyle="{x:Null}"
                                            BorderThickness="0" Background="Transparent">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Padding="12,5" Background="Transparent">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding Command}"
                                                                   FontSize="12" FontWeight="SemiBold"
                                                                   FontFamily="Consolas,Courier New,monospace"
                                                                   Foreground="{Binding ThemeText}"
                                                                   MinWidth="110"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Description}"
                                                                   FontSize="11"
                                                                   Foreground="{Binding ThemeSubText}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{Binding DataContext.ThemeHoverBg, ElementName=root}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- @mention suggestions — visible only while typing @xxx -->
                    <Border BorderThickness="0,0,0,1" BorderBrush="{Binding ThemeBorder}"
                            Visibility="{Binding HasMentionSuggestions, Converter={StaticResource b2v}}">
                        <ListBox ItemsSource="{Binding MentionSuggestions}"
                                 MaxHeight="180"
                                 Background="Transparent" BorderThickness="0"
                                 VirtualizingPanel.IsVirtualizing="False"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding"                  Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="FocusVisualStyle"         Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding SelectCommand}"
                                            HorizontalContentAlignment="Stretch"
                                            Padding="0" FocusVisualStyle="{x:Null}"
                                            BorderThickness="0" Background="Transparent">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" Padding="12,5" Background="Transparent">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Label}"
                                                                   FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{Binding ThemeText}"/>
                                                        <TextBlock Text="{Binding SubLabel}"
                                                                   FontSize="10"
                                                                   Foreground="{Binding ThemeSubText}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{Binding DataContext.ThemeHoverBg, ElementName=root}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <!-- The modes: Inferpal's three, then the modes found here, then the rule that holds for all of them.
                         A row holds the conversation in that mode; the handlers close the list (IsModeMenuOpen=false). -->
                    <Border BorderThickness="0,0,0,1" BorderBrush="{Binding ThemeBorder}"
                            Visibility="{Binding IsModeMenuOpen, Converter={StaticResource b2v}}">
                        <StackPanel Margin="0,4,0,4">
                            <ItemsControl ItemsSource="{Binding OwnModeItems}" ItemTemplate="{StaticResource ModeMenuRow}"/>
                            <Border BorderThickness="0,1,0,0" BorderBrush="{Binding ThemeBorder}" Margin="0,4,0,0" Padding="12,6,12,2"
                                    Visibility="{Binding HasFoundModes, Converter={StaticResource b2v}}">
                                <TextBlock Text="{Binding ModesHeader}" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{Binding ThemeSubtleText}"/>
                            </Border>
                            <ItemsControl ItemsSource="{Binding FoundModeItems}" ItemTemplate="{StaticResource ModeMenuRow}"/>
                            <Border BorderThickness="0,1,0,0" BorderBrush="{Binding ThemeBorder}" Margin="0,4,0,0" Padding="12,6,12,2">
                                <StackPanel>
                                    <!-- No mode here: where one goes, instead of an empty section -->
                                    <TextBlock Text="{Binding ModesNone}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"
                                               Foreground="{Binding ThemeSubtleText}"
                                               Visibility="{Binding HasNoFoundModes, Converter={StaticResource b2v}}"/>
                                    <TextBlock Text="{Binding ModesFooter}" FontSize="11" TextWrapping="Wrap"
                                               Foreground="{Binding ThemeSubtleText}"/>
                                    <Button Template="{StaticResource Flat6}" Background="Transparent" BorderThickness="0"
                                            Padding="0,2" Margin="0,2,0,0" Cursor="Hand" HorizontalAlignment="Left"
                                            Command="{Binding WriteModeCommand}" AutomationProperties.Name="{Binding ModesWriteOne}">
                                        <TextBlock Text="{Binding ModesWriteOne}" FontSize="11" Foreground="{Binding ThemeAccentText}"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ＋ Add-context menu — one labelled list replacing the old row of attach glyphs.
                         Each row runs its existing command; the handlers close the menu (IsAttachMenuOpen=false). -->
                    <Border BorderThickness="0,0,0,1" BorderBrush="{Binding ThemeBorder}"
                            Visibility="{Binding IsAttachMenuOpen, Converter={StaticResource b2v}}">
                        <StackPanel>
                            <Button Command="{Binding AttachFileCommand}"
                                    HorizontalContentAlignment="Stretch" Padding="0"
                                    FocusVisualStyle="{x:Null}" BorderThickness="0" Background="Transparent">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Padding="12,6" Background="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;"
                                                           FontSize="13" Foreground="{Binding ThemeSubtleText}" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding MenuAttachFile}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{Binding ThemeText}"/>
                                                    <TextBlock Text="{Binding TooltipAttachFile}" FontSize="10"
                                                               Foreground="{Binding ThemeSubtleText}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{Binding DataContext.ThemeHoverBg, ElementName=root}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Command="{Binding AttachSelectionCommand}"
                                    HorizontalContentAlignment="Stretch" Padding="0"
                                    FocusVisualStyle="{x:Null}" BorderThickness="0" Background="Transparent">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Padding="12,6" Background="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" FontFamily="Segoe MDL2 Assets" Text="&#xE71D;"
                                                           FontSize="13" Foreground="{Binding ThemeSubtleText}" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding MenuAttachSelection}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{Binding ThemeText}"/>
                                                    <TextBlock Text="{Binding TooltipAttachSelection}" FontSize="10"
                                                               Foreground="{Binding ThemeSubtleText}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{Binding DataContext.ThemeHoverBg, ElementName=root}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Command="{Binding BrowseFileCommand}"
                                    HorizontalContentAlignment="Stretch" Padding="0"
                                    FocusVisualStyle="{x:Null}" BorderThickness="0" Background="Transparent">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Padding="12,6" Background="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" FontFamily="Segoe MDL2 Assets" Text="&#xE898;"
                                                           FontSize="13" Foreground="{Binding ThemeSubtleText}" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding MenuBrowseFile}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{Binding ThemeText}"/>
                                                    <TextBlock Text="{Binding TooltipBrowseFile}" FontSize="10"
                                                               Foreground="{Binding ThemeSubtleText}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{Binding DataContext.ThemeHoverBg, ElementName=root}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Command="{Binding PinFileCommand}"
                                    HorizontalContentAlignment="Stretch" Padding="0"
                                    FocusVisualStyle="{x:Null}" BorderThickness="0" Background="Transparent">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" Padding="12,6" Background="Transparent">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" FontFamily="Segoe MDL2 Assets" Text="&#xE718;" FontSize="13"
                                                           Foreground="{Binding ThemeSubtleText}" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding MenuPinFile}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{Binding ThemeText}"/>
                                                    <TextBlock Text="{Binding TooltipPinFile}" FontSize="10"
                                                               Foreground="{Binding ThemeSubtleText}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{Binding DataContext.ThemeHoverBg, ElementName=root}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>

                </StackPanel>

                <!-- Pinned files (gold, they stay) and attachments (they go with the next question): chips (row 1) -->
                <StackPanel Grid.Row="1" Margin="10,8,10,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasPinnedFiles}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasAttachments}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <WrapPanel>
                        <ItemsControl ItemsSource="{Binding PinnedFiles}" Visibility="{Binding HasPinnedFiles, Converter={StaticResource b2v}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,6,6" CornerRadius="6" BorderThickness="1" Height="24" Padding="8,0,2,0"
                                            Background="{Binding Background}" BorderBrush="{Binding BorderColor}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE718;" FontSize="10" VerticalAlignment="Center"
                                                       Foreground="{Binding Foreground}"/>
                                            <TextBlock Text="{Binding Label}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"
                                                       MaxWidth="180" TextTrimming="CharacterEllipsis" Foreground="{Binding Foreground}"/>
                                            <Button Template="{StaticResource Flat5}" Background="Transparent" BorderThickness="0"
                                                    Width="20" Height="20" Margin="4,0,0,0" Cursor="Hand"
                                                    Command="{Binding RemoveCommand}" AutomationProperties.Name="{Binding Label}">
                                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;" FontSize="9" Foreground="{Binding Foreground}"/>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding Attachments}" Visibility="{Binding HasAttachments, Converter={StaticResource b2v}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,6,6" CornerRadius="6" BorderThickness="1" Height="24" Padding="8,0,2,0"
                                            Background="{Binding Background}" BorderBrush="{Binding BorderColor}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A5;" FontSize="11" VerticalAlignment="Center"
                                                       Foreground="{Binding Foreground}"/>
                                            <TextBlock Text="{Binding Label}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"
                                                       MaxWidth="180" TextTrimming="CharacterEllipsis" Foreground="{Binding Foreground}"/>
                                            <!-- Pin: only when the chip has a file behind it -->
                                            <Button Template="{StaticResource Flat5}" Background="Transparent" BorderThickness="0"
                                                    Width="20" Height="20" Margin="4,0,0,0" Cursor="Hand"
                                                    Command="{Binding PinCommand}"
                                                    Visibility="{Binding CanPin, Converter={StaticResource b2v}}"
                                                    ToolTip="{Binding DataContext.TooltipPinChip, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    AutomationProperties.Name="{Binding DataContext.TooltipPinChip, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE718;" FontSize="10" Foreground="{Binding Foreground}"/>
                                            </Button>
                                            <Button Template="{StaticResource Flat5}" Background="Transparent" BorderThickness="0"
                                                    Width="20" Height="20" Margin="2,0,0,0" Cursor="Hand"
                                                    Command="{Binding RemoveCommand}" AutomationProperties.Name="{Binding Label}">
                                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;" FontSize="9" Foreground="{Binding Foreground}"/>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </WrapPanel>
                    <!-- The messages sent after the turn (Ctrl+Enter, or a note no step can read), in order, each removable -->
                    <StackPanel Visibility="{Binding HasQueuedMessages, Converter={StaticResource b2v}}" Margin="0,0,0,4">
                        <TextBlock Text="{Binding QueueTitle}" FontSize="11" Foreground="{Binding ThemeSubtleText}" Margin="0,0,0,2"/>
                        <ItemsControl ItemsSource="{Binding QueuedMessages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Text}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                   ToolTip="{Binding Text}"
                                                   Foreground="{Binding DataContext.ThemeText, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                        <Button Grid.Column="1" Template="{StaticResource Flat5}" Background="Transparent" BorderThickness="0"
                                                Width="20" Height="20" Margin="4,0,0,0" Cursor="Hand"
                                                Command="{Binding RemoveCommand}"
                                                ToolTip="{Binding DataContext.QueueRemoveLabel, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                AutomationProperties.Name="{Binding DataContext.QueueRemoveLabel, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE711;" FontSize="9"
                                                       Foreground="{Binding DataContext.ThemeSubtleText, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>

                <!-- The question (row 2): its placeholder shows through while it is empty -->
                <Grid Grid.Row="2" Margin="10,8,10,0">
                    <TextBlock Text="{Binding ComposerPlaceholder}" Foreground="{Binding ThemeSubtleText}" FontSize="13"
                               IsHitTestVisible="False" Margin="2,1,0,0" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Prompt}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBox Text="{Binding Prompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="40" MaxHeight="150"
                             VerticalScrollBarVisibility="Auto"
                             BorderThickness="0" Background="Transparent" Padding="0"
                             Foreground="{Binding ThemeText}" CaretBrush="{Binding ThemeText}"
                             FontSize="13"
                             AutomationProperties.Name="{Binding ComposerPlaceholder}">
                        <TextBox.InputBindings>
                            <!-- Plain Enter → send (or, while an approval card waits, Allow once; during a turn, a note for
                                 it — never Stop); KeyBinding marks the event Handled before AcceptsReturn runs. Shift+Enter
                                 falls through: a new line. Ctrl+Enter during a turn: sent once the turn ends. -->
                            <KeyBinding Key="Return" Command="{Binding SendCommand}"/>
                            <KeyBinding Key="Return" Modifiers="Control" Command="{Binding QueueCommand}"/>
                            <!-- Esc: Deny, while an approval card waits -->
                            <KeyBinding Key="Escape" Command="{Binding DenyApprovalCommand}"/>
                            <!-- History: only fires when IsEnabled=true (single-line prompt). When IsEnabled=false,
                                 CanExecute returns false → the event reaches the TextBox → normal cursor movement. -->
                            <KeyBinding Key="Up"   Modifiers="Shift" Command="{Binding HistoryUpCommand}"/>
                            <KeyBinding Key="Down" Modifiers="Shift" Command="{Binding HistoryDownCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                </Grid>

                <!-- The toolbar (row 3): attach, Chat / Agent / Plan, the context ring, send or stop -->
                <Grid Grid.Row="3" Margin="10,6,10,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Attach: one menu (file, selection, browse, pin) above the question -->
                    <Button Grid.Column="0" Template="{StaticResource Flat6}" Width="30" Height="30" BorderThickness="1"
                            Background="Transparent" Cursor="Hand"
                            Command="{Binding ToggleAttachMenuCommand}"
                            ToolTip="{Binding TooltipAttach}" AutomationProperties.Name="{Binding TooltipAttach}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="BorderBrush" Value="{Binding ThemeBorder}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAttachMenuOpen}" Value="True">
                                        <Setter Property="BorderBrush" Value="{Binding ThemeAccent}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE710;" FontSize="13" Foreground="{Binding ThemeText}"/>
                    </Button>

                    <!-- Chat / Agent / Plan: one switch for what the turn may do -->
                    <Border Grid.Column="1" Margin="8,0,0,0" Height="30" Padding="2" CornerRadius="7" BorderThickness="1"
                            Background="{Binding ThemeWindowBg}" BorderBrush="{Binding ThemeBorder}">
                        <StackPanel Orientation="Horizontal">
                            <Button Template="{StaticResource Flat5}" Padding="10,0" BorderThickness="1" Cursor="Hand"
                                    Command="{Binding SetModeCommand}" CommandParameter="chat"
                                    ToolTip="{Binding TipModeChat}" AutomationProperties.Name="{Binding LabelModeChat}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{Binding ThemeSubtleText}"/>
                                        <Setter Property="FontWeight" Value="Normal"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ChatMode}" Value="chat">
                                                <Setter Property="Background" Value="{Binding ThemeChip}"/>
                                                <Setter Property="BorderBrush" Value="{Binding ThemeChipLine}"/>
                                                <Setter Property="Foreground" Value="{Binding ThemeText}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="{Binding LabelModeChat}" FontSize="13" VerticalAlignment="Center"/>
                            </Button>
                            <Button Template="{StaticResource Flat5}" Padding="10,0" BorderThickness="1" Cursor="Hand"
                                    Command="{Binding SetModeCommand}" CommandParameter="agent"
                                    ToolTip="{Binding TipModeAgent}" AutomationProperties.Name="{Binding LabelModeAgent}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{Binding ThemeSubtleText}"/>
                                        <Setter Property="FontWeight" Value="Normal"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ChatMode}" Value="agent">
                                                <Setter Property="Background" Value="{Binding ThemeChip}"/>
                                                <Setter Property="BorderBrush" Value="{Binding ThemeChipLine}"/>
                                                <Setter Property="Foreground" Value="{Binding ThemeText}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="{Binding LabelModeAgent}" FontSize="13" VerticalAlignment="Center"/>
                            </Button>
                            <Button Template="{StaticResource Flat5}" Padding="10,0" BorderThickness="1" Cursor="Hand"
                                    Command="{Binding SetModeCommand}" CommandParameter="plan"
                                    ToolTip="{Binding TipModePlan}" AutomationProperties.Name="{Binding LabelModePlan}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{Binding ThemeSubtleText}"/>
                                        <Setter Property="FontWeight" Value="Normal"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ChatMode}" Value="plan">
                                                <Setter Property="Background" Value="{Binding ThemeChip}"/>
                                                <Setter Property="BorderBrush" Value="{Binding ThemeChipLine}"/>
                                                <Setter Property="Foreground" Value="{Binding ThemeText}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="{Binding LabelModePlan}" FontSize="13" VerticalAlignment="Center"/>
                            </Button>
                            <!-- The fourth segment: the mode held (its name), or "Modes", opening the list of the modes found
                                 here — always shown: without a mode, the list says where one goes -->
                            <Button Template="{StaticResource Flat5}" Padding="10,0" BorderThickness="1" Cursor="Hand"
                                    Command="{Binding ToggleModeMenuCommand}"
                                    ToolTip="{Binding ModesSegmentTip}" AutomationProperties.Name="{Binding ModesSegmentLabel}"
                                    AutomationProperties.HelpText="{Binding ModesSegmentTip}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{Binding ThemeSubtleText}"/>
                                        <Setter Property="FontWeight" Value="Normal"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ChatMode}" Value="found">
                                                <Setter Property="Background" Value="{Binding ThemeChip}"/>
                                                <Setter Property="BorderBrush" Value="{Binding ThemeChipLine}"/>
                                                <Setter Property="Foreground" Value="{Binding ThemeText}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ModesSegmentLabel}" FontSize="13" VerticalAlignment="Center"
                                               MaxWidth="120" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70E;" FontSize="9" Margin="5,1,0,0"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- How full the next question's window is; it opens the X-Ray -->
                    <Button Grid.Column="3" Template="{StaticResource Flat6}" Background="Transparent" BorderThickness="0"
                            Padding="4,2" Margin="0,0,8,0" Cursor="Hand" VerticalAlignment="Center"
                            Command="{Binding ToggleXrayPanelCommand}"
                            ToolTip="{Binding ContextRingTip}" AutomationProperties.Name="{Binding ContextRingTip}"
                            Visibility="{Binding HasContextBudget, Converter={StaticResource b2v}}">
                        <StackPanel Orientation="Horizontal">
                            <Canvas Width="18" Height="18" VerticalAlignment="Center">
                                <Ellipse Canvas.Left="2" Canvas.Top="2" Width="14" Height="14" StrokeThickness="3"
                                         Stroke="{Binding ThemeBorder}"/>
                                <Path Data="{Binding ContextRingPath}" StrokeThickness="3" Stroke="{Binding ContextRingColor}"/>
                            </Canvas>
                            <TextBlock Text="{Binding ContextRingText}" FontSize="11" Foreground="{Binding ThemeSubtleText}"
                                       Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Send; while a turn runs, Stop -->
                    <Button Grid.Column="4" Template="{StaticResource FlatRound}" Width="32" Height="32" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{Binding ThemeAccent}"/>
                                <Setter Property="Command" Value="{Binding SendCommand}"/>
                                <Setter Property="ToolTip" Value="{Binding BtnSend}"/>
                                <Setter Property="AutomationProperties.Name" Value="{Binding BtnSend}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowRetryButton}" Value="True">
                                        <Setter Property="Background" Value="{Binding SendButtonColor}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                        <Setter Property="Background" Value="{Binding ThemeText}"/>
                                        <Setter Property="Command" Value="{Binding CancelCommand}"/>
                                        <Setter Property="ToolTip" Value="{Binding BtnCancel}"/>
                                        <Setter Property="AutomationProperties.Name" Value="{Binding BtnCancel}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#xE74A;"/>
                                    <Setter Property="Foreground" Value="{Binding ThemeOnAccent}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                            <Setter Property="Text" Value="&#xE71A;"/>
                                            <Setter Property="Foreground" Value="{Binding ThemeWindowBg}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                </Grid>
            </Grid>
        </Border>
        </Border>

        <!-- ── A file dragged over the window: shown, named and hidden by the in-process ChatDropTarget (its Tags), which
             takes the drop; the texts are the view model's, in the interface language. Collapsed and never bound: a
             binding would put it back. ── -->
        <Grid Grid.Row="0" Grid.RowSpan="6" Tag="InferpalDropOverlay" Visibility="Collapsed"
              Background="{Binding ThemeWindowBg}">
            <Rectangle Margin="6" RadiusX="10" RadiusY="10" StrokeThickness="2" StrokeDashArray="4 3"
                       Stroke="{Binding ThemeAccentText}"/>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE723;" FontSize="30" HorizontalAlignment="Center"
                           Foreground="{Binding ThemeAccentText}"/>
                <TextBlock Text="{Binding LabelDropToAttach}" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,0"
                           HorizontalAlignment="Center" Foreground="{Binding ThemeText}"/>
                <Border Background="{Binding ThemeChip}" CornerRadius="6" Padding="10,4" Margin="0,12,0,0"
                        HorizontalAlignment="Center">
                    <TextBlock Tag="InferpalDropName" FontSize="12" MaxWidth="320" TextTrimming="CharacterEllipsis"
                               Foreground="{Binding ThemeText}"/>
                </Border>
                <TextBlock Text="{Binding LabelDropHint}" FontSize="12" MaxWidth="300" Margin="0,12,0,0"
                           TextWrapping="Wrap" TextAlignment="Center" Foreground="{Binding ThemeSubtleText}"/>
            </StackPanel>
        </Grid>
    </Grid>

</DataTemplate>
