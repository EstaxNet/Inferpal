<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:vs="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0">

    <DataTemplate.Resources>
        <BooleanToVisibilityConverter x:Key="b2v" />
        <Style TargetType="Button" BasedOn="{StaticResource {x:Static vs:VsResourceKeys.ButtonStyleKey}}">
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="Margin"   Value="8,0,0,0" />
            <Setter Property="Padding"  Value="10,3" />
        </Style>
    </DataTemplate.Resources>

    <Grid MinWidth="540" MaxWidth="760" Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Localized approval message (tool + human-readable summary) -->
        <TextBlock Grid.Row="0"
                   Text="{Binding Message}"
                   Foreground="{Binding ThemeText}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,8" />

        <!-- Colored diff preview: green-background additions, red-background deletions -->
        <Border Grid.Row="1"
                BorderBrush="{Binding ThemeBorder}" BorderThickness="1" CornerRadius="3"
                Background="{Binding ThemeCodeBg}"
                Visibility="{Binding HasDiff, Converter={StaticResource b2v}}"
                Margin="0,0,0,10">
            <ScrollViewer MaxHeight="420"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          Padding="4,3">
                <ItemsControl ItemsSource="{Binding DiffLines}"
                              FontFamily="Consolas, Courier New" FontSize="12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Background="{Binding Background}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Prefix}"
                                           Foreground="{Binding Foreground}"
                                           Padding="2,0" FontWeight="Bold" />
                                <TextBlock Grid.Column="1" Text="{Binding Text}"
                                           Foreground="{Binding Foreground}"
                                           TextWrapping="NoWrap" Padding="2,0" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Deny (safe, left) — Always allow — Allow once (default, right) -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{Binding BtnDeny}"        Command="{Binding DenyCommand}"        IsCancel="True" />
            <Button Content="{Binding BtnAlwaysAllow}" Command="{Binding AlwaysAllowCommand}" />
            <Button Content="{Binding BtnAllowOnce}"   Command="{Binding AllowOnceCommand}"   IsDefault="True" />
        </StackPanel>
    </Grid>
</DataTemplate>
