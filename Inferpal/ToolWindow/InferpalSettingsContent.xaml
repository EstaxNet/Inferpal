<DataTemplate xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:vs="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0">

    <!-- The settings window: the seven pages of the Core settings schema (the VS Code panel renders the
         same ones), a side navigation with search, a hint under each field, and a footer that counts the
         unsaved changes. -->
    <DataTemplate.Resources>
        <BooleanToVisibilityConverter x:Key="b2v" />
        <Style TargetType="Button"   BasedOn="{StaticResource {x:Static vs:VsResourceKeys.ButtonStyleKey}}" />
        <Style TargetType="TextBox"  BasedOn="{StaticResource {x:Static vs:VsResourceKeys.TextBoxStyleKey}}" />
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Static vs:VsResourceKeys.ComboBoxStyleKey}}" />

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{Binding TextForeground}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{Binding TextForeground}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,6,0,8"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{Binding TextForeground}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{Binding SubtleForeground}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="Unit" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{Binding SubtleForeground}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,8,0"/>
        </Style>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Padding="10,7"
                                Background="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="tx" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                   Foreground="{Binding LinkForeground}" VerticalAlignment="Center"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tx" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- An optional model's empty entry says what does the work then: the combo's Tag carries those words. -->
        <DataTemplate x:Key="OptionalModelItem">
            <Grid>
                <TextBlock x:Name="name" Text="{Binding}"/>
                <TextBlock x:Name="empty" Visibility="Collapsed"
                           Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="">
                    <Setter TargetName="name" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="empty" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="BorderBrush" Value="{Binding McpRowBorder}"/>
            <Setter Property="Background" Value="{Binding McpRowBackground}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,11"/>
        </Style>
        <!-- A choice drawn as a card: its name (Tag) beside a radio mark, its sentence (Content) under it. -->
        <Style x:Key="ChoiceCard" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" BorderThickness="1" CornerRadius="8" Padding="12,9"
                                BorderBrush="{Binding McpRowBorder}" Background="{Binding McpRowBackground}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Ellipse x:Name="ring" Stroke="{Binding SubtleForeground}" StrokeThickness="1.5"/>
                                        <Ellipse x:Name="mark" Width="7" Height="7" Fill="{Binding LinkForeground}" Visibility="Collapsed"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontWeight="SemiBold"
                                               Foreground="{Binding TextForeground}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <ContentPresenter Margin="22,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{Binding LinkForeground}"/>
                                <Setter TargetName="ring" Property="Stroke" Value="{Binding LinkForeground}"/>
                                <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </DataTemplate.Resources>

    <Grid x:Name="root">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══ Navigation ══════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Grid.Column="0" Background="{Binding NavPaneBg}"
                BorderBrush="{Binding NavLineBrush}" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="10,14,10,10">
                    <Grid Margin="0,0,0,10">
                        <TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="22,4,4,4" VerticalContentAlignment="Center"
                                 AutomationProperties.Name="{Binding SearchPlaceholder}"/>
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE721;" FontSize="11" Margin="8,0,0,0"
                                   VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{Binding SubtleForeground}"/>
                        <TextBlock Text="{Binding SearchPlaceholder}" Margin="25,0,0,0" VerticalAlignment="Center"
                                   IsHitTestVisible="False" Foreground="{Binding SubtleForeground}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Button Style="{StaticResource NavButton}" Tag="{Binding NavServerBg}" Command="{Binding SelectPageServerCommand}"
                            Visibility="{Binding NavServerVisible, Converter={StaticResource b2v}}">
                        <TextBlock Text="{Binding LabelPageServer}" Foreground="{Binding TextForeground}" TextWrapping="Wrap"/>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Tag="{Binding NavAgentBg}" Command="{Binding SelectPageAgentCommand}"
                            Visibility="{Binding NavAgentVisible, Converter={StaticResource b2v}}">
                        <TextBlock Text="{Binding LabelPageAgent}" Foreground="{Binding TextForeground}" TextWrapping="Wrap"/>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Tag="{Binding NavContextBg}" Command="{Binding SelectPageContextCommand}"
                            Visibility="{Binding NavContextVisible, Converter={StaticResource b2v}}">
                        <TextBlock Text="{Binding LabelPageContext}" Foreground="{Binding TextForeground}" TextWrapping="Wrap"/>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Tag="{Binding NavSearchBg}" Command="{Binding SelectPageSearchCommand}"
                            Visibility="{Binding NavSearchVisible, Converter={StaticResource b2v}}">
                        <TextBlock Text="{Binding LabelPageSearch}" Foreground="{Binding TextForeground}" TextWrapping="Wrap"/>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Tag="{Binding NavAutocompleteBg}" Command="{Binding SelectPageAutocompleteCommand}"
                            Visibility="{Binding NavAutocompleteVisible, Converter={StaticResource b2v}}">
                        <TextBlock Text="{Binding LabelPageAutocomplete}" Foreground="{Binding TextForeground}" TextWrapping="Wrap"/>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Tag="{Binding NavToolsBg}" Command="{Binding SelectPageToolsCommand}"
                            Visibility="{Binding NavToolsVisible, Converter={StaticResource b2v}}">
                        <TextBlock Text="{Binding LabelPageTools}" Foreground="{Binding TextForeground}" TextWrapping="Wrap"/>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Tag="{Binding NavAppearanceBg}" Command="{Binding SelectPageAppearanceCommand}"
                            Visibility="{Binding NavAppearanceVisible, Converter={StaticResource b2v}}">
                        <TextBlock Text="{Binding LabelPageAppearance}" Foreground="{Binding TextForeground}" TextWrapping="Wrap"/>
                    </Button>
                    <TextBlock Text="{Binding LabelSearchNoMatch}" Style="{StaticResource Hint}" Margin="10,8,0,0"
                               Visibility="{Binding SearchNoMatch, Converter={StaticResource b2v}}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ══ Pages ═══════════════════════════════════════════════════════ -->
        <ScrollViewer Grid.Row="0" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="26,20,20,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="720"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" MinWidth="300">

            <TextBlock Text="{Binding CurrentPageTitle}" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="{Binding CurrentPageDesc}" Style="{StaticResource Hint}" FontSize="12.5" Margin="0,4,0,20"/>

            <!-- ── Server and models ──────────────────────────────────────── -->
            <StackPanel Visibility="{Binding PageServerVisible, Converter={StaticResource b2v}}">
                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="{Binding LabelUrl}" Style="{StaticResource FieldLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" FontFamily="Cascadia Mono, Consolas" VerticalContentAlignment="Center"
                                 Text="{Binding BaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="{Binding LabelUrl}"/>
                        <Button Grid.Column="1" Content="{Binding BtnTest}" Command="{Binding TestConnectionCommand}"
                                Padding="12,4" Margin="8,0,0,0"/>
                    </Grid>
                    <TextBlock Text="{Binding ConnectionStatus}" Foreground="{Binding TextForeground}" TextWrapping="Wrap" Margin="0,5,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding HintUrl}" Style="{StaticResource Hint}"/>
                </StackPanel>

                <UniformGrid Columns="2" Margin="0,0,0,6">
                    <StackPanel Margin="0,0,16,16">
                        <TextBlock Text="{Binding LabelChatModel}" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableModels}"
                                      SelectedItem="{Binding SelectedModel, Mode=TwoWay}" IsEditable="False"
                                      AutomationProperties.Name="{Binding LabelChatModel}"/>
                            <Button FontFamily="Segoe MDL2 Assets" Grid.Column="1" Content="&#xE72C;"
                                    Command="{Binding RefreshModelsCommand}" Padding="8,4" Margin="6,0,0,0"
                                    ToolTip="{Binding TooltipRefreshModels}" AutomationProperties.Name="{Binding TooltipRefreshModels}"/>
                        </Grid>
                        <TextBlock Text="{Binding HintChatModel}" Style="{StaticResource Hint}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,16" Visibility="{Binding ShowInlineCompletions, Converter={StaticResource b2v}}">
                        <TextBlock Text="{Binding LabelInlineCompletionModel}" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding AvailableOptionalModels}"
                                  SelectedItem="{Binding InlineCompletionModel, Mode=TwoWay}" IsEditable="False"
                                  ItemTemplate="{StaticResource OptionalModelItem}" Tag="{Binding EmptySameAsChat}"
                                  AutomationProperties.Name="{Binding LabelInlineCompletionModel}"/>
                        <TextBlock Text="{Binding HintInlineCompletionModel}" Style="{StaticResource Hint}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,16">
                        <TextBlock Text="{Binding LabelRagEmbeddingModel}" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding AvailableEmbeddingModels}"
                                  SelectedItem="{Binding RagEmbeddingModel, Mode=TwoWay}" IsEditable="False"
                                  ItemTemplate="{StaticResource OptionalModelItem}" Tag="{Binding EmptyAutomatic}"
                                  AutomationProperties.Name="{Binding LabelRagEmbeddingModel}"/>
                        <TextBlock Text="{Binding HintRagEmbeddingModel}" Style="{StaticResource Hint}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,16">
                        <TextBlock Text="{Binding LabelContextWindowSize}" Style="{StaticResource FieldLabel}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding ContextWindowSizeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Width="90" MaxLength="7" TextAlignment="Right" AutomationProperties.Name="{Binding LabelContextWindowSize}"/>
                            <TextBlock Text="{Binding UnitTokens}" Style="{StaticResource Unit}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding HintContextWindowSize}" Style="{StaticResource Hint}"/>
                    </StackPanel>
                </UniformGrid>

                <!-- Suggest the best models: proposed into the form as unsaved changes, never saved here. -->
                <StackPanel Margin="0,0,0,18">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{Binding BtnSuggestModels}" Command="{Binding SuggestModelsCommand}"
                                IsEnabled="{Binding NotSuggesting}" Padding="12,4"
                                AutomationProperties.Name="{Binding BtnSuggestModels}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding HintSuggestModels}" Style="{StaticResource Hint}"/>
                    <StackPanel Margin="0,6,0,0" Visibility="{Binding HasSuggestion, Converter={StaticResource b2v}}">
                        <ItemsControl ItemsSource="{Binding SuggestionLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1"
                                               Foreground="{Binding DataContext.TextForeground, ElementName=root}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding SuggestionNotes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1"
                                               Foreground="{Binding DataContext.WarningForeground, ElementName=root}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding SuggestionSummary}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Foreground="{Binding TextForeground}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Loaded now: what the server holds in memory, what each model is used for, and the unload buttons. -->
                <TextBlock Text="{Binding LabelLoadedModels}" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding LoadedModelsSummary}" FontWeight="SemiBold" TextWrapping="Wrap"
                               VerticalAlignment="Center" Foreground="{Binding TextForeground}"/>
                    <Button Grid.Column="1" FontFamily="Segoe MDL2 Assets" Content="&#xE72C;" Command="{Binding RefreshLoadedCommand}"
                            ToolTip="{Binding BtnRefreshLoaded}" AutomationProperties.Name="{Binding BtnRefreshLoaded}"
                            Padding="8,4" Margin="6,0,0,0"/>
                    <Button Grid.Column="2" Content="{Binding BtnUnloadAll}" Command="{Binding UnloadAllCommand}"
                            Visibility="{Binding CanUnloadAll, Converter={StaticResource b2v}}" Padding="12,4" Margin="6,0,0,0"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding LoadedModelRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding DataContext.McpRowBackground, ElementName=root}"
                                    BorderBrush="{Binding DataContext.McpRowBorder, ElementName=root}" BorderThickness="1"
                                    CornerRadius="8" Padding="10,6" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontFamily="Cascadia Mono, Consolas" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{Binding DataContext.TextForeground, ElementName=root}"/>
                                        <TextBlock Text="{Binding Uses}" TextWrapping="Wrap"
                                                   Foreground="{Binding DataContext.SubtleForeground, ElementName=root}"/>
                                        <TextBlock Text="{Binding Details}" TextWrapping="Wrap"
                                                   Visibility="{Binding HasDetails, Converter={StaticResource b2v}}"
                                                   Foreground="{Binding DataContext.SubtleForeground, ElementName=root}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{Binding DataContext.BtnUnloadModel, ElementName=root}"
                                            Command="{Binding UnloadCommand}" AutomationProperties.Name="{Binding DataContext.BtnUnloadModel, ElementName=root}"
                                            Visibility="{Binding CanUnload, Converter={StaticResource b2v}}"
                                            Padding="10,3" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding LoadedModelsMessage}" TextWrapping="Wrap" Margin="0,0,0,4"
                           Foreground="{Binding WarningForeground}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding NoteLoadedModels}" Style="{StaticResource Hint}" Margin="0,0,0,18"/>

                <Border BorderBrush="{Binding NavLineBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,0,0,16">
                    <CheckBox IsChecked="{Binding ShowAdvanced, Mode=TwoWay}" Foreground="{Binding TextForeground}">
                        <TextBlock Text="{Binding LabelShowAdvanced}" Foreground="{Binding TextForeground}" TextWrapping="Wrap"/>
                    </CheckBox>
                </Border>

                <!-- The fold: it only shows or hides, it never writes a value. -->
                <StackPanel Visibility="{Binding ShowAdvanced, Converter={StaticResource b2v}}">
                    <TextBlock Text="{Binding LabelSectionModelPerTask}" Style="{StaticResource SectionTitle}" Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding DescSectionModelPerTask}" Style="{StaticResource Hint}" Margin="0,0,0,12"/>
                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,16,16">
                            <TextBlock Text="{Binding LabelAgentModel}" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding AvailableOptionalModels}" SelectedItem="{Binding AgentModel, Mode=TwoWay}"
                                      ItemTemplate="{StaticResource OptionalModelItem}" Tag="{Binding EmptySameAsChat}"
                                      IsEditable="False" AutomationProperties.Name="{Binding LabelAgentModel}"/>
                            <TextBlock Text="{Binding HintAgentModel}" Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,16">
                            <TextBlock Text="{Binding LabelCodeActionsModel}" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding AvailableOptionalModels}" SelectedItem="{Binding CodeActionsModel, Mode=TwoWay}"
                                      ItemTemplate="{StaticResource OptionalModelItem}" Tag="{Binding EmptySameAsChat}"
                                      IsEditable="False" AutomationProperties.Name="{Binding LabelCodeActionsModel}"/>
                            <TextBlock Text="{Binding HintCodeActionsModel}" Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,16">
                            <TextBlock Text="{Binding LabelInlineEditModel}" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding AvailableOptionalModels}" SelectedItem="{Binding InlineEditModel, Mode=TwoWay}"
                                      ItemTemplate="{StaticResource OptionalModelItem}" Tag="{Binding EmptySameAsCodeActions}"
                                      IsEditable="False" AutomationProperties.Name="{Binding LabelInlineEditModel}"/>
                            <TextBlock Text="{Binding HintInlineEditModel}" Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,16">
                            <TextBlock Text="{Binding LabelUtilityModel}" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding AvailableOptionalModels}" SelectedItem="{Binding UtilityModel, Mode=TwoWay}"
                                      ItemTemplate="{StaticResource OptionalModelItem}" Tag="{Binding EmptySameAsChat}"
                                      IsEditable="False" AutomationProperties.Name="{Binding LabelUtilityModel}"/>
                            <TextBlock Text="{Binding HintUtilityModel}" Style="{StaticResource Hint}"/>
                        </StackPanel>
                    </UniformGrid>
                    <CheckBox IsChecked="{Binding ModelRouterAuto, Mode=TwoWay}" Margin="0,0,0,18" VerticalContentAlignment="Top">
                        <StackPanel Margin="4,0,0,0">
                            <TextBlock Text="{Binding LabelModelRouterAuto}" Style="{StaticResource FieldLabel}" Margin="0"/>
                            <TextBlock Text="{Binding HintModelRouterAuto}" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </CheckBox>

                    <TextBlock Text="{Binding LabelSectionSampling}" Style="{StaticResource SectionTitle}"/>
                    <CheckBox IsChecked="{Binding UseRecommendedSampling, Mode=TwoWay}" Margin="0,0,0,18" VerticalContentAlignment="Top">
                        <StackPanel Margin="4,0,0,0">
                            <TextBlock Text="{Binding LabelUseRecommendedSampling}" Style="{StaticResource FieldLabel}" Margin="0"/>
                            <TextBlock Text="{Binding HintUseRecommendedSampling}" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </CheckBox>

                    <TextBlock Text="{Binding LabelSectionGpu}" Style="{StaticResource SectionTitle}"/>
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="{Binding LabelVramBudget}" Style="{StaticResource FieldLabel}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding VramBudgetText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Width="70" MaxLength="6" TextAlignment="Right" AutomationProperties.Name="{Binding LabelVramBudget}"/>
                            <TextBlock Text="{Binding UnitGigabytes}" Style="{StaticResource Unit}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding HintVramBudget}" Style="{StaticResource Hint}"/>
                    </StackPanel>
                    <StackPanel Visibility="{Binding ShowKeepAliveSettings, Converter={StaticResource b2v}}" Margin="0,0,0,18">
                        <CheckBox IsChecked="{Binding ModelAutoUnloadEnabled, Mode=TwoWay}" Margin="0,0,0,8" VerticalContentAlignment="Top">
                            <StackPanel Margin="4,0,0,0">
                                <TextBlock Text="{Binding LabelModelAutoUnload}" Style="{StaticResource FieldLabel}" Margin="0"/>
                                <TextBlock Text="{Binding HintModelAutoUnload}" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </CheckBox>
                        <TextBlock Text="{Binding LabelModelIdleTimeout}" Style="{StaticResource FieldLabel}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding ModelIdleTimeoutText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Width="60" MaxLength="3" TextAlignment="Right" AutomationProperties.Name="{Binding LabelModelIdleTimeout}"/>
                            <TextBlock Text="{Binding UnitMinutes}" Style="{StaticResource Unit}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding HintModelIdleTimeout}" Style="{StaticResource Hint}"/>
                    </StackPanel>

                    <TextBlock Text="{Binding LabelSectionConnection}" Style="{StaticResource SectionTitle}"/>
                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,16,16">
                            <TextBlock Text="{Binding LabelProvider}" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding AvailableProviders}" SelectedItem="{Binding SelectedProvider, Mode=TwoWay}"
                                      IsEditable="False" AutomationProperties.Name="{Binding LabelProvider}"/>
                            <TextBlock Text="{Binding HintProvider}" Style="{StaticResource Hint}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,16,16">
                            <TextBlock Text="{Binding LabelApiKey}" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="{Binding LabelApiKey}"/>
                            <TextBlock Text="{Binding HintApiKey}" Style="{StaticResource Hint}"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </StackPanel>

            <!-- ── Agent and approvals ────────────────────────────────────── -->
            <StackPanel Visibility="{Binding PageAgentVisible, Converter={StaticResource b2v}}">
                <TextBlock Text="{Binding LabelSectionHowItWorks}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                <CheckBox IsChecked="{Binding AgentModeEnabled, Mode=TwoWay}" Margin="0,0,0,12" VerticalContentAlignment="Top">
                    <StackPanel Margin="4,0,0,0">
                        <TextBlock Text="{Binding LabelAgentModeEnabled}" Style="{StaticResource FieldLabel}" Margin="0"/>
                        <TextBlock Text="{Binding HintAgentModeEnabled}" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                    </StackPanel>
                </CheckBox>
                <CheckBox IsChecked="{Binding SmartFixEnabled, Mode=TwoWay}" Margin="0,0,0,12" VerticalContentAlignment="Top">
                    <StackPanel Margin="4,0,0,0">
                        <TextBlock Text="{Binding LabelSmartFixEnabled}" Style="{StaticResource FieldLabel}" Margin="0"/>
                        <TextBlock Text="{Binding HintSmartFixEnabled}" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                    </StackPanel>
                </CheckBox>
                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="{Binding LabelAgentMaxIterations}" Style="{StaticResource FieldLabel}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Text="{Binding AgentMaxIterationsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Width="60" MaxLength="4" TextAlignment="Right" AutomationProperties.Name="{Binding LabelAgentMaxIterations}"/>
                        <TextBlock Text="{Binding UnitIterations}" Style="{StaticResource Unit}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding HintAgentMaxIterations}" Style="{StaticResource Hint}"/>
                </StackPanel>

                <Border BorderBrush="{Binding NavLineBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,0,0,8">
                    <TextBlock Text="{Binding LabelSectionApprovals}" Style="{StaticResource SectionTitle}" Margin="0"/>
                </Border>
                <CheckBox IsChecked="{Binding AskBeforeActions, Mode=TwoWay}" Margin="0,0,0,12" VerticalContentAlignment="Top">
                    <StackPanel Margin="4,0,0,0">
                        <TextBlock Text="{Binding LabelAskBeforeActions}" Style="{StaticResource FieldLabel}" Margin="0"/>
                        <TextBlock Text="{Binding HintAskBeforeActions}" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                    </StackPanel>
                </CheckBox>
                <Border Style="{StaticResource Card}" Padding="12,9" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" FontFamily="Segoe MDL2 Assets" Text="&#xE8FD;" FontSize="16"
                                   Foreground="{Binding LinkForeground}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ApprovalRulesSummary}" Foreground="{Binding TextForeground}" FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding ApprovalRulesFrom}" Style="{StaticResource Hint}" Margin="0,1,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource LinkButton}" Content="{Binding LabelEditRules}"
                                Command="{Binding EditRulesCommand}" Margin="12,0,0,0"/>
                    </Grid>
                </Border>

                <Border BorderBrush="{Binding NavLineBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,0,0,8">
                    <TextBlock Text="{Binding LabelSectionInstructions}" Style="{StaticResource SectionTitle}" Margin="0"/>
                </Border>
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="{Binding LabelCustomSystemPrompt}" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding CustomSystemPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="76" VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="{Binding LabelCustomSystemPrompt}"/>
                    <TextBlock Text="{Binding HintCustomSystemPrompt}" Style="{StaticResource Hint}"/>
                </StackPanel>
                <CheckBox IsChecked="{Binding PersonaAutoSwitch, Mode=TwoWay}" Margin="0,0,0,20" VerticalContentAlignment="Top">
                    <StackPanel Margin="4,0,0,0">
                        <TextBlock Text="{Binding LabelPersonaAutoSwitch}" Style="{StaticResource FieldLabel}" Margin="0"/>
                        <TextBlock Text="{Binding HintPersonaAutoSwitch}" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                    </StackPanel>
                </CheckBox>

                <!-- Time limits: folded, opened on demand -->
                <Border BorderBrush="{Binding NavLineBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                    <Button Command="{Binding ToggleTimeLimitsCommand}" Cursor="Hand" HorizontalAlignment="Left"
                            AutomationProperties.Name="{Binding LabelSectionTimeLimits}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <StackPanel Orientation="Horizontal" Background="Transparent">
                                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="10" VerticalAlignment="Center" Margin="0,0,8,0"
                                               Foreground="{Binding TextForeground}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="&#xE970;"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TimeLimitsExpanded}" Value="True">
                                                        <Setter Property="Text" Value="&#xE96E;"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding LabelSectionTimeLimits}" Style="{StaticResource SectionTitle}" Margin="0"/>
                                </StackPanel>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Border>
                <StackPanel Visibility="{Binding TimeLimitsExpanded, Converter={StaticResource b2v}}" Margin="0,12,0,0">
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="{Binding LabelCommandTimeout}" Style="{StaticResource FieldLabel}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding CommandTimeoutText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Width="70" MaxLength="6" TextAlignment="Right" AutomationProperties.Name="{Binding LabelCommandTimeout}"/>
                            <TextBlock Text="{Binding UnitSeconds}" Style="{StaticResource Unit}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding HintCommandTimeout}" Style="{StaticResource Hint}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="{Binding LabelTaskTimeoutQuick}" Style="{StaticResource FieldLabel}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding QuickTimeoutText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Width="70" MaxLength="6" TextAlignment="Right" AutomationProperties.Name="{Binding LabelTaskTimeoutQuick}"/>
                            <TextBlock Text="{Binding UnitSeconds}" Style="{StaticResource Unit}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding HintTaskTimeoutQuick}" Style="{StaticResource Hint}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="{Binding LabelTaskTimeoutNormal}" Style="{StaticResource FieldLabel}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding NormalTimeoutText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Width="70" MaxLength="6" TextAlignment="Right" AutomationProperties.Name="{Binding LabelTaskTimeoutNormal}"/>
                            <TextBlock Text="{Binding UnitSeconds}" Style="{StaticResource Unit}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding HintTaskTimeoutNormal}" Style="{StaticResource Hint}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding NoteTimeLimits}" Style="{StaticResource Hint}" Margin="0,0,0,8"/>
                </StackPanel>
            </StackPanel>

            <!-- ── Context and memory ─────────────────────────────────────── -->
            <StackPanel Visibility="{Binding PageContextVisible, Converter={StaticResource b2v}}">
                <TextBlock Text="{Binding LabelThisConversation}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                <StackPanel Visibility="{Binding HasUsage, Converter={StaticResource b2v}}" Margin="0,0,0,20">
                    <Grid MaxWidth="520" HorizontalAlignment="Left" Width="520">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding UsageSummary}" Foreground="{Binding SubtleForeground}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Style="{StaticResource LinkButton}" Content="{Binding LabelOpenXray}"
                                Command="{Binding OpenXrayCommand}"/>
                    </Grid>
                    <!-- Remote UI binds no star length: the bar has the width the view model sizes its segments against. -->
                    <Border Width="520" Height="10" CornerRadius="5" HorizontalAlignment="Left" Margin="0,8,0,8" ClipToBounds="True"
                            Background="{Binding McpRowBackground}" BorderBrush="{Binding McpRowBorder}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="{Binding UsageInstructionsWidth}" Height="8" Fill="#B180D7"/>
                            <Rectangle Width="{Binding UsageToolsWidth}" Height="8" Fill="#3794FF"/>
                            <Rectangle Width="{Binding UsageConversationWidth}" Height="8" Fill="#4CC27A"/>
                        </StackPanel>
                    </Border>
                    <WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                            <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#B180D7" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding UsageInstructions}" Foreground="{Binding SubtleForeground}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                            <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#3794FF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding UsageTools}" Foreground="{Binding SubtleForeground}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                            <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="#4CC27A" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding UsageConversation}" Foreground="{Binding SubtleForeground}"/>
                        </StackPanel>
                    </WrapPanel>
                    <Button Style="{StaticResource LinkButton}" Content="{Binding LabelChangeWindow}" Command="{Binding ChangeWindowCommand}"
                            HorizontalAlignment="Left" Margin="0,4,0,0"/>
                </StackPanel>
                <TextBlock Text="{Binding UsageNoChatText}" Style="{StaticResource Hint}" Margin="0,0,0,20"
                           Visibility="{Binding UsageNoChat, Converter={StaticResource b2v}}"/>

                <Border BorderBrush="{Binding NavLineBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                    <TextBlock Text="{Binding LabelSectionLongConversations}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                </Border>
                <CheckBox IsChecked="{Binding CompactionEnabled, Mode=TwoWay}" Margin="0,0,0,14" VerticalContentAlignment="Top">
                    <StackPanel Margin="4,0,0,0">
                        <TextBlock Text="{Binding LabelCompactionEnabled}" Style="{StaticResource FieldLabel}" Margin="0"/>
                        <TextBlock Text="{Binding HintCompactionEnabled}" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                    </StackPanel>
                </CheckBox>
                <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,16,16">
                        <TextBlock Text="{Binding LabelContextWindowKeepTurns}" Style="{StaticResource FieldLabel}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding ContextWindowKeepTurnsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Width="60" MaxLength="2" TextAlignment="Right" AutomationProperties.Name="{Binding LabelContextWindowKeepTurns}"/>
                            <TextBlock Text="{Binding UnitTurns}" Style="{StaticResource Unit}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding HintContextWindowKeepTurns}" Style="{StaticResource Hint}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,16">
                        <TextBlock Text="{Binding LabelOodaTurnThreshold}" Style="{StaticResource FieldLabel}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding OodaTurnThresholdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Width="60" MaxLength="3" TextAlignment="Right" AutomationProperties.Name="{Binding LabelOodaTurnThreshold}"/>
                            <TextBlock Text="{Binding UnitTurns}" Style="{StaticResource Unit}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding HintOodaTurnThreshold}" Style="{StaticResource Hint}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,16">
                        <TextBlock Text="{Binding LabelCompactionTimeout}" Style="{StaticResource FieldLabel}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding CompactionTimeoutText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Width="70" MaxLength="6" TextAlignment="Right" AutomationProperties.Name="{Binding LabelCompactionTimeout}"/>
                            <TextBlock Text="{Binding UnitSeconds}" Style="{StaticResource Unit}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding HintCompactionTimeout}" Style="{StaticResource Hint}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,16">
                        <TextBlock Text="{Binding LabelKvCacheAnchor}" Style="{StaticResource FieldLabel}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding KvCacheAnchorMessagesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Width="60" MaxLength="2" TextAlignment="Right" AutomationProperties.Name="{Binding LabelKvCacheAnchor}"/>
                            <TextBlock Text="{Binding UnitMessages}" Style="{StaticResource Unit}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding HintKvCacheAnchor}" Style="{StaticResource Hint}"/>
                    </StackPanel>
                </UniformGrid>

                <Border BorderBrush="{Binding NavLineBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,4,0,0">
                    <TextBlock Text="{Binding LabelSectionAlwaysInPrompt}" Style="{StaticResource SectionTitle}" Margin="0,0,0,2"/>
                </Border>
                <TextBlock Text="{Binding DescSectionAlwaysInPrompt}" Style="{StaticResource Hint}" Margin="0,0,0,12"/>

                <!-- Pinned files: list header (label · count badge · view toggle) -->
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding LabelPinnedContextFiles}" Style="{StaticResource FieldLabel}" Margin="0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding PinnedCountText}" Foreground="{Binding SubtleForeground}"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <Button Grid.Column="3" Style="{StaticResource LinkButton}" Command="{Binding ToggleSectionPinnedRawCommand}" Content="{Binding PinnedViewLabel}" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock Text="{Binding HintPinnedContextFiles}" Style="{StaticResource Hint}" Margin="0,0,0,8"/>

                <!-- List view (rows / empty state / add / inline editor) — hidden in Text view -->
                <StackPanel Visibility="{Binding PinnedListViewVisible, Converter={StaticResource b2v}}">
                <Border Visibility="{Binding PinnedEmpty, Converter={StaticResource b2v}}"
                        BorderBrush="{Binding McpRowBorder}" BorderThickness="1" CornerRadius="8"
                        Background="{Binding EditPanelBg}" Padding="14,14" Margin="0,0,0,8">
                    <TextBlock Text="{Binding PinnedEmptyTitle}" Foreground="{Binding TextForeground}" FontWeight="SemiBold"
                               HorizontalAlignment="Center" TextWrapping="Wrap"/>
                </Border>
                <ItemsControl ItemsSource="{Binding PinnedFileRows}" Margin="0,0,0,6">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding DataContext.McpRowBackground, ElementName=root}"
                                    BorderBrush="{Binding DataContext.McpRowBorder, ElementName=root}" BorderThickness="1"
                                    CornerRadius="8" Padding="8,6" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold"
                                                   Foreground="{Binding DataContext.TextForeground, ElementName=root}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Summary}" FontSize="11"
                                                   Foreground="{Binding DataContext.McpSubtleForeground, ElementName=root}"
                                                   FontFamily="Cascadia Mono, Consolas" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Note}" FontSize="11" Foreground="{Binding DataContext.WarningForeground, ElementName=root}" TextWrapping="Wrap"
                                                   Visibility="{Binding HasNote, Converter={StaticResource b2v}}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Size}" FontSize="11" VerticalAlignment="Center" Margin="10,0,8,0"
                                               Foreground="{Binding DataContext.SubtleForeground, ElementName=root}"/>
                                    <Button Grid.Column="3" Command="{Binding EditCommand}" ToolTip="{Binding DataContext.HintRowEdit, ElementName=root}" AutomationProperties.Name="{Binding DataContext.HintRowEdit, ElementName=root}" Width="28" Height="26" Margin="0,0,2,0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" CornerRadius="4" Background="Transparent">
                                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70F;" FontSize="12" Foreground="{Binding DataContext.McpEditGlyph, ElementName=root}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{Binding DataContext.ThemeHoverBg, ElementName=root}"/></Trigger></ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Grid.Column="4" Command="{Binding DeleteCommand}" ToolTip="{Binding DataContext.HintRowDelete, ElementName=root}" AutomationProperties.Name="{Binding DataContext.HintRowDelete, ElementName=root}" Width="28" Height="26">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" CornerRadius="4" Background="Transparent">
                                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" FontSize="12" Foreground="#CC6666" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#5A2D2D"/></Trigger></ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Command="{Binding AddPinnedCommand}" HorizontalAlignment="Left" Padding="12,5" Margin="0,0,0,8"
                        AutomationProperties.Name="{Binding LabelPinnedAddFile}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE710;" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding LabelPinnedAddFile}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Border Visibility="{Binding IsEditingPinned, Converter={StaticResource b2v}}" Background="{Binding EditPanelBg}" BorderBrush="{Binding McpRowBorder}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="{Binding PinnedEditingTitle}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding LabelPinnedPath}" Foreground="{Binding TextForeground}" FontSize="11" Opacity="0.8"/>
                        <Grid Margin="0,2,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding EditPinnedPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Cascadia Mono, Consolas" VerticalContentAlignment="Center"/>
                            <Button Grid.Column="1" Content="{Binding LabelPinnedBrowse}" Command="{Binding BrowsePinnedCommand}" Padding="10,4" Margin="6,0,0,0"/>
                        </Grid>
                        <TextBlock Text="{Binding EditPinnedError}" Foreground="#F48771" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{Binding BtnMcpSaveServer}" Command="{Binding SavePinnedCommand}" Padding="12,4" Margin="0,0,6,0"/>
                            <Button Content="{Binding BtnMcpCancelServer}" Command="{Binding CancelEditPinnedCommand}" Padding="12,4"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                </StackPanel>
                <!-- Text view (raw editor) — the other face of the header toggle -->
                <StackPanel Visibility="{Binding SectionPinnedRawExpanded, Converter={StaticResource b2v}}" Margin="0,0,0,12">
                    <TextBox Text="{Binding PinnedContextFiles, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="56" FontFamily="Cascadia Mono, Consolas" FontSize="11" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,0,0,6"/>
                    <Button Content="{Binding BtnRowImport}" Command="{Binding ImportPinnedCommand}" HorizontalAlignment="Left" Padding="12,4"/>
                </StackPanel>

                <TextBlock Text="{Binding LabelProjectFiles}" Style="{StaticResource FieldLabel}" Margin="0,10,0,6"/>
                <ItemsControl ItemsSource="{Binding ProjectFileRows}" Margin="0,0,0,12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding FileName}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                           Foreground="{Binding DataContext.TextForeground, ElementName=root}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Description}" Foreground="{Binding DataContext.SubtleForeground, ElementName=root}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0"/>
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Visibility="{Binding Exists, Converter={StaticResource b2v}}">
                                    <Hyperlink Command="{Binding OpenCommand}" Foreground="{Binding DataContext.LinkForeground, ElementName=root}"
                                               TextDecorations="None"><Run Text="{Binding DataContext.LabelOpenFile, ElementName=root, Mode=OneWay}"/></Hyperlink>
                                </TextBlock>
                                <TextBlock Grid.Column="2" Text="{Binding NotYet}" Foreground="{Binding DataContext.SubtleForeground, ElementName=root}"
                                           VerticalAlignment="Center" Visibility="{Binding Missing, Converter={StaticResource b2v}}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ── Code search ────────────────────────────────────────────── -->
            <StackPanel Visibility="{Binding PageSearchVisible, Converter={StaticResource b2v}}">
                <Border Style="{StaticResource Card}" Margin="0,0,0,20" Visibility="{Binding HasIndexCard, Converter={StaticResource b2v}}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Width="9" Height="9" Fill="{Binding IndexCardDot}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding IndexCardTitle}" Style="{StaticResource SectionTitle}" Margin="0"/>
                                <TextBlock Text="{Binding IndexCardDetail}" Style="{StaticResource Hint}" Margin="0,1,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="{Binding IndexCardButton}" Command="{Binding RebuildIndexCommand}"
                                    IsEnabled="{Binding IndexCardCanRebuild}" Padding="12,4" VerticalAlignment="Center"
                                    Visibility="{Binding IndexCardHasButton, Converter={StaticResource b2v}}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding IndexCardNotes}" Margin="19,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="{Binding DataContext.WarningForeground, ElementName=root}"
                                               TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock TextWrapping="Wrap" Margin="19,4,0,0" Visibility="{Binding HasOversize, Converter={StaticResource b2v}}">
                            <Run Text="{Binding IndexCardOversizeNote, Mode=OneWay}" Foreground="{Binding WarningForeground}"/>
                            <Hyperlink Command="{Binding ToggleOversizeCommand}" Foreground="{Binding LinkForeground}"><Run Text="{Binding OversizeToggleLabel, Mode=OneWay}"/></Hyperlink>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding IndexCardOversizeFiles}" Margin="33,4,0,0"
                                      Visibility="{Binding ShowOversizeFiles, Converter={StaticResource b2v}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                               Foreground="{Binding DataContext.SubtleForeground, ElementName=root}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock TextWrapping="Wrap" Margin="19,8,0,0" FontSize="11.5">
                            <Run Text="{Binding IndexCardModelLine, Mode=OneWay}" Foreground="{Binding SubtleForeground}"/>
                            <Hyperlink Command="{Binding ChangeFimModelCommand}" Foreground="{Binding LinkForeground}"><Run Text="{Binding LabelChangeInServer, Mode=OneWay}"/></Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding LabelSectionYourCode}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                <CheckBox IsChecked="{Binding RagEnabled, Mode=TwoWay}" Margin="0,0,0,12" VerticalContentAlignment="Top">
                    <StackPanel Margin="4,0,0,0">
                        <TextBlock Text="{Binding LabelRagEnabled}" Style="{StaticResource FieldLabel}" Margin="0"/>
                        <TextBlock Text="{Binding HintRagEnabled}" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                    </StackPanel>
                </CheckBox>
                <CheckBox IsChecked="{Binding RagAutoContextEnabled, Mode=TwoWay}" Margin="0,0,0,12" VerticalContentAlignment="Top">
                    <StackPanel Margin="4,0,0,0">
                        <TextBlock Text="{Binding LabelRagAutoContext}" Style="{StaticResource FieldLabel}" Margin="0"/>
                        <TextBlock Text="{Binding HintRagAutoContext}" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                    </StackPanel>
                </CheckBox>
                <CheckBox IsChecked="{Binding LspEnabled, Mode=TwoWay}" Margin="0,0,0,16" VerticalContentAlignment="Top">
                    <StackPanel Margin="4,0,0,0">
                        <TextBlock Text="{Binding LabelLspEnabled}" Style="{StaticResource FieldLabel}" Margin="0"/>
                        <TextBlock Text="{Binding HintLspEnabled}" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                    </StackPanel>
                </CheckBox>
                <UniformGrid Columns="2">
                    <StackPanel Margin="0,0,16,16">
                        <TextBlock Text="{Binding LabelRagTopK}" Style="{StaticResource FieldLabel}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding RagTopKText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Width="60" MaxLength="2" TextAlignment="Right" AutomationProperties.Name="{Binding LabelRagTopK}"/>
                            <TextBlock Text="{Binding UnitChunks}" Style="{StaticResource Unit}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding HintRagTopK}" Style="{StaticResource Hint}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,16">
                        <TextBlock Text="{Binding LabelRagSimilarityThreshold}" Style="{StaticResource FieldLabel}"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding RagSimilarityThresholdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Width="60" MaxLength="4" TextAlignment="Right" AutomationProperties.Name="{Binding LabelRagSimilarityThreshold}"/>
                            <TextBlock Text="{Binding UnitRangeZeroToOne}" Style="{StaticResource Unit}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding HintRagSimilarityThreshold}" Style="{StaticResource Hint}"/>
                    </StackPanel>
                </UniformGrid>

                <TextBlock Text="{Binding LabelExclusions}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                <TextBlock Text="{Binding ExclusionsHowTo}" Style="{StaticResource Hint}" Margin="0,0,0,20"
                           Visibility="{Binding NoExclusions, Converter={StaticResource b2v}}"/>
                <WrapPanel Visibility="{Binding HasExclusions, Converter={StaticResource b2v}}" Margin="0,0,0,20">
                    <ItemsControl ItemsSource="{Binding IndexExclusions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{Binding DataContext.McpRowBorder, ElementName=root}" BorderThickness="1" CornerRadius="10"
                                        Background="{Binding DataContext.McpRowBackground, ElementName=root}" Padding="8,1" Margin="0,0,6,4">
                                    <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas" FontSize="11.5"
                                               Foreground="{Binding DataContext.TextForeground, ElementName=root}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding ExclusionsFrom}" Foreground="{Binding SubtleForeground}" VerticalAlignment="Center" Margin="2,0,8,4"/>
                    <Button Style="{StaticResource LinkButton}" Content="{Binding LabelEditFile}" Command="{Binding EditExclusionsCommand}"
                            Margin="0,0,0,4" Visibility="{Binding ExclusionsEditable, Converter={StaticResource b2v}}"/>
                </WrapPanel>

                <Border BorderBrush="{Binding NavLineBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding LabelSectionDocs}" Style="{StaticResource SectionTitle}" Margin="0"/>
                            <TextBlock Text="{Binding DescSectionDocs}" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding AddSiteCommand}" Padding="12,5" VerticalAlignment="Center"
                                AutomationProperties.Name="{Binding LabelDocsAddSite}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE710;" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding LabelDocsAddSite}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
                <Border Visibility="{Binding DocsEmpty, Converter={StaticResource b2v}}" Style="{StaticResource Card}" Margin="0,10,0,0">
                    <TextBlock Text="{Binding DocsNoSitesYet}" Foreground="{Binding SubtleForeground}" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                </Border>
                <ItemsControl ItemsSource="{Binding DocsSiteRows}" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,6">
                                <Border Background="{Binding DataContext.McpRowBackground, ElementName=root}"
                                        BorderBrush="{Binding DataContext.McpRowBorder, ElementName=root}" BorderThickness="1"
                                        CornerRadius="8" Padding="10,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{Binding Dot}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                       Foreground="{Binding DataContext.TextForeground, ElementName=root}"/>
                                            <TextBlock Text="{Binding Address}" FontFamily="Cascadia Mono, Consolas" FontSize="11" TextTrimming="CharacterEllipsis"
                                                       Foreground="{Binding DataContext.SubtleForeground, ElementName=root}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Status}" VerticalAlignment="Center" Margin="10,0"
                                                   Foreground="{Binding DataContext.SubtleForeground, ElementName=root}"/>
                                        <Button Grid.Column="3" Content="{Binding DataContext.LabelDocsReindex, ElementName=root}" Command="{Binding ReindexCommand}"
                                                IsEnabled="{Binding NotBusy}" Padding="10,3" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <Button Grid.Column="4" Command="{Binding RemoveCommand}" ToolTip="{Binding RemoveLabel}"
                                                AutomationProperties.Name="{Binding RemoveLabel}" Width="28" Height="26">
                                            <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="bd" CornerRadius="4" Background="Transparent"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" FontSize="12" Foreground="#CC6666" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#5A2D2D"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                                        </Button>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding HoleNote}" FontSize="11.5" TextWrapping="Wrap" Margin="28,3,0,0"
                                           Foreground="{Binding DataContext.WarningForeground, ElementName=root}"
                                           Visibility="{Binding HasHoleNote, Converter={StaticResource b2v}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Visibility="{Binding IsAddingSite, Converter={StaticResource b2v}}" Background="{Binding EditPanelBg}"
                        BorderBrush="{Binding McpRowBorder}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,4,0,8">
                    <StackPanel>
                        <TextBlock Text="{Binding LabelDocsAddUrl}" Foreground="{Binding TextForeground}" FontSize="11" Opacity="0.8"/>
                        <TextBox Text="{Binding NewSiteUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Cascadia Mono, Consolas"
                                 Margin="0,2,0,8" AutomationProperties.Name="{Binding LabelDocsAddUrl}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{Binding LabelDocsAddButton}" Command="{Binding ConfirmAddSiteCommand}" Padding="12,4" Margin="0,0,6,0"/>
                            <Button Content="{Binding BtnCancel}" Command="{Binding CancelAddSiteCommand}" Padding="12,4"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding DocsMessage}" Foreground="{Binding TextForeground}" TextWrapping="Wrap" Margin="0,4,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding NoteDocs}" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
            </StackPanel>

            <!-- ── Autocomplete ───────────────────────────────────────────── -->
            <StackPanel Visibility="{Binding PageAutocompleteVisible, Converter={StaticResource b2v}}">
                <!-- Ghost text: only for a backend that serves fill-in-the-middle -->
                <StackPanel Visibility="{Binding ShowInlineCompletions, Converter={StaticResource b2v}}">
                    <TextBlock Text="{Binding LabelSectionAsYouType}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                    <CheckBox IsChecked="{Binding InlineCompletionEnabled, Mode=TwoWay}" Margin="0,0,0,14" VerticalContentAlignment="Top">
                        <StackPanel Margin="4,0,0,0">
                            <TextBlock Text="{Binding LabelInlineCompletionEnabled}" Style="{StaticResource FieldLabel}" Margin="0"/>
                            <TextBlock Text="{Binding HintInlineCompletionEnabled}" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </CheckBox>
                    <!-- What a suggestion looks like: the code typed, and the grey rest Tab would accept. Decorative. -->
                    <Border Style="{StaticResource Card}" Padding="12,9" Margin="0,0,0,14">
                        <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{Binding TextForeground}">
                            <Run Text="public decimal Total(IEnumerable&lt;Line&gt; lines)"/><LineBreak/>
                            <Run Text="{}{"/><LineBreak/>
                            <Run Text="    return lines."/><Run Text="Sum(l =&gt; l.Price * l.Quantity);" FontStyle="Italic" Foreground="{Binding SubtleForeground}"/><LineBreak/>
                            <Run Text="}"/>
                        </TextBlock>
                    </Border>
                    <TextBlock Text="{Binding LabelInlineCompletionMode}" Style="{StaticResource FieldLabel}"/>
                    <UniformGrid Columns="3" Margin="0,2,0,0" AutomationProperties.Name="{Binding LabelInlineCompletionMode}">
                        <RadioButton Style="{StaticResource ChoiceCard}" GroupName="inlineSpeed" Tag="{Binding FimFastName}"
                                     IsChecked="{Binding InlineModeFast, Mode=TwoWay}" AutomationProperties.Name="{Binding FimFastName}">
                            <TextBlock Text="{Binding FimFastDesc}" Style="{StaticResource Hint}" Margin="0"/>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ChoiceCard}" GroupName="inlineSpeed" Tag="{Binding FimDefaultName}"
                                     IsChecked="{Binding InlineModeDefault, Mode=TwoWay}" AutomationProperties.Name="{Binding FimDefaultName}">
                            <TextBlock Text="{Binding FimDefaultDesc}" Style="{StaticResource Hint}" Margin="0"/>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ChoiceCard}" GroupName="inlineSpeed" Tag="{Binding FimAccurateName}" Margin="0"
                                     IsChecked="{Binding InlineModeAccurate, Mode=TwoWay}" AutomationProperties.Name="{Binding FimAccurateName}">
                            <TextBlock Text="{Binding FimAccurateDesc}" Style="{StaticResource Hint}" Margin="0"/>
                        </RadioButton>
                    </UniformGrid>
                    <TextBlock TextWrapping="Wrap" Margin="0,10,0,20" FontSize="11.5">
                        <Run Text="{Binding FimModelLine, Mode=OneWay}" Foreground="{Binding SubtleForeground}"/>
                        <Hyperlink Command="{Binding ChangeFimModelCommand}" Foreground="{Binding LinkForeground}"><Run Text="{Binding LabelChangeInServer, Mode=OneWay}"/></Hyperlink>
                    </TextBlock>
                </StackPanel>

                <Border BorderBrush="{Binding NavLineBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                    <TextBlock Text="{Binding LabelSectionEditWithAi}" Style="{StaticResource SectionTitle}" Margin="0,0,0,2"/>
                </Border>
                <TextBlock Text="{Binding DescSectionEditWithAi}" Style="{StaticResource Hint}" Margin="0,0,0,12"/>
                <CheckBox IsChecked="{Binding InlineDiffPreviewEnabled, Mode=TwoWay}" Margin="0,0,0,10" VerticalContentAlignment="Top">
                    <StackPanel Margin="4,0,0,0">
                        <TextBlock Text="{Binding LabelInlineDiffPreview}" Style="{StaticResource FieldLabel}" Margin="0"/>
                        <TextBlock Text="{Binding HintInlineDiffPreview}" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                    </StackPanel>
                </CheckBox>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,14" FontSize="11.5">
                    <Run Text="{Binding EditModelLine, Mode=OneWay}" Foreground="{Binding SubtleForeground}"/>
                    <Hyperlink Command="{Binding ChangeEditModelCommand}" Foreground="{Binding LinkForeground}"><Run Text="{Binding LabelChangeInServer, Mode=OneWay}"/></Hyperlink>
                </TextBlock>
            </StackPanel>

            <!-- ── Tools and MCP servers ──────────────────────────────────── -->
            <StackPanel Visibility="{Binding PageToolsVisible, Converter={StaticResource b2v}}">
                <!-- MCP servers: title · count · view toggle (List ⇄ JSON) -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding LabelSectionMcp}" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding McpSummaryText}" Foreground="{Binding SubtleForeground}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <Button Grid.Column="3" Style="{StaticResource LinkButton}" Command="{Binding ToggleSectionMcpJsonCommand}" Content="{Binding McpViewLabel}" VerticalAlignment="Center"/>
                </Grid>
                <CheckBox IsChecked="{Binding McpEnabled, Mode=TwoWay}" Margin="0,0,0,12" VerticalContentAlignment="Top">
                    <StackPanel Margin="4,0,0,0">
                        <TextBlock Text="{Binding LabelMcpEnabled}" Style="{StaticResource FieldLabel}" Margin="0"/>
                        <TextBlock Text="{Binding HintMcpEnabled}" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                    </StackPanel>
                </CheckBox>
                <TextBlock Text="{Binding HintMcpServers}" Style="{StaticResource Hint}" Margin="0,0,0,10"/>

                <!-- List view (rows / empty state / add / inline editor) — hidden in JSON view -->
                <StackPanel Visibility="{Binding McpListViewVisible, Converter={StaticResource b2v}}">
                <Border Visibility="{Binding McpEmpty, Converter={StaticResource b2v}}"
                        BorderBrush="{Binding McpRowBorder}" BorderThickness="1" CornerRadius="8"
                        Background="{Binding EditPanelBg}" Padding="14,14" Margin="0,0,0,8">
                    <TextBlock Text="{Binding McpEmptyTitle}" Foreground="{Binding TextForeground}" FontWeight="SemiBold"
                               HorizontalAlignment="Center" TextWrapping="Wrap"/>
                </Border>
                <ItemsControl ItemsSource="{Binding McpServers}" Margin="0,0,0,6">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding DataContext.McpRowBackground, ElementName=root}"
                                    BorderBrush="{Binding DataContext.McpRowBorder, ElementName=root}" BorderThickness="1"
                                    CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- The dot says the state; the status text beside it says it in words. -->
                                        <Ellipse Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#8A8A8A"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StateKey}" Value="connected"><Setter Property="Fill" Value="#3FB56A"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding StateKey}" Value="signIn"><Setter Property="Fill" Value="#D9A21B"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding StateKey}" Value="failed"><Setter Property="Fill" Value="#E5534B"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0"
                                                  AutomationProperties.Name="{Binding ServerName}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ServerName}" FontWeight="SemiBold"
                                                   Foreground="{Binding DataContext.TextForeground, ElementName=root}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Summary}" FontSize="11"
                                                   Foreground="{Binding DataContext.McpSubtleForeground, ElementName=root}"
                                                   FontFamily="Cascadia Mono, Consolas" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,8,0">
                                        <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                   Foreground="{Binding DataContext.McpSubtleForeground, ElementName=root}" VerticalAlignment="Center"/>
                                        <Button Command="{Binding AuthorizeCommand}" Content="{Binding DataContext.LabelMcpSignIn, ElementName=root}"
                                                Visibility="{Binding AuthRequired, Converter={StaticResource b2v}}"
                                                Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        <Button Command="{Binding RetryCommand}" Content="{Binding DataContext.LabelMcpRetry, ElementName=root}"
                                                Visibility="{Binding ShowRetry, Converter={StaticResource b2v}}"
                                                Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Grid.Column="3" Command="{Binding EditCommand}" ToolTip="{Binding DataContext.HintMcpEditServer, ElementName=root}" AutomationProperties.Name="{Binding DataContext.HintMcpEditServer, ElementName=root}"
                                            Width="28" Height="26" Margin="0,0,2,0">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" CornerRadius="4" Background="Transparent">
                                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70F;" FontSize="12" Foreground="{Binding DataContext.McpEditGlyph, ElementName=root}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="{Binding DataContext.ThemeHoverBg, ElementName=root}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Grid.Column="4" Command="{Binding DeleteCommand}" ToolTip="{Binding DataContext.HintMcpDeleteServer, ElementName=root}" AutomationProperties.Name="{Binding DataContext.HintMcpDeleteServer, ElementName=root}"
                                            Width="28" Height="26">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd" CornerRadius="4" Background="Transparent">
                                                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" FontSize="12" Foreground="#CC6666"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#5A2D2D"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Margin="18,6,0,0" Padding="8,5" CornerRadius="6"
                                            Background="{Binding DataContext.EditPanelBg, ElementName=root}"
                                            Visibility="{Binding HasCause, Converter={StaticResource b2v}}">
                                        <TextBlock Text="{Binding Cause}" FontFamily="Cascadia Mono, Consolas" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{Binding DataContext.TextForeground, ElementName=root}"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Command="{Binding AddServerCommand}" HorizontalAlignment="Left" Padding="12,5" Margin="0,0,0,8"
                        AutomationProperties.Name="{Binding LabelMcpAddServer}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE710;" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding LabelMcpAddServer}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Border Visibility="{Binding IsEditingServer, Converter={StaticResource b2v}}"
                        Background="{Binding EditPanelBg}" BorderBrush="{Binding McpRowBorder}" BorderThickness="1"
                        CornerRadius="8" Padding="10" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="{Binding EditingTitle}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding LabelMcpName}" Foreground="{Binding TextForeground}" FontSize="11" Opacity="0.8"/>
                        <TextBox Text="{Binding EditServerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6"/>
                        <CheckBox Content="{Binding LabelMcpHttpServer}" IsChecked="{Binding EditServerIsHttp, Mode=TwoWay}"
                                  Foreground="{Binding TextForeground}" Margin="0,0,0,6"/>
                        <!-- stdio transport fields -->
                        <StackPanel Visibility="{Binding EditServerIsStdio, Converter={StaticResource b2v}}">
                            <TextBlock Text="{Binding LabelMcpCommand}" Foreground="{Binding TextForeground}" FontSize="11" Opacity="0.8"/>
                            <TextBox Text="{Binding EditServerCommand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Cascadia Mono, Consolas" Margin="0,2,0,6"/>
                            <TextBlock Text="{Binding LabelMcpArgs}" Foreground="{Binding TextForeground}" FontSize="11" Opacity="0.8"/>
                            <TextBox Text="{Binding EditServerArgs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Cascadia Mono, Consolas" Margin="0,2,0,6"
                                     AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="40" VerticalScrollBarVisibility="Auto"/>
                            <TextBlock Text="{Binding LabelMcpEnv}" Foreground="{Binding TextForeground}" FontSize="11" Opacity="0.8"/>
                            <TextBox Text="{Binding EditServerEnv, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="40"
                                     FontFamily="Cascadia Mono, Consolas" Margin="0,2,0,6" VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                        <!-- Streamable HTTP transport fields -->
                        <StackPanel Visibility="{Binding EditServerIsHttp, Converter={StaticResource b2v}}">
                            <TextBlock Text="{Binding LabelMcpUrl}" Foreground="{Binding TextForeground}" FontSize="11" Opacity="0.8"/>
                            <TextBox Text="{Binding EditServerUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Cascadia Mono, Consolas" Margin="0,2,0,6"/>
                            <TextBlock Text="{Binding LabelMcpHeaders}" Foreground="{Binding TextForeground}" FontSize="11" Opacity="0.8"/>
                            <TextBox Text="{Binding EditServerHeaders, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="40"
                                     FontFamily="Cascadia Mono, Consolas" Margin="0,2,0,6" VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                        <TextBlock Text="{Binding EditServerError}" Foreground="#F48771" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{Binding BtnMcpSaveServer}" Command="{Binding SaveServerCommand}" Padding="12,4" Margin="0,0,6,0"/>
                            <Button Content="{Binding BtnMcpCancelServer}" Command="{Binding CancelEditServerCommand}" Padding="12,4"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                </StackPanel>
                <TextBlock Text="{Binding McpStatusText}" Foreground="{Binding WarningForeground}" TextWrapping="Wrap" Margin="0,0,0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                <!-- JSON view (raw editor) — the other face of the header toggle -->
                <StackPanel Visibility="{Binding SectionMcpJsonExpanded, Converter={StaticResource b2v}}" Margin="0,0,0,12">
                    <TextBox Text="{Binding McpServersJson, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="90"
                             FontFamily="Cascadia Mono, Consolas" FontSize="11"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,0,0,6"/>
                    <Button Content="{Binding BtnMcpImportJson}" Command="{Binding ImportJsonCommand}" HorizontalAlignment="Left" Padding="12,4"/>
                </StackPanel>

                <!-- Approval rules -->
                <Border BorderBrush="{Binding NavLineBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding LabelSectionRules}" Style="{StaticResource SectionTitle}" Margin="0,0,0,2"/>
                        <Button Grid.Column="1" Style="{StaticResource LinkButton}" Content="{Binding RulesViewLabel}"
                                Command="{Binding ToggleRulesTextCommand}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <TextBlock Text="{Binding DescSectionRules}" Style="{StaticResource Hint}" Margin="0,0,0,12"/>
                <TextBlock Text="{Binding RulesTeamUnusableText}" Foreground="{Binding WarningForeground}" TextWrapping="Wrap" Margin="0,0,0,8"
                           Visibility="{Binding RulesTeamUnusable, Converter={StaticResource b2v}}"/>

                <!-- Table view: every rule written, team file then this machine, in evaluation order -->
                <StackPanel Margin="0,0,0,18">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RulesTextExpanded}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Border Visibility="{Binding RulesEmpty, Converter={StaticResource b2v}}"
                            BorderBrush="{Binding McpRowBorder}" BorderThickness="1" CornerRadius="8"
                            Background="{Binding EditPanelBg}" Padding="14,12" Margin="0,0,0,8">
                        <TextBlock Text="{Binding RulesEmptyText}" Foreground="{Binding SubtleForeground}" HorizontalAlignment="Center"/>
                    </Border>
                    <Grid Visibility="{Binding RulesTableVisible, Converter={StaticResource b2v}}" Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="84"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="32"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding LabelRulesColEffect}" Foreground="{Binding SubtleForeground}" FontWeight="SemiBold" FontSize="11.5" Margin="4,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding LabelRulesColTool}" Foreground="{Binding SubtleForeground}" FontWeight="SemiBold" FontSize="11.5" Margin="4,0"/>
                        <TextBlock Grid.Column="2" Text="{Binding LabelRulesColPattern}" Foreground="{Binding SubtleForeground}" FontWeight="SemiBold" FontSize="11.5" Margin="4,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="3" Text="{Binding LabelRulesColFrom}" Foreground="{Binding SubtleForeground}" FontWeight="SemiBold" FontSize="11.5" Margin="4,0"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding ApprovalRules}" Margin="0,0,0,10">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{Binding DataContext.NavLineBrush, ElementName=root}" BorderThickness="0,1,0,0" Padding="0,6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding InForce}" Value="False">
                                                    <Setter Property="Opacity" Value="0.7"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="84"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="32"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="9" BorderThickness="1" Padding="8,1" Margin="4,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAllow}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Setter Property="BorderBrush" Value="#3FB56A"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsDeny}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Setter Property="BorderBrush" Value="#E5534B"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding EffectText}" FontSize="11.5" Foreground="{Binding DataContext.TextForeground, ElementName=root}"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Tool}" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Margin="4,0"
                                                   Foreground="{Binding DataContext.TextForeground, ElementName=root}" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Grid.Column="2" Margin="4,0">
                                            <TextBlock Text="{Binding Pattern}" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" TextWrapping="Wrap"
                                                       Foreground="{Binding DataContext.TextForeground, ElementName=root}"/>
                                            <TextBlock Text="{Binding NoteText}" FontSize="11" TextWrapping="Wrap" Foreground="{Binding DataContext.WarningForeground, ElementName=root}"
                                                       Visibility="{Binding HasNote, Converter={StaticResource b2v}}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Text="{Binding FromText}" FontSize="11.5" Margin="4,0" TextTrimming="CharacterEllipsis"
                                                   Foreground="{Binding DataContext.SubtleForeground, ElementName=root}"/>
                                        <Button Grid.Column="4" Command="{Binding DeleteCommand}" Width="28" Height="24" VerticalAlignment="Top"
                                                Visibility="{Binding CanDelete, Converter={StaticResource b2v}}"
                                                ToolTip="{Binding DataContext.HintRowDelete, ElementName=root}" AutomationProperties.Name="{Binding DataContext.HintRowDelete, ElementName=root}">
                                            <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="bd" CornerRadius="4" Background="Transparent"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" FontSize="12" Foreground="#CC6666" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#5A2D2D"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- A new rule: written only if it would be read -->
                    <Grid Margin="0,0,0,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding LabelRulesColEffect}" Style="{StaticResource Hint}" Margin="0,0,0,3"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding LabelRulesColTool}" Style="{StaticResource Hint}" Margin="0,0,0,3"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding LabelRulesColPattern}" Style="{StaticResource Hint}" Margin="0,0,0,3"/>
                        <Button Grid.Row="1" Grid.Column="0" Content="{Binding LabelRuleDeny}" Command="{Binding SetRuleDenyCommand}" Padding="10,3">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Static vs:VsResourceKeys.ButtonStyleKey}}">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NewRuleIsAllow}" Value="True">
                                            <Setter Property="FontWeight" Value="Normal"/>
                                            <Setter Property="Opacity" Value="0.6"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Row="1" Grid.Column="1" Content="{Binding LabelRuleAllow}" Command="{Binding SetRuleAllowCommand}" Padding="10,3" Margin="4,0,8,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Static vs:VsResourceKeys.ButtonStyleKey}}">
                                    <Setter Property="FontWeight" Value="Normal"/>
                                    <Setter Property="Opacity" Value="0.6"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NewRuleIsAllow}" Value="True">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="Opacity" Value="1"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding NewRuleTool, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Cascadia Mono, Consolas" VerticalContentAlignment="Center" Margin="0,0,8,0"
                                 AutomationProperties.Name="{Binding LabelRulesColTool}"/>
                        <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding NewRulePattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Cascadia Mono, Consolas" VerticalContentAlignment="Center" Margin="0,0,8,0"
                                 AutomationProperties.Name="{Binding LabelRulesColPattern}"/>
                        <Button Grid.Row="1" Grid.Column="4" Command="{Binding AddRuleCommand}" Padding="12,3" AutomationProperties.Name="{Binding LabelRulesAdd}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE710;" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding LabelRulesAdd}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding NewRuleError}" Foreground="#F48771" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/>
                </StackPanel>

                <!-- Text view: the rules as saved, one per line -->
                <StackPanel Margin="0,0,0,18" Visibility="{Binding RulesTextExpanded, Converter={StaticResource b2v}}">
                    <TextBlock Text="{Binding LabelPermissionRules}" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding PermissionRules, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="70"
                             FontFamily="Cascadia Mono, Consolas" FontSize="11"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             AutomationProperties.Name="{Binding LabelPermissionRules}"/>
                    <TextBlock Text="{Binding HintPermissionRules}" Style="{StaticResource Hint}"/>
                </StackPanel>

                <!-- Your slash commands -->
                <Border BorderBrush="{Binding NavLineBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding LabelSectionSlash}" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding SlashCountText}" Foreground="{Binding SubtleForeground}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <Button Grid.Column="3" Style="{StaticResource LinkButton}" Command="{Binding ToggleSectionSlashRawCommand}" Content="{Binding SlashViewLabel}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <TextBlock Text="{Binding DescSectionSlash}" Style="{StaticResource Hint}" Margin="0,4,0,4"/>
                <TextBlock Text="{Binding HintPromptTemplates}" Style="{StaticResource Hint}" Margin="0,0,0,10"/>
                <StackPanel Visibility="{Binding SlashListViewVisible, Converter={StaticResource b2v}}">
                <Border Visibility="{Binding SlashEmpty, Converter={StaticResource b2v}}"
                        BorderBrush="{Binding McpRowBorder}" BorderThickness="1" CornerRadius="8"
                        Background="{Binding EditPanelBg}" Padding="14,14" Margin="0,0,0,8">
                    <TextBlock Text="{Binding SlashEmptyTitle}" Foreground="{Binding TextForeground}" FontWeight="SemiBold"
                               HorizontalAlignment="Center" TextWrapping="Wrap"/>
                </Border>
                <!-- The table's header: what the first column names, what the second sends or runs. -->
                <Border Padding="9,0,9,4">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SlashEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26"/>
                            <ColumnDefinition Width="26*"/>
                            <ColumnDefinition Width="74*"/>
                            <ColumnDefinition Width="58"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="{Binding SlashColCommand}" FontWeight="SemiBold" Foreground="{Binding SubtleForeground}"/>
                        <TextBlock Grid.Column="2" Text="{Binding SlashColSends}" FontWeight="SemiBold" Foreground="{Binding SubtleForeground}" Margin="8,0,0,0"/>
                    </Grid>
                </Border>
                <ItemsControl ItemsSource="{Binding SlashCommandRows}" Margin="0,0,0,6">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding DataContext.McpRowBackground, ElementName=root}" BorderBrush="{Binding DataContext.McpRowBorder, ElementName=root}" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26"/>
                                        <ColumnDefinition Width="26*"/>
                                        <ColumnDefinition Width="74*"/>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontFamily="Cascadia Mono, Consolas" Foreground="{Binding DataContext.TextForeground, ElementName=root}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Summary}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{Binding DataContext.TextForeground, ElementName=root}" TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="3" Command="{Binding EditCommand}" ToolTip="{Binding DataContext.HintRowEdit, ElementName=root}" AutomationProperties.Name="{Binding DataContext.HintRowEdit, ElementName=root}" Width="28" Height="26" Margin="0,0,2,0">
                                        <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="bd" CornerRadius="4" Background="Transparent"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70F;" FontSize="12" Foreground="{Binding DataContext.McpEditGlyph, ElementName=root}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{Binding DataContext.ThemeHoverBg, ElementName=root}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                                    </Button>
                                    <Button Grid.Column="4" Command="{Binding DeleteCommand}" ToolTip="{Binding DataContext.HintRowDelete, ElementName=root}" AutomationProperties.Name="{Binding DataContext.HintRowDelete, ElementName=root}" Width="28" Height="26">
                                        <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="bd" CornerRadius="4" Background="Transparent"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" FontSize="12" Foreground="#CC6666" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#5A2D2D"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Visibility="{Binding HasSlashUnread, Converter={StaticResource b2v}}"
                        BorderBrush="{Binding McpRowBorder}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,6">
                    <TextBlock Text="{Binding SlashUnreadText}" FontFamily="Cascadia Mono, Consolas" FontSize="11" TextWrapping="Wrap"
                               Foreground="{Binding WarningForeground}"/>
                </Border>
                <Button Command="{Binding AddSlashCommand}" HorizontalAlignment="Left" Padding="12,5" Margin="0,0,0,8"
                        AutomationProperties.Name="{Binding LabelSlashAddCmd}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE710;" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding LabelSlashAddCmd}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Border Visibility="{Binding IsEditingSlash, Converter={StaticResource b2v}}" Background="{Binding EditPanelBg}" BorderBrush="{Binding McpRowBorder}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="{Binding SlashEditingTitle}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding LabelSlashName}" Foreground="{Binding TextForeground}" FontSize="11" Opacity="0.8"/>
                        <TextBox Text="{Binding EditSlashName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Cascadia Mono, Consolas" Margin="0,2,0,6"/>
                        <TextBlock Text="{Binding LabelSlashText}" Foreground="{Binding TextForeground}" FontSize="11" Opacity="0.8"/>
                        <TextBox Text="{Binding EditSlashText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" Margin="0,2,0,6" VerticalScrollBarVisibility="Auto"/>
                        <TextBlock Text="{Binding EditSlashError}" Foreground="#F48771" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{Binding BtnMcpSaveServer}" Command="{Binding SaveSlashCommand}" Padding="12,4" Margin="0,0,6,0"/>
                            <Button Content="{Binding BtnMcpCancelServer}" Command="{Binding CancelEditSlashCommand}" Padding="12,4"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                </StackPanel>
                <StackPanel Visibility="{Binding SectionSlashRawExpanded, Converter={StaticResource b2v}}" Margin="0,0,0,12">
                    <TextBox Text="{Binding PromptTemplates, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="72" FontFamily="Cascadia Mono, Consolas" FontSize="11" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,0,0,6"/>
                    <Button Content="{Binding BtnRowImport}" Command="{Binding ImportSlashCommand}" HorizontalAlignment="Left" Padding="12,4"/>
                </StackPanel>

                <!-- Your agent tools -->
                <Border BorderBrush="{Binding NavLineBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding LabelSectionAgentTools}" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding ToolCountText}" Foreground="{Binding SubtleForeground}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        <Button Grid.Column="3" Style="{StaticResource LinkButton}" Command="{Binding ToggleSectionToolRawCommand}" Content="{Binding ToolViewLabel}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <TextBlock Text="{Binding DescSectionAgentTools}" Style="{StaticResource Hint}" Margin="0,4,0,4"/>
                <TextBlock Text="{Binding HintCustomTools}" Style="{StaticResource Hint}" Margin="0,0,0,10"/>
                <StackPanel Visibility="{Binding ToolListViewVisible, Converter={StaticResource b2v}}">
                <Border Visibility="{Binding ToolEmpty, Converter={StaticResource b2v}}"
                        BorderBrush="{Binding McpRowBorder}" BorderThickness="1" CornerRadius="8"
                        Background="{Binding EditPanelBg}" Padding="14,14" Margin="0,0,0,8">
                    <TextBlock Text="{Binding ToolEmptyTitle}" Foreground="{Binding TextForeground}" FontWeight="SemiBold"
                               HorizontalAlignment="Center" TextWrapping="Wrap"/>
                </Border>
                <!-- The table's header: what the first column names, what the second sends or runs. -->
                <Border Padding="9,0,9,4">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ToolEmpty}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26"/>
                            <ColumnDefinition Width="26*"/>
                            <ColumnDefinition Width="74*"/>
                            <ColumnDefinition Width="58"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="{Binding ToolColName}" FontWeight="SemiBold" Foreground="{Binding SubtleForeground}"/>
                        <TextBlock Grid.Column="2" Text="{Binding ToolColRuns}" FontWeight="SemiBold" Foreground="{Binding SubtleForeground}" Margin="8,0,0,0"/>
                    </Grid>
                </Border>
                <ItemsControl ItemsSource="{Binding CustomToolRows}" Margin="0,0,0,6">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{Binding DataContext.McpRowBackground, ElementName=root}" BorderBrush="{Binding DataContext.McpRowBorder, ElementName=root}" BorderThickness="1" CornerRadius="8" Padding="8,6" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26"/>
                                        <ColumnDefinition Width="26*"/>
                                        <ColumnDefinition Width="74*"/>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="28"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding Enabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontFamily="Cascadia Mono, Consolas" Foreground="{Binding DataContext.TextForeground, ElementName=root}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Summary}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{Binding DataContext.TextForeground, ElementName=root}" FontFamily="Cascadia Mono, Consolas" TextTrimming="CharacterEllipsis"/>
                                    <Button Grid.Column="3" Command="{Binding EditCommand}" ToolTip="{Binding DataContext.HintRowEdit, ElementName=root}" AutomationProperties.Name="{Binding DataContext.HintRowEdit, ElementName=root}" Width="28" Height="26" Margin="0,0,2,0">
                                        <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="bd" CornerRadius="4" Background="Transparent"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE70F;" FontSize="12" Foreground="{Binding DataContext.McpEditGlyph, ElementName=root}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{Binding DataContext.ThemeHoverBg, ElementName=root}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                                    </Button>
                                    <Button Grid.Column="4" Command="{Binding DeleteCommand}" ToolTip="{Binding DataContext.HintRowDelete, ElementName=root}" AutomationProperties.Name="{Binding DataContext.HintRowDelete, ElementName=root}" Width="28" Height="26">
                                        <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="bd" CornerRadius="4" Background="Transparent"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" FontSize="12" Foreground="#CC6666" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#5A2D2D"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Visibility="{Binding HasToolUnread, Converter={StaticResource b2v}}"
                        BorderBrush="{Binding McpRowBorder}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,6">
                    <TextBlock Text="{Binding ToolUnreadText}" FontFamily="Cascadia Mono, Consolas" FontSize="11" TextWrapping="Wrap"
                               Foreground="{Binding WarningForeground}"/>
                </Border>
                <Button Command="{Binding AddToolCommand}" HorizontalAlignment="Left" Padding="12,5" Margin="0,0,0,8"
                        AutomationProperties.Name="{Binding LabelToolAddTool}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE710;" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding LabelToolAddTool}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Border Visibility="{Binding IsEditingTool, Converter={StaticResource b2v}}" Background="{Binding EditPanelBg}" BorderBrush="{Binding McpRowBorder}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="{Binding ToolEditingTitle}" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding LabelToolName}" Foreground="{Binding TextForeground}" FontSize="11" Opacity="0.8"/>
                        <TextBox Text="{Binding EditToolName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontFamily="Cascadia Mono, Consolas" Margin="0,2,0,6"/>
                        <TextBlock Text="{Binding LabelToolCommand}" Foreground="{Binding TextForeground}" FontSize="11" Opacity="0.8"/>
                        <TextBox Text="{Binding EditToolCommand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="48" FontFamily="Cascadia Mono, Consolas" Margin="0,2,0,6" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                        <TextBlock Text="{Binding EditToolError}" Foreground="#F48771" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{Binding BtnMcpSaveServer}" Command="{Binding SaveToolCommand}" Padding="12,4" Margin="0,0,6,0"/>
                            <Button Content="{Binding BtnMcpCancelServer}" Command="{Binding CancelEditToolCommand}" Padding="12,4"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                </StackPanel>
                <StackPanel Visibility="{Binding SectionToolRawExpanded, Converter={StaticResource b2v}}" Margin="0,0,0,12">
                    <TextBox Text="{Binding CustomTools, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="60" FontFamily="Cascadia Mono, Consolas" FontSize="11" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,0,0,6"/>
                    <Button Content="{Binding BtnRowImport}" Command="{Binding ImportToolCommand}" HorizontalAlignment="Left" Padding="12,4"/>
                </StackPanel>
            </StackPanel>

            <!-- ── Language and appearance ────────────────────────────────── -->
            <StackPanel Visibility="{Binding PageAppearanceVisible, Converter={StaticResource b2v}}">
                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="{Binding LabelLanguage}" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding AvailableLanguages}" SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                              IsEditable="False" HorizontalAlignment="Left" MinWidth="260" AutomationProperties.Name="{Binding LabelLanguage}"/>
                    <TextBlock Text="{Binding HintLanguage}" Style="{StaticResource Hint}"/>
                </StackPanel>
                <!-- The editor's theme, shown and never set: the panel follows it, high contrast included. The cards draw
                     each theme with its own colours, whatever the window's. -->
                <TextBlock Text="{Binding LabelSectionTheme}" Style="{StaticResource SectionTitle}"/>
                <!-- A star column with a ceiling: the cards share the page's width, up to the page's text width. -->
                <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="690"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <UniformGrid Grid.Column="0" Columns="3" AutomationProperties.Name="{Binding LabelSectionTheme}">
                    <Border Margin="0,0,10,0" CornerRadius="10" Padding="10" Background="#F5F5F7">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="#34343C"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ThemeInUse}" Value="light">
                                        <Setter Property="BorderBrush" Value="#7C4DFF"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="60*"/><ColumnDefinition Width="40*"/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Height="8" CornerRadius="4" Background="#D9D9E0"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="85*"/><ColumnDefinition Width="15*"/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Height="8" CornerRadius="4" Background="#E6E6EB"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="55*"/><ColumnDefinition Width="45*"/></Grid.ColumnDefinitions>
                                <Border Grid.Column="1" Height="8" CornerRadius="4" Background="#7C4DFF"/>
                            </Grid>
                            <TextBlock Text="{Binding ThemeLightCaption}" Foreground="#1B1B1F" FontSize="12" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                    <Border Margin="0,0,10,0" CornerRadius="10" Padding="10" Background="#1B1B1F">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="#34343C"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ThemeInUse}" Value="dark">
                                        <Setter Property="BorderBrush" Value="#7C4DFF"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="60*"/><ColumnDefinition Width="40*"/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Height="8" CornerRadius="4" Background="#34343C"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="85*"/><ColumnDefinition Width="15*"/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Height="8" CornerRadius="4" Background="#2A2A31"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="55*"/><ColumnDefinition Width="45*"/></Grid.ColumnDefinitions>
                                <Border Grid.Column="1" Height="8" CornerRadius="4" Background="#7C4DFF"/>
                            </Grid>
                            <TextBlock Text="{Binding ThemeDarkCaption}" Foreground="#E8E8EC" FontSize="12" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                    <Border Margin="0,0,10,0" CornerRadius="10" Padding="10" Background="#000000">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="#FFFFFF"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ThemeInUse}" Value="highContrast">
                                        <Setter Property="BorderBrush" Value="#FFFF00"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="60*"/><ColumnDefinition Width="40*"/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Height="8" CornerRadius="4" BorderBrush="#FFFFFF" BorderThickness="1" Background="Transparent"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="85*"/><ColumnDefinition Width="15*"/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Height="8" CornerRadius="4" BorderBrush="#FFFFFF" BorderThickness="1" Background="Transparent"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="55*"/><ColumnDefinition Width="45*"/></Grid.ColumnDefinitions>
                                <Border Grid.Column="1" Height="8" CornerRadius="4" Background="#FFFF00"/>
                            </Grid>
                            <TextBlock Text="{Binding ThemeHighContrastCaption}" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
                </Grid>
                <TextBlock Text="{Binding ThemeNote}" Style="{StaticResource Hint}" Margin="0,6,0,20" MaxWidth="680" HorizontalAlignment="Left"/>

                <!-- How much space the conversation leaves around its turns -->
                <TextBlock Text="{Binding LabelDensity}" Style="{StaticResource FieldLabel}"/>
                <Border HorizontalAlignment="Left" Padding="3" CornerRadius="8" BorderThickness="1" BorderBrush="{Binding NavLineBrush}"
                        Margin="0,2,0,0" AutomationProperties.Name="{Binding LabelDensity}">
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding SetDensityCommand}" CommandParameter="comfortable" Cursor="Hand"
                                AutomationProperties.Name="{Binding LabelDensityComfortable}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" CornerRadius="6" Height="30" Padding="12,0" Background="Transparent">
                                        <TextBlock x:Name="txt" Text="{Binding LabelDensityComfortable}" Foreground="{Binding SubtleForeground}"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding ChatDensity}" Value="comfortable">
                                            <Setter TargetName="bd" Property="Background" Value="{Binding SegmentSelectedBg}"/>
                                            <Setter TargetName="txt" Property="Foreground" Value="{Binding TextForeground}"/>
                                            <Setter TargetName="txt" Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Command="{Binding SetDensityCommand}" CommandParameter="compact" Cursor="Hand"
                                AutomationProperties.Name="{Binding LabelDensityCompact}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" CornerRadius="6" Height="30" Padding="12,0" Background="Transparent">
                                        <TextBlock x:Name="txt" Text="{Binding LabelDensityCompact}" Foreground="{Binding SubtleForeground}"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding ChatDensity}" Value="compact">
                                            <Setter TargetName="bd" Property="Background" Value="{Binding SegmentSelectedBg}"/>
                                            <Setter TargetName="txt" Property="Foreground" Value="{Binding TextForeground}"/>
                                            <Setter TargetName="txt" Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding HintDensity}" Style="{StaticResource Hint}" Margin="0,4,0,20"/>

                <TextBlock Text="{Binding LabelSectionAgentRuns}" Style="{StaticResource SectionTitle}"/>
                <CheckBox IsChecked="{Binding ToolBubblesExpanded, Mode=TwoWay}" Margin="0,0,0,14" VerticalContentAlignment="Top">
                    <StackPanel Margin="4,0,0,0">
                        <TextBlock Text="{Binding LabelToolBubblesExpanded}" Style="{StaticResource FieldLabel}" Margin="0"/>
                        <TextBlock Text="{Binding HintToolBubblesExpanded}" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                    </StackPanel>
                </CheckBox>
            </StackPanel>

        </StackPanel>
        </Grid>
        </ScrollViewer>

        <!-- ══ Footer: unsaved changes · status · Cancel · Save ══════════════ -->
        <!-- ⚠ A Grid and not a horizontal StackPanel: the status names the fields a save could not read,
             it is a sentence — in a horizontal StackPanel a TextBlock gets infinite width and never wraps. -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{Binding NavPaneBg}"
                BorderBrush="{Binding NavLineBrush}" BorderThickness="0,1,0,0" Padding="16,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding UnsavedText}" Foreground="{Binding SubtleForeground}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding SaveStatus}" Foreground="{Binding TextForeground}" VerticalAlignment="Center"
                           TextWrapping="Wrap" Margin="12,0,12,0"/>
                <Button Grid.Column="2" Content="{Binding BtnCancel}" Command="{Binding CancelCommand}" Padding="14,5" Margin="0,0,8,0"/>
                <Button Grid.Column="3" Content="{Binding BtnSave}" Command="{Binding SaveCommand}" IsEnabled="{Binding SaveEnabled}" Padding="18,5"/>
            </Grid>
        </Border>
    </Grid>

</DataTemplate>
