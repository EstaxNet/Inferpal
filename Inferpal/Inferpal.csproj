<Project Sdk="Microsoft.NET.Sdk">

  <!-- ── Common properties ───────────────────────────────────────────────── -->
  <!-- Versioning, LangVersion, Nullable, ImplicitUsings, Deterministic and
       NeutralLanguage are inherited from Directory.Build.props (repo root). -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Inferpal</RootNamespace>
    <AssemblyName>Inferpal</AssemblyName>

    <!-- Suppress known, safe warnings:
         VSEXTPREVIEW_SETTINGS — SDK preview feature
         NU1701 — VS SDK packages restored for .NETFramework (provided by VS at runtime)
         MSB4011  — VSSDK targets re-import, known build-infrastructure bug -->
    <NoWarn>$(NoWarn);VSEXTPREVIEW_SETTINGS;NU1701</NoWarn>
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB4011</MSBuildWarningsAsMessages>

    <!-- Enables the full VSSDK pipeline (GeneratePkgDef, CreateVsixContainer…) -->
    <VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>

    <!-- HYBRID extension (out-of-proc + in-proc). Measured: without this switch the
         Extensibility SDK generates a manifest with NO <Assets> section and installs the
         extension under Common7\IDE\VSExtensions\, a world where VS processes NEITHER the
         pkgdef NOR the MEF catalog - so the in-process half (ghost text, inline edit,
         the /tdd debugger driver) is never inventoried: zero occurrences of "Inferpal" in
         ComponentModelCache\...Default.catalogs, against 41 for Docker.Compose, which does
         declare a MefComponent asset. A MEFComponent key in the private registry hive does
         not replace that asset (VS rebuilds _Config at startup and wipes it). With
         VssdkCompatibleExtension it is source.extension.vsixmanifest that gets packaged
         (VsPackage + MefComponent assets) and the install goes back into Extensions\. -->
    <VssdkCompatibleExtension>true</VssdkCompatibleExtension>

    <!-- Copy NuGet DLLs to the output directory so the VSIX embeds them -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

    <!-- VSIX packaging — shared by both configs -->
    <!-- GeneratePkgDefFile=false: CreatePkgDef.exe (.NET Framework) cannot load
         .NET 8 assemblies. The pkgdef is provided manually (Inferpal.pkgdef). -->
    <GeneratePkgDefFile>false</GeneratePkgDefFile>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CreateVsixContainer>true</CreateVsixContainer>
    <!-- Deployment is handled by deploy-dev.ps1, not by the build -->
    <DeployExtension>false</DeployExtension>
  </PropertyGroup>

  <!-- Resolves the |Inferpal;GetVsixVersion| token of source.extension.vsixmanifest: the VSIX
       version therefore comes from Directory.Build.props (the single source in the repository)
       instead of being copied by hand into the manifest, where it had drifted to 1.0.1.0 while
       the product was at 1.5.2. The VSSDK only provides this target for classic VSIX projects;
       in hybrid mode it has to be declared. -->
  <Target Name="GetVsixVersion" Returns="$(AssemblyVersion)" />

  <!-- ── Debug ───────────────────────────────────────────────────────────── -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <Optimize>false</Optimize>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <!-- PDBs included in the debug VSIX for Attach-to-Process debugging -->
    <IncludeDebugSymbolsInVSIXContainer>true</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>true</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyOutputSymbolsToOutputDirectory>true</CopyOutputSymbolsToOutputDirectory>
  </PropertyGroup>

  <!-- ── Release ─────────────────────────────────────────────────────────── -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- C# compiler optimizations -->
    <Optimize>true</Optimize>

    <!-- No PDBs in Release — reduces VSIX size -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>false</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyOutputSymbolsToOutputDirectory>false</CopyOutputSymbolsToOutputDirectory>

    <!-- Warnings = errors in Release to guarantee the quality of the shipped build -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Keep the infrastructure-warning suppressions even in strict mode -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);VSEXTPREVIEW_SETTINGS;NU1701;MSB4011</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Inferpal.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- Editor-agnostic logic core (Markdig, Roslyn, SQLite and ProtectedData flow in
         transitively and are still copied into the VSIX via CopyLocalLockFileAssemblies). -->
    <ProjectReference Include="..\Inferpal.Core\Inferpal.Core.csproj" />

    <!-- In-proc (net472) and its inference sidecar (net8).
         Two BUILD references, not compile references: ReferenceOutputAssembly=false because no
         API of these projects is called from here - they are loaded by devenv and by the sidecar
         itself, not by the out-of-process host. What matters is ordering: their outputs are
         embedded in the VSIX by the <Content> items below, so they must be built first.
         SkipGetTargetFrameworkProperties: without it MSBuild negotiates the TFM and refuses
         net8.0-windows -> net472. -->
    <ProjectReference Include="..\Inferpal.InProc\Inferpal.InProc.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      Private="false" />
    <ProjectReference Include="..\Inferpal.Fim\Inferpal.Fim.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      Private="false" />
  </ItemGroup>

  <!-- ── Charge utile in-process du VSIX ────────────────────────────────────
       Inferpal.InProc.dll is the assembly declared as a Microsoft.VisualStudio.MefComponent asset
       (and named by the pkgdef): it is THAT one devenv inventories and loads. A single DLL -
       Inferpal.Fim.* is the sidecar it starts for inference; its dependencies (Core, Markdig,
       SQLite...) already sit at the root of the VSIX, brought in by this project. -->
  <ItemGroup>
    <Content Include="..\Inferpal.InProc\bin\$(Configuration)\net472\Inferpal.InProc.dll">
      <Link>Inferpal.InProc.dll</Link>
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Inferpal.Fim\bin\$(Configuration)\net8.0\Inferpal.Fim.exe">
      <Link>Inferpal.Fim.exe</Link>
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Inferpal.Fim\bin\$(Configuration)\net8.0\Inferpal.Fim.dll">
      <Link>Inferpal.Fim.dll</Link>
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Inferpal.Fim\bin\$(Configuration)\net8.0\Inferpal.Fim.runtimeconfig.json">
      <Link>Inferpal.Fim.runtimeconfig.json</Link>
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Inferpal.Fim\bin\$(Configuration)\net8.0\Inferpal.Fim.deps.json">
      <Link>Inferpal.Fim.deps.json</Link>
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Symbols of the in-process half: Debug only, like the rest of the VSIX. -->
    <Content Include="..\Inferpal.InProc\bin\$(Configuration)\net472\Inferpal.InProc.pdb"
             Condition="'$(Configuration)' == 'Debug'">
      <Link>Inferpal.InProc.pdb</Link>
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Inferpal.Fim\bin\$(Configuration)\net8.0\Inferpal.Fim.pdb"
             Condition="'$(Configuration)' == 'Debug'">
      <Link>Inferpal.Fim.pdb</Link>
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Include="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- RemoteUserControl looks the resource up by <Namespace>.<ClassName>.xaml -->
    <!-- These XAML files are pure DataTemplates (not WPF UserControls), hence EmbeddedResource,
         not Page — otherwise the WPF compiler would try to compile them to BAML and fail. -->
    <EmbeddedResource Include="ToolWindow\InferpalToolWindowContent.xaml">
      <LogicalName>Inferpal.InferpalToolWindowContent.xaml</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="ToolWindow\InferpalSettingsContent.xaml">
      <LogicalName>Inferpal.ToolWindow.InferpalSettingsContent.xaml</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="ToolWindow\ApprovalDialogControl.xaml">
      <LogicalName>Inferpal.ToolWindow.ApprovalDialogControl.xaml</LogicalName>
    </EmbeddedResource>
    <!-- Exclude these files from the WPF (Page) pipeline to avoid double compilation -->
    <Page Remove="ToolWindow\InferpalToolWindowContent.xaml" />
    <Page Remove="ToolWindow\InferpalSettingsContent.xaml" />
    <Page Remove="ToolWindow\ApprovalDialogControl.xaml" />
  </ItemGroup>

  <ItemGroup>
    <!-- The pkgdef is REQUIRED for VSIXInstaller to write the registry entry
         VisualStudio\Extensibility\Extensions\Inferpal... into the private registry.
         Without that entry, VisualStudioExtensibilityPackage does not discover the extension.
         Note: VSSDK BuildTools rewrites ExtensionType to VSSDK+VisualStudio.Extensibility.
         ⚠ The pkgdef DOES carry a Packages key (GhostTextPackage) + AutoLoadPackages +
         MEFComponent — a previous version of this comment denied it. Whether those keys get
         merged depends on the install path (deploy-dev writes them into the hive; VSIXInstaller
         merges the pkgdef on release installs), which is why the build-event subscription is
         funneled through BuildEventsBootstrap: either loader may run, only one handler may
         exist (§27.4).
         VisX uses the Extensibility\Extensions entry to start the out-of-process host. -->
    <!-- string-resources.json must live in .vsextension/ (next to extension.json)
         for VS to resolve the %key% tokens in menus/commands. -->
    <!-- string-resources.json (default EN) -->
    <Content Include="Localization\string-resources.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
      <VSIXSubPath>.vsextension</VSIXSubPath>
    </Content>
    <!-- Localized string resources — VS resolves %tokens% from {locale}/string-resources.json -->
    <Content Include="Localization\fr\string-resources.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
      <VSIXSubPath>.vsextension\fr</VSIXSubPath>
    </Content>
    <Content Include="Localization\de\string-resources.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
      <VSIXSubPath>.vsextension\de</VSIXSubPath>
    </Content>
    <Content Include="Localization\es\string-resources.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
      <VSIXSubPath>.vsextension\es</VSIXSubPath>
    </Content>
    <Content Include="Localization\it\string-resources.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
      <VSIXSubPath>.vsextension\it</VSIXSubPath>
    </Content>
    <Content Include="Localization\ru\string-resources.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
      <VSIXSubPath>.vsextension\ru</VSIXSubPath>
    </Content>
    <Content Include="Localization\ja\string-resources.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
      <VSIXSubPath>.vsextension\ja</VSIXSubPath>
    </Content>
    <Content Include="Localization\ko\string-resources.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
      <VSIXSubPath>.vsextension\ko</VSIXSubPath>
    </Content>
    <Content Include="Localization\pl\string-resources.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
      <VSIXSubPath>.vsextension\pl</VSIXSubPath>
    </Content>
    <Content Include="Localization\zh-CN\string-resources.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
      <VSIXSubPath>.vsextension\zh-CN</VSIXSubPath>
    </Content>
    <Content Include="Inferpal.pkgdef">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- GPL-3.0 license embedded at the VSIX root — required by the VSIX 2.0 schema:
         <License> must reference a .txt/.rtf file INSIDE the package (not a URL),
         otherwise Marketplace validation fails.
         ⚠ Ce fichier n'est PAS une copie de ..\LICENSE : un VSIX n'expose qu'UN fichier de
         licence, celui-ci porte donc ..\NOTICE (copyright + termes additionnels §7) SUIVI du
         texte GPL v3 verbatim. Le dépôt, lui, sépare les deux — LICENSE doit rester verbatim,
         sinon GitHub ne reconnaît plus la licence. Modifier l'un = régénérer celui-ci. -->
    <Content Include="LICENSE.txt">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Extension icon — place a 128x128 PNG at Inferpal/assets/icon.png before publishing -->
    <Content Include="assets\icon.png" Condition="Exists('assets\icon.png')">
      <IncludeInVSIX>true</IncludeInVSIX>
      <VSIXSubPath>assets</VSIXSubPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- extension.json is generated automatically by Microsoft.VisualStudio.Extensibility.Build -->
    <!-- Do not copy it manually: the SDK generates the correct file in bin -->
  </ItemGroup>

  <!-- string-resources.json (+ locales) must be in .vsextension/{locale}/ for VS to resolve the %tokens% -->
  <Target Name="CopyStringResourcesToVsExtension" AfterTargets="Build">
    <MakeDir Directories="$(OutputPath).vsextension;$(OutputPath).vsextension\fr;$(OutputPath).vsextension\de;$(OutputPath).vsextension\es;$(OutputPath).vsextension\it;$(OutputPath).vsextension\ru;$(OutputPath).vsextension\ja;$(OutputPath).vsextension\ko;$(OutputPath).vsextension\pl;$(OutputPath).vsextension\zh-CN" />
    <Copy SourceFiles="$(ProjectDir)Localization\string-resources.json"       DestinationFolder="$(OutputPath).vsextension"          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ProjectDir)Localization\fr\string-resources.json"    DestinationFolder="$(OutputPath).vsextension\fr"       SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ProjectDir)Localization\de\string-resources.json"    DestinationFolder="$(OutputPath).vsextension\de"       SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ProjectDir)Localization\es\string-resources.json"    DestinationFolder="$(OutputPath).vsextension\es"       SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ProjectDir)Localization\it\string-resources.json"    DestinationFolder="$(OutputPath).vsextension\it"       SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ProjectDir)Localization\ru\string-resources.json"    DestinationFolder="$(OutputPath).vsextension\ru"       SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ProjectDir)Localization\ja\string-resources.json"    DestinationFolder="$(OutputPath).vsextension\ja"       SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ProjectDir)Localization\ko\string-resources.json"    DestinationFolder="$(OutputPath).vsextension\ko"       SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ProjectDir)Localization\pl\string-resources.json"    DestinationFolder="$(OutputPath).vsextension\pl"       SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ProjectDir)Localization\zh-CN\string-resources.json" DestinationFolder="$(OutputPath).vsextension\zh-CN"   SkipUnchangedFiles="true" />
  </Target>

  <!-- ── Prune the satellite flattened at the VSIX root ──────────────────────
       The SatelliteDllsProjectOutputGroup output group of the Inferpal.Core
       ProjectReference adds a copy of Inferpal.Core.resources.dll WITHOUT a culture
       subfolder at the VSIX root (in addition to the correct {locale}/... copies).
       That file has the identity Culture=de: at runtime, the Extensibility host ALC
       finds it first when resolving "Inferpal.Core.resources", the culture mismatch
       makes the bind fail and ALL languages fall back to neutral English. So remove
       every entry of that satellite whose target path has no culture subfolder. -->
  <!-- Hosting of the Extensibility parts: out-of-process, by force.
       The SDK requires RequiresInProcessHosting=true as soon as VssdkCompatibleExtension is true
       (VSEXT0007), and VssdkCompatibleExtension is what makes our hybrid manifest get packaged -
       hence the <Assets> section without which the in-process half is never inventoried.
       The compiler will not let the pair be split, but its two halves do NOT talk about the same
       assembly:
         - the <Assets> make devenv load Inferpal.InProc.dll (net472) - that is intended;
         - RequiresInProcessHosting writes "allowHostingInProcess": true for every service of
           .vsextension\extension.json, that is, for Inferpal.dll (net8).
       VS takes the second at its word. Measured, in the ActivityLog of the live hive:
       ExtensionMetadataInProcServiceBroker tries to create ActiveDocumentTracker INSIDE devenv and
       fails on "FileNotFoundException: System.Runtime, Version=8.0.0.0" - the same verdict as in
       MEF, one floor up.

       This target therefore sets the field back to false, which is exactly the shape Microsoft
       ships for an extension of our form: AppModernizationForDotNet is net10.0, all its services
       at allowHostingInProcess:false, and what must live inside devenv is delegated to a separate
       net472 container (here: Inferpal.InProc.dll). The two hybrids of VS 18 (Copilot Build
       Analyzer, Copilot testing) and the official in-process project template are net472 end to
       end - that is the contract for everything devenv hosts.

       WARNING: the target rewrites the INTERMEDIATE file: that is the one _AddExtensionJsonVsixItem
       puts into the VSIX and _CopyGeneratedOutputsToOutputDirectory copies into bin\. Rewriting
       the copy in bin\ would change nothing in the VSIX. It fails if the field disappeared from
       the generated JSON: without that guard, a change in the generator would make the repair
       silent. -->
  <UsingTask TaskName="ForceOutOfProcessHosting" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <JsonPath ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        var text = System.IO.File.ReadAllText(JsonPath);
        if (text.IndexOf("allowHostingInProcess", System.StringComparison.Ordinal) < 0)
        {
            Log.LogError("extension.json no longer contains 'allowHostingInProcess': the SDK " +
                         "generator changed shape. Without that field set to false, VS tries to " +
                         "load Inferpal.dll (net8) into devenv (net472) and every part dies.");
        }
        else
        {
            var updated = text.Replace("\"allowHostingInProcess\": true",
                                       "\"allowHostingInProcess\": false");
            if (updated != text) System.IO.File.WriteAllText(JsonPath, updated);
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="ForceOutOfProcessHostingInExtensionJson"
          AfterTargets="CoreCompile"
          Condition="Exists('$(IntermediateOutputPath)extension.json')">
    <ForceOutOfProcessHosting JsonPath="$(IntermediateOutputPath)extension.json" />
  </Target>

  <Target Name="PruneFlattenedCoreSatelliteFromVsix"
          BeforeTargets="GenerateTemplatesManifest;GenerateFileManifest">
    <ItemGroup>
      <VSIXSourceItem Remove="@(VSIXSourceItem)"
        Condition="'%(Filename)%(Extension)' == 'Inferpal.Core.resources.dll'
               And !$([System.String]::Copy('%(VSIXSourceItem.TargetPath)').Contains('\'))
               And !$([System.String]::Copy('%(VSIXSourceItem.TargetPath)').Contains('/'))" />
    </ItemGroup>
  </Target>

  <!-- ── Put back what the SDK pruned and this extension actually needs ─────
       Measured 2026-09-01, comparing the shipped packages: 1.5.2 carried 259 entries and
       15.8 MB, 1.6.0 and 1.6.1 carry 101 and 3.3 MB. Forty-one assemblies stopped shipping
       with the switch to VssdkCompatibleExtension, because the VSSDK removes from a package
       what it believes Visual Studio provides at run time.

       That belief is an IN-PROCESS one: it holds for an assembly loaded into devenv, whose
       load path holds all of them. This extension's payload runs OUT of process, in a .NET 8
       host that probes the extension's own folder — so for everything that is not owned by
       the IDE itself, the assumption is simply false.

       The instance that made it visible: Microsoft.Data.Sqlite.dll shipped without
       SQLitePCLRaw.core / .provider.e_sqlite3 / .batteries_v2 or the native e_sqlite3.dll —
       a facade with no engine, which throws at the first connection, i.e. the RAG index. A
       full scan of a VS 18 installation finds no provider.e_sqlite3 and NO e_sqlite3.dll at
       all. But fixing only that instance would leave the class: Roslyn and its closure went
       the same way, and nothing says the next dependency will announce itself as loudly.

       So the rule is a property, not a list: every copy-local NuGet assembly the build
       produces goes into the package, EXCEPT the ones Visual Studio genuinely owns and
       serves to its own host (Microsoft.VisualStudio.*, Microsoft.ServiceHub.*). Whatever is
       already in the package stays as it is — this only adds back what was dropped.

       Why nobody saw it: deploy-dev.ps1 copies the BUILD OUTPUT, which has everything. Only
       a package install was affected — the same shape as every other defect of this arc.
       Locked by Test-VsVsix, which now opens the Visual Studio package before publishing it. -->
  <Target Name="RestorePrunedRuntimeDependenciesToVsix"
          BeforeTargets="GenerateTemplatesManifest;GenerateFileManifest">
    <ItemGroup>
      <!-- Keyed by flat file name so the de-duplication below can match on it. -->
      <_VsixAlready Include="@(VSIXSourceItem)">
        <FlatName>%(Filename)%(Extension)</FlatName>
      </_VsixAlready>

      <_VsixRestore Include="@(ReferenceCopyLocalPaths)"
                    Condition="'%(Extension)' == '.dll' And '%(ReferenceCopyLocalPaths.NuGetPackageId)' != ''">
        <FlatName>%(Filename)%(Extension)</FlatName>
        <TargetPath>%(Filename)%(Extension)</TargetPath>
      </_VsixRestore>

      <!-- ⚠ Natives never travel through the managed restore above: it flattens whatever it is
           given, and among the RID copies of one native there is no reason the flattened one is
           the right architecture. Measured the hard way - the flat e_sqlite3.dll came out ARM64
           on an amd64-only extension, shadowed the x64 copy, and the package failed exactly as
           before with a different exception. -->
      <_VsixRestore Remove="@(_VsixRestore)" Condition="'%(Extension)' == '.dll' And '%(Filename)' == 'e_sqlite3'" />

      <!-- What the IDE owns: it ships them, it serves them, and shipping our own copy would
           put a second one in front of the host's. -->
      <_VsixRestore Remove="@(_VsixRestore)"
                    Condition="$([System.String]::Copy('%(Filename)').StartsWith('Microsoft.VisualStudio.'))
                            Or $([System.String]::Copy('%(Filename)').StartsWith('Microsoft.ServiceHub.'))" />

      <!-- Never add a second entry for something already packaged. -->
      <_VsixRestore Remove="@(_VsixAlready)" MatchOnMetadata="FlatName" />

      <VSIXSourceItem Include="@(_VsixRestore)" />

      <!-- The natives. PruneNonWindowsRuntimeAssets has already removed every non-Windows one,
           so what remains is win / win-x64 / win-arm64.
           ⚠ e_sqlite3.dll ends up BOTH flat at the root and under runtimes\win-*\native\, and
           that is deliberate rather than an oversight: a DllImport probes the directory the
           assembly sits in, while the runtimes\<rid>\ layout is only resolved through a
           deps.json — which a VSIX payload does not carry. Which of the two the out-of-process
           host actually uses is not something the package can know, so it ships both. The cost
           is 3.8 MB in an 11 MB package; the cost of guessing wrong is a feature that fails
           silently on every machine. -->
      <_VsixNative Include="@(NativeCopyLocalItems);@(RuntimeTargetsCopyLocalItems)"
                   Condition="'%(Extension)' == '.dll' And '%(DestinationSubDirectory)' != ''">
        <FlatName>%(Filename)%(Extension)</FlatName>
      </_VsixNative>
      <_VsixNative Remove="@(_VsixAlready)" MatchOnMetadata="FlatName" />
      <VSIXSourceItem Include="@(_VsixNative)">
        <TargetPath>%(_VsixNative.DestinationSubDirectory)%(Filename)%(Extension)</TargetPath>
      </VSIXSourceItem>

      <!-- The flat copy, named explicitly and taken from win-x64 - the one and only architecture
           this extension installs on (ProductArchitecture amd64 on all three targets). -->
      <!-- Deux listes dans un seul Include : %(DestinationSubDirectory) ne peut alors pas
           etre qualifie, et non qualifie il batche sur VSIXSourceItem lui-meme, dont les
           autres elements n ont pas cette metadonnee (MSB4096). D ou la liste intermediaire. -->
      <_VsixFlatNative Include="@(NativeCopyLocalItems);@(RuntimeTargetsCopyLocalItems)"
                       Condition="'%(Filename)%(Extension)' == 'e_sqlite3.dll'">
        <Rid>%(DestinationSubDirectory)</Rid>
      </_VsixFlatNative>
      <_VsixFlatNative Remove="@(_VsixFlatNative)"
                       Condition="!$([System.String]::Copy('%(Rid)').Replace('/','\').StartsWith('runtimes\win-x64\'))" />
      <VSIXSourceItem Include="@(_VsixFlatNative)">
        <TargetPath>e_sqlite3.dll</TargetPath>
      </VSIXSourceItem>
    </ItemGroup>
  </Target>

  <!-- ── Prune non-Windows runtime assets from the VSIX ──────────────────────
       SQLitePCLRaw (via Microsoft.Data.Sqlite) pulls ~15 MB of Linux/macOS/wasm natives
       (libe_sqlite3.so/.dylib/.a). Useless (Windows amd64-only extension) and worse:
       ELF/Mach-O binaries inside a VSIX trigger the "suspicious content" flag of the
       Marketplace anti-malware scan. Keep only runtimes\win\ (Windows managed) and the
       win-x64/win-arm64 natives (the SDK-generated manifest targets amd64 AND arm64). -->
  <Target Name="PruneNonWindowsRuntimeAssets" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)"
        Condition="!$([System.String]::Copy('%(RuntimeTargetsCopyLocalItems.DestinationSubDirectory)').Replace('/','\').StartsWith('runtimes\win\')) And !$([System.String]::Copy('%(RuntimeTargetsCopyLocalItems.DestinationSubDirectory)').Replace('/','\').StartsWith('runtimes\win-x64\')) And !$([System.String]::Copy('%(RuntimeTargetsCopyLocalItems.DestinationSubDirectory)').Replace('/','\').StartsWith('runtimes\win-arm64\'))" />
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)"
        Condition="'%(NativeCopyLocalItems.DestinationSubDirectory)' != '' And !$([System.String]::Copy('%(NativeCopyLocalItems.DestinationSubDirectory)').Replace('/','\').StartsWith('runtimes\win\')) And !$([System.String]::Copy('%(NativeCopyLocalItems.DestinationSubDirectory)').Replace('/','\').StartsWith('runtimes\win-x64\')) And !$([System.String]::Copy('%(NativeCopyLocalItems.DestinationSubDirectory)').Replace('/','\').StartsWith('runtimes\win-arm64\'))" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!--
      VS 2026 SDK (18.x) — new recommended out-of-process model.
      If dotnet restore fails, run: dotnet add package Microsoft.VisualStudio.Extensibility
      to fetch the latest compatible stable version.
    -->
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Sdk" Version="17.14.40608" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.Extensibility.Build" Version="17.14.40608" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.5.40034">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!--
      Ghost-text in-process MEF components require two classic VSSDK packages.
      PrivateAssets="all" → compile-time reference only; VS provides these assemblies
      at runtime (they ship with the IDE and must NOT be copied into the VSIX).
    -->
    <PackageReference Include="Microsoft.VisualStudio.Shell.15.0" Version="17.14.40264" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.Text.UI.Wpf"  Version="17.14.249"   PrivateAssets="all" />

    <!-- ── Security remediation ─────────────────────────────────────────────
         MessagePack is pulled in transitively by the VS Extensibility SDK at 2.5.198,
         which GHSA-hv8m-jj95-wg3x flags (LZ4 decompression out-of-bounds read). Pin the
         patched 2.5.301. PrivateAssets="all" keeps it compile/restore-only: like the rest
         of the SDK, VS provides MessagePack at runtime and it is not shipped in the VSIX. -->
    <PackageReference Include="MessagePack" Version="2.5.301" PrivateAssets="all" />
  </ItemGroup>

</Project>
