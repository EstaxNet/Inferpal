<Project Sdk="Microsoft.NET.Sdk">

  <!-- ── Headless host for editor adapters ─────────────────────────────────
       Thin console app exposing Inferpal.Core over header-framed JSON-RPC 2.0
       on stdio (StreamJsonRpc ⇄ vscode-jsonrpc interop). Spawned and supervised
       by the VS Code extension; the VS 2026 extension keeps consuming the Core
       in-process and never runs this executable. Discipline: stdout belongs to
       JSON-RPC — Program.cs reroutes Console.Out to stderr at startup. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net10.0 is the SHIPPED target: the VS Code and ACP packages carry its runtime, and
         vscode/package.ps1 and acp/package.ps1 publish it by name. net8.0 exists only for the
         test suite's Windows leg, which runs on the .NET 8 that Visual Studio's extension host
         still uses; the editor-agnostic leg runs this executable's net10.0 build. -->
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <RootNamespace>Inferpal.Host</RootNamespace>
    <AssemblyName>Inferpal.Host</AssemblyName>
    <!-- Never declare <InvariantGlobalization>false</>: an explicit value makes the SDK emit
         "System.Globalization.Invariant": false into the runtimeconfig, and that AppContext
         switch OVERRIDES DOTNET_SYSTEM_GLOBALIZATION_INVARIANT — which would defeat the VS Code
         extension's fallback when libicu is missing (bare Linux: the host FailFasts at boot).
         The SDK default is already non-invariant, without locking out the environment variable.
         Locked by HostGlobalizationConfigTests. -->
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <!-- Warnings = errors in Release, same quality bar as the other projects -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Inferpal.Core\Inferpal.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Headless protocol tests drive HostServer over in-memory duplex streams. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Inferpal.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- ── The browser settings window (Inferpal.Host settings switch) ─────────
       The very form VS Code shows: its bundle and stylesheets, served from web\ beside the executable. The bundle is
       built by `npm run build` in vscode\ (acp/package.ps1 runs it first); without it the window says what is missing
       and does not open. Published as ONE file (acp/package.ps1 only), they are resources of the executable instead
       (`web/<name>`, which SettingsWindowServer reads first): an ordinary build — the VS Code VSIX's — is unchanged. -->
  <PropertyGroup>
    <InferpalSettingsWebFiles>..\vscode\media\settings.css;..\vscode\media\settings-standalone.css;..\vscode\media\settings-standalone.js</InferpalSettingsWebFiles>
  </PropertyGroup>
  <ItemGroup Condition="Exists('..\vscode\media\settings-standalone.js') And '$(PublishSingleFile)' != 'true'">
    <None Include="$(InferpalSettingsWebFiles)"
          Link="web\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="Exists('..\vscode\media\settings-standalone.js') And '$(PublishSingleFile)' == 'true'">
    <EmbeddedResource Include="$(InferpalSettingsWebFiles)" LogicalName="web/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- ── One file (acp/package.ps1): the names of the framework's assemblies, for the C# analysis ──
       Inside one executable the runtime lists no assembly on disk (TRUSTED_PLATFORM_ASSEMBLIES is empty), and Roslyn
       would bind no .NET type: rename_symbol would miss every call made through one. The names of the framework this
       host compiles against travel as a resource; CSharpSemanticIndex loads them and reads their metadata in memory. -->
  <Target Name="EmbedFrameworkAssemblyNames" AfterTargets="ResolveReferences" BeforeTargets="PrepareResources"
          Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <_InferpalFrameworkName Include="@(ReferencePath->'%(Filename)')"
                              Condition="'%(ReferencePath.FrameworkReferenceName)' == 'Microsoft.NETCore.App'" />
    </ItemGroup>
    <Error Condition="'@(_InferpalFrameworkName)' == ''"
           Text="No framework assembly among the references: the C# analysis would bind no .NET type in one file." />
    <WriteLinesToFile File="$(IntermediateOutputPath)framework-assemblies.txt" Lines="@(_InferpalFrameworkName->Distinct())"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)framework-assemblies.txt" LogicalName="framework-assemblies.txt" />
      <FileWrites Include="$(IntermediateOutputPath)framework-assemblies.txt" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="StreamJsonRpc" Version="2.22.11" />
    <!-- ── Security remediation ─────────────────────────────────────────────
         StreamJsonRpc 2.22.x pulls an older MessagePack transitively, which GHSA advisories
         flag (LZ4 decompression AccessViolation, unbounded recursion in MessagePackReader.Skip,
         an array allocated before the depth check, …). The top-level pin raises the resolved
         version to a release none flags; the same pin lives in Inferpal and Inferpal.InProc. -->
    <PackageReference Include="MessagePack" Version="2.5.303" />
  </ItemGroup>

</Project>
