<Project Sdk="Microsoft.NET.Sdk">

  <!-- ── Headless host for editor adapters ─────────────────────────────────
       Thin console app exposing Inferpal.Core over header-framed JSON-RPC 2.0
       on stdio (StreamJsonRpc ⇄ vscode-jsonrpc interop). Spawned and supervised
       by the VS Code extension; the VS 2026 extension keeps consuming the Core
       in-process and never runs this executable. Discipline: stdout belongs to
       JSON-RPC — Program.cs reroutes Console.Out to stderr at startup. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Inferpal.Host</RootNamespace>
    <AssemblyName>Inferpal.Host</AssemblyName>
    <!-- Never declare <InvariantGlobalization>false</>: an explicit value makes the SDK emit
         "System.Globalization.Invariant": false into the runtimeconfig, and that AppContext
         switch OVERRIDES DOTNET_SYSTEM_GLOBALIZATION_INVARIANT — which would defeat the VS Code
         extension's fallback when libicu is missing (bare Linux: the host FailFasts at boot).
         The SDK default is already non-invariant, without locking out the environment variable.
         Locked by HostGlobalizationConfigTests. -->
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <!-- Warnings = errors in Release, same quality bar as the other projects -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Inferpal.Core\Inferpal.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Headless protocol tests drive HostServer over in-memory duplex streams. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Inferpal.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- ── The browser settings window (Inferpal.Host settings switch) ─────────
       The very form VS Code shows: its bundle and stylesheets, served from web\ beside the executable. The bundle is
       built by `npm run build` in vscode\ (acp/package.ps1 runs it first); without it the window says what is missing
       and does not open. -->
  <ItemGroup Condition="Exists('..\vscode\media\settings-standalone.js')">
    <None Include="..\vscode\media\settings.css;..\vscode\media\settings-standalone.css;..\vscode\media\settings-standalone.js"
          Link="web\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="StreamJsonRpc" Version="2.22.11" />
    <!-- ── Security remediation ─────────────────────────────────────────────
         StreamJsonRpc 2.22.x pulls an older MessagePack transitively, which GHSA advisories
         flag (LZ4 decompression AccessViolation, unbounded recursion in MessagePackReader.Skip,
         an array allocated before the depth check, …). The top-level pin raises the resolved
         version to a release none flags; the same pin lives in Inferpal and Inferpal.InProc. -->
    <PackageReference Include="MessagePack" Version="2.5.303" />
  </ItemGroup>

</Project>
