<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- §23: dual-targeted. net8.0-windows is the full suite (VS assembly + WPF included);
         net8.0 is the editor-agnostic slice (Core + Host) that the ubuntu/macos CI legs run —
         the VSIX project cannot build off-Windows, so its tests stay on the Windows TFM. -->
    <TargetFrameworks>net8.0-windows;net8.0</TargetFrameworks>
    <!-- Off-Windows only the agnostic leg exists at all: keeping the windows TFM in the list
         would drag the VSIX project into restore/evaluation on ubuntu/macos runners. -->
    <TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('Windows'))">net8.0</TargetFrameworks>
    <UseWPF Condition="'$(TargetFramework)' == 'net8.0-windows'">true</UseWPF>
    <!-- Nullable/ImplicitUsings/LangVersion inherited from the repo-root Directory.Build.props -->
    <IsPackable>false</IsPackable>
    <!-- Prevent VSIX generation in the test project -->
    <CreateVsixContainer>false</CreateVsixContainer>
    <VSSDKBuildToolsAutoSetup>false</VSSDKBuildToolsAutoSetup>
    <GeneratePkgDefFile>false</GeneratePkgDefFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Match the System.Text.Json version Inferpal.dll was compiled with (pulled by VS Extensibility SDK) -->
    <PackageReference Include="System.Text.Json" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Inferpal.Host\Inferpal.Host.csproj" />
    <ProjectReference Include="..\Inferpal.Fim\Inferpal.Fim.csproj" />
    <ProjectReference Include="..\Inferpal.Core\Inferpal.Core.csproj" />
  </ItemGroup>

  <!-- The VSIX assembly and the tests that exercise it exist only on the Windows TFM. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <ProjectReference Include="..\Inferpal\Inferpal.csproj" />
    <!-- The in-process half. It SHIPS as net472 (devenv is a .NET Framework process); it
         carries a net8.0-windows leg for this reference only, without which its types would
         be out of reach of a net8 test suite. -->
    <ProjectReference Include="..\Inferpal.InProc\Inferpal.InProc.csproj" />
    <!-- Interop types for the §27.4 BuildEventsBootstrap test (the VSIX project's SDK refs are
         PrivateAssets and do not flow through the ProjectReference). -->
    <PackageReference Include="Microsoft.VisualStudio.Shell.15.0" Version="17.14.40264" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net8.0-windows'">
    <Compile Remove="InlineEditResponseTests.cs" />
    <Compile Remove="TestFilePathResolverTests.cs" />
    <Compile Remove="VsThemeDetectorTests.cs" />
    <Compile Remove="ChatAutoScrollerTests.cs" />
    <Compile Remove="BuildEventsBootstrapTests.cs" />
    <Compile Remove="GlobalUsings.Windows.cs" />
  </ItemGroup>

</Project>
