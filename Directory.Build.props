<Project>

  <!-- ── Properties shared by every project in the repo ────────────────────
       (Inferpal VSIX, Inferpal.Core, Inferpal.Tests). Per-project concerns —
       TargetFramework, TreatWarningsAsErrors/WarningsNotAsErrors, packaging —
       stay in each csproj. -->
  <PropertyGroup>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Version numbering (bumped by deploy-release.ps1) -->
    <AssemblyVersion>1.6.6.0</AssemblyVersion>
    <FileVersion>1.6.6.0</FileVersion>
    <Version>1.6.6</Version>

    <!-- Binary reproducibility -->
    <Deterministic>true</Deterministic>

    <!-- Neutral fallback culture for the ResourceManager (EN) -->
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <!-- No NuGet audit suppression is in force, and that is a measured state rather than an
       omission. GHSA-2m69-gcr7-jv3q (SQLite < 3.50.2) was suppressed here while no fixed
       SQLitePCLRaw bundle existed; the pin to SQLitePCLRaw.bundle_e_sqlite3 2.1.12 in
       Inferpal.Core.csproj settled it, which is exactly the condition the suppression named for
       its own removal. Verified on 2026-09-01 by removing it and re-running the audit: the six
       projects report no vulnerable package either way.
       ⚠ Why it is removed rather than left in place: a suppression that suppresses nothing is
       not neutral. It blesses in advance the next dependency that reintroduces the same
       advisory, and nothing would say so. -->

</Project>
