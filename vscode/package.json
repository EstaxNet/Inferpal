{
  "name": "inferpal-vscode",
  "displayName": "Inferpal — Local AI Agent for VS Code",
  "description": "%inferpal.description%",
  "l10n": "./l10n",
  "version": "0.0.0-dev",
  "publisher": "EstaxNet",
  "license": "GPL-3.0-only",
  "icon": "media/marketplace-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/EstaxNet/Inferpal"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages",
    "Machine Learning"
  ],
  "keywords": [
    "ai",
    "ai agent",
    "coding agent",
    "agent",
    "local ai",
    "local llm",
    "llm",
    "ollama",
    "lm studio",
    "llama.cpp",
    "vllm",
    "openai compatible",
    "self-hosted",
    "offline",
    "private",
    "privacy",
    "no telemetry",
    "copilot alternative",
    "autocomplete",
    "code completion",
    "chat",
    "mcp",
    "rag",
    "debugger",
    "tdd",
    "qwen",
    "devstral"
  ],
  "galleryBanner": {
    "color": "#1E1636",
    "theme": "dark"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%inferpal.untrustedWorkspaces%"
    }
  },
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "inferpal",
          "title": "Inferpal",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "inferpal": [
        {
          "type": "webview",
          "id": "inferpal.chat",
          "name": "%inferpal.view.chat%"
        }
      ]
    },
    "commands": [
      {
        "command": "inferpal.restartHost",
        "title": "%inferpal.command.restartHost%"
      },
      {
        "command": "inferpal.resetChat",
        "title": "%inferpal.command.resetChat%",
        "icon": "$(add)"
      },
      {
        "command": "inferpal.saveSession",
        "title": "%inferpal.command.saveSession%",
        "icon": "$(save)"
      },
      {
        "command": "inferpal.loadSession",
        "title": "%inferpal.command.loadSession%",
        "icon": "$(history)"
      },
      {
        "command": "inferpal.deleteSession",
        "title": "%inferpal.command.deleteSession%"
      },
      {
        "command": "inferpal.exportChat",
        "title": "%inferpal.command.exportChat%",
        "icon": "$(export)"
      },
      {
        "command": "inferpal.openSettings",
        "title": "%inferpal.command.openSettings%",
        "icon": "$(gear)"
      },
      {
        "command": "inferpal.openDocs",
        "title": "%inferpal.command.openDocs%",
        "icon": "$(question)"
      },
      {
        "command": "inferpal.fixSelection",
        "title": "%inferpal.command.fixSelection%"
      },
      {
        "command": "inferpal.refactorSelection",
        "title": "%inferpal.command.refactorSelection%"
      },
      {
        "command": "inferpal.docSelection",
        "title": "%inferpal.command.docSelection%"
      },
      {
        "command": "inferpal.editSelection",
        "title": "%inferpal.command.editSelection%"
      },
      {
        "command": "inferpal.explainSelection",
        "title": "%inferpal.command.explainSelection%"
      },
      {
        "command": "inferpal.testSelection",
        "title": "%inferpal.command.testSelection%"
      },
      {
        "command": "inferpal.map",
        "title": "%inferpal.command.map%"
      },
      {
        "command": "inferpal.reviewCommit",
        "title": "%inferpal.command.reviewCommit%"
      },
      {
        "command": "inferpal.fixProblems",
        "title": "%inferpal.command.fixProblems%"
      },
      {
        "command": "inferpal.analyzeStop",
        "title": "%inferpal.command.analyzeStop%"
      },
      {
        "command": "inferpal.explainItem",
        "title": "%inferpal.command.explainItem%"
      },
      {
        "command": "inferpal.reviewItem",
        "title": "%inferpal.command.reviewItem%"
      },
      {
        "command": "inferpal.attachItem",
        "title": "%inferpal.command.attachItem%"
      },
      {
        "command": "inferpal.fixTest",
        "title": "%inferpal.command.fixTest%"
      },
      {
        "command": "inferpal.explainTestFailure",
        "title": "%inferpal.command.explainTestFailure%"
      },
      {
        "command": "inferpal.proposeCommitMessage",
        "title": "%inferpal.command.proposeCommitMessage%",
        "icon": "$(sparkle)"
      }
    ],
    "submenus": [
      {
        "id": "inferpal.explorer",
        "label": "%inferpal.submenu.explorer%"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "submenu": "inferpal.explorer",
          "group": "z_inferpal@1"
        }
      ],
      "inferpal.explorer": [
        {
          "command": "inferpal.explainItem",
          "group": "1_inferpal@1"
        },
        {
          "command": "inferpal.reviewItem",
          "group": "1_inferpal@2"
        },
        {
          "command": "inferpal.attachItem",
          "group": "1_inferpal@3"
        }
      ],
      "scm/title": [
        {
          "command": "inferpal.proposeCommitMessage",
          "when": "scmProvider == git",
          "group": "navigation@9"
        }
      ],
      "scm/sourceControl": [
        {
          "command": "inferpal.proposeCommitMessage",
          "when": "scmProvider == git",
          "group": "z_inferpal@1"
        }
      ],
      "testing/item/context": [
        {
          "command": "inferpal.fixTest",
          "group": "z_inferpal@1"
        },
        {
          "command": "inferpal.explainTestFailure",
          "when": "testResultState != passed",
          "group": "z_inferpal@2"
        }
      ],
      "testing/message/context": [
        {
          "command": "inferpal.explainTestFailure",
          "group": "z_inferpal@1"
        }
      ],
      "debug/callstack/context": [
        {
          "command": "inferpal.analyzeStop",
          "when": "debugState == 'stopped'",
          "group": "z_inferpal@1"
        }
      ],
      "debug/variables/context": [
        {
          "command": "inferpal.analyzeStop",
          "when": "debugState == 'stopped'",
          "group": "z_inferpal@1"
        }
      ],
      "commandPalette": [
        {
          "command": "inferpal.analyzeStop",
          "when": "inDebugMode"
        },
        {
          "command": "inferpal.explainItem",
          "when": "false"
        },
        {
          "command": "inferpal.reviewItem",
          "when": "false"
        },
        {
          "command": "inferpal.attachItem",
          "when": "false"
        },
        {
          "command": "inferpal.fixTest",
          "when": "false"
        },
        {
          "command": "inferpal.explainTestFailure",
          "when": "false"
        },
        {
          "command": "inferpal.proposeCommitMessage",
          "when": "gitOpenRepositoryCount != 0"
        }
      ],
      "view/title": [
        {
          "command": "inferpal.resetChat",
          "when": "view == inferpal.chat",
          "group": "navigation@1"
        },
        {
          "command": "inferpal.loadSession",
          "when": "view == inferpal.chat",
          "group": "navigation@2"
        },
        {
          "command": "inferpal.saveSession",
          "when": "view == inferpal.chat",
          "group": "navigation@3"
        },
        {
          "command": "inferpal.exportChat",
          "when": "view == inferpal.chat",
          "group": "navigation@4"
        },
        {
          "command": "inferpal.openSettings",
          "when": "view == inferpal.chat",
          "group": "navigation@5"
        },
        {
          "command": "inferpal.openDocs",
          "when": "view == inferpal.chat",
          "group": "navigation@6"
        }
      ],
      "editor/context": [
        {
          "command": "inferpal.fixSelection",
          "when": "editorTextFocus && !editorReadonly",
          "group": "1_modification@100"
        },
        {
          "command": "inferpal.refactorSelection",
          "when": "editorTextFocus && !editorReadonly",
          "group": "1_modification@101"
        },
        {
          "command": "inferpal.docSelection",
          "when": "editorTextFocus && !editorReadonly",
          "group": "1_modification@102"
        },
        {
          "command": "inferpal.editSelection",
          "when": "editorTextFocus && !editorReadonly",
          "group": "1_modification@99"
        },
        {
          "command": "inferpal.explainSelection",
          "when": "editorTextFocus",
          "group": "1_modification@103"
        },
        {
          "command": "inferpal.testSelection",
          "when": "editorTextFocus",
          "group": "1_modification@104"
        }
      ]
    },
    "keybindings": [
      {
        "command": "inferpal.chat.focus",
        "key": "ctrl+alt+i",
        "mac": "cmd+alt+i"
      },
      {
        "command": "inferpal.map",
        "key": "alt+m",
        "mac": "ctrl+alt+m",
        "when": "!terminalFocus"
      },
      {
        "command": "editor.action.inlineSuggest.trigger",
        "key": "alt+'",
        "mac": "ctrl+alt+'",
        "when": "editorTextFocus && !editorReadonly && !inlineSuggestionVisible"
      },
      {
        "command": "editor.action.inlineSuggest.commit",
        "key": "alt+'",
        "mac": "ctrl+alt+'",
        "when": "editorTextFocus && inlineSuggestionVisible"
      }
    ],
    "configuration": {
      "title": "Inferpal",
      "properties": {
        "inferpal.hostPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "%inferpal.config.hostPath%"
        },
        "inferpal.model": {
          "type": "string",
          "default": "",
          "description": "%inferpal.config.model%"
        },
        "inferpal.utilityModel": {
          "type": "string",
          "default": "",
          "description": "%inferpal.config.utilityModel%"
        },
        "inferpal.modelRouterAuto": {
          "type": "boolean",
          "default": false,
          "description": "%inferpal.config.modelRouterAuto%"
        },
        "inferpal.agentMode": {
          "type": "boolean",
          "default": false,
          "description": "%inferpal.config.agentMode%"
        },
        "inferpal.fim.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%inferpal.config.fimEnabled%"
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "vscode-jsonrpc": "^8.2.1"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.25.0",
    "markdown-it": "^14.3.3",
    "typescript": "^5.6.0"
  }
}
