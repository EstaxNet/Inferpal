{
  "name": "inferpal",
  "displayName": "Inferpal",
  "description": "%inferpal.description%",
  "l10n": "./l10n",
  "version": "0.0.0-dev",
  "publisher": "EstaxNet",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/EstaxNet/Inferpal"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages"
  ],
  "keywords": [
    "ai",
    "llm",
    "ollama",
    "lm studio",
    "local",
    "agent",
    "assistant"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%inferpal.untrustedWorkspaces%"
    }
  },
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "inferpal",
          "title": "Inferpal",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "inferpal": [
        {
          "type": "webview",
          "id": "inferpal.chat",
          "name": "%inferpal.view.chat%"
        }
      ]
    },
    "commands": [
      {
        "command": "inferpal.restartHost",
        "title": "%inferpal.command.restartHost%"
      },
      {
        "command": "inferpal.resetChat",
        "title": "%inferpal.command.resetChat%",
        "icon": "$(add)"
      },
      {
        "command": "inferpal.saveSession",
        "title": "%inferpal.command.saveSession%",
        "icon": "$(save)"
      },
      {
        "command": "inferpal.loadSession",
        "title": "%inferpal.command.loadSession%",
        "icon": "$(history)"
      },
      {
        "command": "inferpal.deleteSession",
        "title": "%inferpal.command.deleteSession%"
      },
      {
        "command": "inferpal.exportChat",
        "title": "%inferpal.command.exportChat%",
        "icon": "$(export)"
      },
      {
        "command": "inferpal.fixSelection",
        "title": "%inferpal.command.fixSelection%"
      },
      {
        "command": "inferpal.refactorSelection",
        "title": "%inferpal.command.refactorSelection%"
      },
      {
        "command": "inferpal.docSelection",
        "title": "%inferpal.command.docSelection%"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "inferpal.resetChat",
          "when": "view == inferpal.chat",
          "group": "navigation@1"
        },
        {
          "command": "inferpal.loadSession",
          "when": "view == inferpal.chat",
          "group": "navigation@2"
        },
        {
          "command": "inferpal.saveSession",
          "when": "view == inferpal.chat",
          "group": "navigation@3"
        },
        {
          "command": "inferpal.exportChat",
          "when": "view == inferpal.chat",
          "group": "navigation@4"
        }
      ],
      "editor/context": [
        {
          "command": "inferpal.fixSelection",
          "when": "editorTextFocus && !editorReadonly",
          "group": "1_modification@100"
        },
        {
          "command": "inferpal.refactorSelection",
          "when": "editorTextFocus && !editorReadonly",
          "group": "1_modification@101"
        },
        {
          "command": "inferpal.docSelection",
          "when": "editorTextFocus && !editorReadonly",
          "group": "1_modification@102"
        }
      ]
    },
    "keybindings": [
      {
        "command": "inferpal.chat.focus",
        "key": "ctrl+alt+i",
        "mac": "cmd+alt+i"
      }
    ],
    "configuration": {
      "title": "Inferpal",
      "properties": {
        "inferpal.hostPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "%inferpal.config.hostPath%"
        },
        "inferpal.model": {
          "type": "string",
          "default": "",
          "description": "%inferpal.config.model%"
        },
        "inferpal.utilityModel": {
          "type": "string",
          "default": "",
          "description": "%inferpal.config.utilityModel%"
        },
        "inferpal.modelRouterAuto": {
          "type": "boolean",
          "default": false,
          "description": "%inferpal.config.modelRouterAuto%"
        },
        "inferpal.agentMode": {
          "type": "boolean",
          "default": true,
          "description": "%inferpal.config.agentMode%"
        },
        "inferpal.fim.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%inferpal.config.fimEnabled%"
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "vscode-jsonrpc": "^8.2.1"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.14.0",
    "markdown-it": "^14.1.0",
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
